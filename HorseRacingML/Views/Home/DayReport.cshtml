            if (stakeDampenerReset && stakeDampenerInput) {
                stakeDampenerReset.addEventListener('click', () => {
                    stakeDampenerInput.value = '1';
                    stakeDampenerInput.classList.remove('is-invalid');
                    setStakeDampener(1);
                    stakeDampenerInput.focus();
                    stakeDampenerInput.select();
                });
            }

            const updateRaceMetadata = (card, race) => {
                const title = card.querySelector('h2.h5');
                if (title) {
                    const text = race?.raceTitle && race.raceTitle.trim().length > 0
                        ? race.raceTitle
                        : 'Unknown Race';
                    title.textContent = text;
                }

                const infoContainer = card.querySelector('.card-header .small.text-muted');
                const goingText = typeof race?.going === 'string' ? race.going.trim() : '';
                if (infoContainer) {
                    infoContainer.innerHTML = '';

                    const appendSpan = (text, classes = []) => {
                        if (!text) {
                            return;
                        }

                        const span = document.createElement('span');
                        span.textContent = text;
                        classes.forEach(cls => span.classList.add(cls));
                        infoContainer.appendChild(span);
                    };

                    const venueParts = [race?.venueName, race?.venueCountry]
                        .filter(part => typeof part === 'string' && part.trim().length > 0)
                        .map(part => part.trim());
                    if (venueParts.length > 0) {
                        appendSpan(venueParts.join(' - '));
                    }

                    const scheduleParts = [];
                    const formattedDate = formatDate(race?.raceDate);
                    if (formattedDate) {
                        scheduleParts.push(formattedDate);
                    }

                    const formattedTime = formatTime(race?.offTime);
                    if (formattedTime) {
                        scheduleParts.push(formattedTime);
                    }

                    if (scheduleParts.length > 0) {
                        appendSpan(scheduleParts.join(' '), ['ms-2']);
                    }

                    if (race?.raceDetails && race.raceDetails.trim().length > 0) {
                        appendSpan(race.raceDetails.trim(), ['ms-2']);
                    }

                    const bookParts = [];
                    const backText = formatPercentage(race?.backBookPercentage);
                    if (backText) {
                        bookParts.push(`Back ${backText}`);
                    }

                    const layText = formatPercentage(race?.layBookPercentage);
                    if (layText) {
                        bookParts.push(`Lay ${layText}`);
                    }

                    if (bookParts.length > 0) {
                        appendSpan(`Book: ${bookParts.join(' / ')}`, ['ms-2']);
                    }
                    if (goingText.length > 0) {
                        appendSpan(`Going: ${goingText}`, ['ms-2']);
                    }
                }

                const refreshButton = card.querySelector('.refresh-race-btn');
                if (refreshButton) {
                    const url = race?.raceUrl ?? '';
                    refreshButton.dataset.raceUrl = url;
                    refreshButton.disabled = !url;
                    if (goingText.length > 0) {
                        refreshButton.dataset.currentGoing = goingText;
                    } else {
                        delete refreshButton.dataset.currentGoing;
                    }
                }
                const marketOnlyButton = card.querySelector('.refresh-market-only-btn');
                if (marketOnlyButton) {
                    const url = race?.raceUrl ?? '';
                    marketOnlyButton.dataset.raceUrl = url;
                    marketOnlyButton.disabled = !url;
                    if (goingText.length > 0) {
                        refreshButton.dataset.currentGoing = goingText;
                    } else {
                        delete refreshButton.dataset.currentGoing;
                    }
                }
                updateCardRaceStart(card, race);
            };

            const renderRaceRows = (card, race) => {
                const tbody = card.querySelector('tbody');
                if (!tbody) {
                    return;
                }

                tbody.innerHTML = '';

                const runners = Array.isArray(race?.runners) ? [...race.runners] : [];
                runners.sort((a, b) => {
                    const clothA = Number.isFinite(a?.clothNumber) ? a.clothNumber : Number.MAX_SAFE_INTEGER;
                    const clothB = Number.isFinite(b?.clothNumber) ? b.clothNumber : Number.MAX_SAFE_INTEGER;
                    if (clothA !== clothB) {
                        return clothA - clothB;
                    }

                    const horseA = (a?.horseName ?? '').toString();
                    const horseB = (b?.horseName ?? '').toString();
                    return horseA.localeCompare(horseB);
                });

                runners.forEach(runner => {
                    const row = document.createElement('tr');

                    if (typeof runner?.horseName === 'string') {
                        row.dataset.horseName = runner.horseName.trim();
                    } else {
                        delete row.dataset.horseName;
                    }

                    let aiProbability = null;
                    if (typeof runner?.displayedAiProbability === 'number' && Number.isFinite(runner.displayedAiProbability) && runner.displayedAiProbability >= 0) {
                        aiProbability = runner.displayedAiProbability;
                    } else if (typeof runner?.aiProbability === 'number' && Number.isFinite(runner.aiProbability) && runner.aiProbability >= 0) {
                        aiProbability = runner.aiProbability;
                    }

                    if (Number.isFinite(aiProbability) && aiProbability >= 0) {
                        row.dataset.aiProbability = aiProbability.toString();
                    } else {
                        delete row.dataset.aiProbability;
                        aiProbability = null;
                    }

                    if (typeof runner?.marketProbability === 'number' && Number.isFinite(runner.marketProbability) && runner.marketProbability > 0) {
                        row.dataset.marketProbability = runner.marketProbability.toString();
                    } else {
                        delete row.dataset.marketProbability;
                    }


                    const appendCell = (text, className) => {
                        const cell = document.createElement('td');
                        if (className) {
                            cell.className = className;
                        }
                        cell.textContent = text;
                        row.appendChild(cell);
                        return cell;
                    };

                    appendCell(Number.isFinite(runner?.clothNumber) ? runner.clothNumber.toString() : '-');
                    appendCell(Number.isFinite(runner?.draw) ? runner.draw.toString() : '-');

                    const horseCell = document.createElement('td');
                    const horseName = document.createElement('div');
                    horseName.className = 'fw-semibold';
                    horseName.textContent = runner?.horseName ?? '';
                    horseCell.appendChild(horseName);

                    if (runner?.featureValues && typeof runner.featureValues === 'object' && Object.keys(runner.featureValues).length > 0) {
                        const details = document.createElement('details');
                        details.className = 'small mt-1';

                        const summary = document.createElement('summary');
                        summary.className = 'text-muted';
                        summary.textContent = 'Feature inputs';
                        details.appendChild(summary);

                        const dl = document.createElement('dl');
                        dl.className = 'row mb-0';

                        Object.keys(runner.featureValues)
                            .sort((a, b) => a.localeCompare(b))
                            .forEach(key => {
                                const value = runner.featureValues[key];
                                const dt = document.createElement('dt');
                                dt.className = 'col-sm-5';
                                dt.textContent = key;

                                const dd = document.createElement('dd');
                                dd.className = 'col-sm-7';
                                let valueText;
                                if (value === null || typeof value === 'undefined') {
                                    valueText = '-';
                                } else if (typeof value === 'number' && isFinite(value)) {
                                    valueText = value.toLocaleString();
                                } else {
                                    valueText = value.toString();
                                }
                                dd.textContent = valueText;

                                dl.appendChild(dt);
                                dl.appendChild(dd);
                            });

                        details.appendChild(dl);
                        horseCell.appendChild(details);
                    }

                    row.appendChild(horseCell);

                    appendCell(runner?.jockeyName ?? '');
                    const historyCell = document.createElement('td');
                    historyCell.className = 'text-end';
                    let historyCount = null;
                    if (typeof runner?.historicalRaceCount === 'number' && Number.isFinite(runner.historicalRaceCount)) {
                        historyCount = runner.historicalRaceCount;
                    } else if (typeof runner?.historicalRaceCount === 'string') {
                        const parsed = Number.parseInt(runner.historicalRaceCount, 10);
                        if (Number.isFinite(parsed)) {
                            historyCount = parsed;
                        }
                    }

                    const hasHistoricalRaces = Array.isArray(runner?.historicalRaces)
                        && runner.historicalRaces.length > 0;

                    if (hasHistoricalRaces && typeof historyCount === 'number' && Number.isFinite(historyCount) && historyCount > 0) {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'btn btn-link p-0 historical-races-btn';
                        button.textContent = historyCount.toLocaleString(undefined, { maximumFractionDigits: 0 });
                        button.dataset.runnerName = typeof runner?.horseName === 'string' ? runner.horseName : '';
                        button.dataset.historyCount = historyCount.toString();
                        try {
                            button.dataset.historicalRaces = JSON.stringify(runner.historicalRaces);
                        } catch (error) {
                            console.warn('Failed to serialize historical races for runner', error);
                            button.dataset.historicalRaces = '[]';
                        }
                        historyCell.appendChild(button);
                    } else if (typeof historyCount === 'number' && Number.isFinite(historyCount)) {
                        historyCell.textContent = historyCount.toLocaleString(undefined, { maximumFractionDigits: 0 });
                    } else {
                        historyCell.textContent = '-';
                    }

                    row.appendChild(historyCell);

                    appendCell(typeof runner?.marketDecimalOdds === 'number'
                        ? formatDecimal(runner.marketDecimalOdds)
                        : '-', 'text-end');

                    appendCell(typeof runner?.layDecimalOdds === 'number'
                        ? formatDecimal(runner.layDecimalOdds)
                        : '-', 'text-end');

                    const aiProbCell = appendCell('-', 'text-end');
                    if (Number.isFinite(aiProbability) && aiProbability >= 0) {
                        const display = formatProbabilityPercent(aiProbability);
                        if (display !== '-') {
                            const span = document.createElement('span');
                            span.textContent = display;
                            const tooltip = buildProbabilityTooltip(aiProbability);
                            if (tooltip) {
                                span.title = tooltip;
                            }
                            aiProbCell.textContent = '';
                            aiProbCell.appendChild(span);
                        } else {
                            aiProbCell.textContent = display;
                        }
                    }

                    appendCell(typeof runner?.aiDecimalOdds === 'number'
                        ? formatDecimal(runner.aiDecimalOdds)
                        : '-', 'text-end');

                    const marketPercent = typeof runner?.marketProbability === 'number'
                        ? formatPercentage(runner.marketProbability * 100)
                        : null;
                    appendCell(marketPercent ?? '-', 'text-end');

                    let displayedDifferential = null;
                    if (typeof runner?.displayedDifferential === 'number' && Number.isFinite(runner.displayedDifferential)) {
                        displayedDifferential = runner.displayedDifferential;
                    } else if (typeof runner?.differential === 'number' && Number.isFinite(runner.differential)) {
                        displayedDifferential = runner.differential;
                    } else if (Number.isFinite(aiProbability)) {
                        const marketProbability = Number.parseFloat(row.dataset.marketProbability ?? '');
                        if (Number.isFinite(marketProbability)) {
                            displayedDifferential = aiProbability - marketProbability;
                        }
                    }

                    const diffPercent = Number.isFinite(displayedDifferential)
                        ? formatPercentage(displayedDifferential * 100)
                        : null;
                    appendCell(diffPercent ?? '-', 'text-end');

                    const betting = resolveBettingRecommendation(runner);
                    if (betting.rowClass) {
                        row.classList.add(betting.rowClass);
                    }

                    appendCell(betting.kellyText, 'text-end');
                    const stakeCell = document.createElement('td');
                    stakeCell.className = 'text-end';
                    const stakeSpan = document.createElement('span');
                    stakeSpan.className = 'stake-value';
                    stakeSpan.dataset.defaultStake = betting.stakeData;
                    stakeSpan.dataset.kellyFraction = betting.kellyData;
                    stakeSpan.dataset.stakeType = betting.type;
                    stakeSpan.dataset.layOdds = betting.layOddsData;
                    stakeSpan.dataset.originalText = betting.stakeText ?? '-';
                    stakeSpan.textContent = betting.stakeText;
                    stakeCell.appendChild(stakeSpan);
                    row.appendChild(stakeCell);

                    tbody.appendChild(row);
                });
                bindHistoricalRaceButtons(tbody);
                updateStakeDisplays();
            };

            const updateRaceCard = (marketId, race) => {
                if (!marketId) {
                    return;
                }

                const card = document.querySelector(`.card[data-market-id="${marketId}"]`);
                if (!card) {
                    return;
                }

                if (race?.marketId) {
                    card.dataset.marketId = race.marketId;
                    const refreshButton = card.querySelector('.refresh-race-btn');
                    if (refreshButton) {
                        refreshButton.dataset.marketId = race.marketId;
                    }
                    const marketOnlyButton = card.querySelector('.refresh-market-only-btn');
                    if (marketOnlyButton) {
                        marketOnlyButton.dataset.marketId = race.marketId;
                    }
                }

                updateRaceMetadata(card, race);
                renderRaceRows(card, race);
            };

            const applyMarketOddsUpdate = (card, update) => {
                if (!card || !update) {
                    return;
                }

                if (update.marketId) {
                    card.dataset.marketId = update.marketId;
                    const refreshButton = card.querySelector('.refresh-race-btn');
                    if (refreshButton) {
                        refreshButton.dataset.marketId = update.marketId;
                    }

                    const marketOnlyButton = card.querySelector('.refresh-market-only-btn');
                    if (marketOnlyButton) {
                        marketOnlyButton.dataset.marketId = update.marketId;
                    }
                }

                if (typeof update.backBookPercentage === 'number' || typeof update.layBookPercentage === 'number') {
                    const infoContainer = card.querySelector('.card-header .small.text-muted');
                    if (infoContainer) {
                        const spans = Array.from(infoContainer.querySelectorAll('span'));
                        const bookSpan = spans.find(span => span.textContent && span.textContent.trim().startsWith('Book:'));
                        if (bookSpan) {
                            const parts = [];
                            const backText = typeof update.backBookPercentage === 'number' && Number.isFinite(update.backBookPercentage)
                                ? formatPercentage(update.backBookPercentage)
                                : null;
                            if (backText) {
                                parts.push(`Back ${backText}`);
                            }

                            const layText = typeof update.layBookPercentage === 'number' && Number.isFinite(update.layBookPercentage)
                                ? formatPercentage(update.layBookPercentage)
                                : null;
                            if (layText) {
                                parts.push(`Lay ${layText}`);
                            }

                            bookSpan.textContent = parts.length > 0
                                ? `Book: ${parts.join(' / ')}`
                                : 'Book: -';
                        }
                    }
                }
                if (typeof update.going === 'string') {
                    const infoContainer = card.querySelector('.card-header .small.text-muted');
                    const goingText = update.going.trim();
                    if (infoContainer) {
                        const spans = Array.from(infoContainer.querySelectorAll('span'));
                        const goingSpan = spans.find(span => span.textContent && span.textContent.trim().startsWith('Going:'));
                        if (goingSpan) {
                            goingSpan.textContent = goingText.length > 0 ? `Going: ${goingText}` : 'Going: -';
                        }
                    }

                    const refreshButtons = card.querySelectorAll('.refresh-market-only-btn, .refresh-race-btn');
                    refreshButtons.forEach(btn => {
                        if (goingText.length > 0) {
                            btn.dataset.currentGoing = goingText;
                        } else {
                            delete btn.dataset.currentGoing;
                        }
                    });
                }

                const rows = card.querySelectorAll('tbody tr');
                const runners = Array.isArray(update.runners) ? update.runners : [];
                runners.forEach(runner => {
                    if (!runner) {
                        return;
                    }

                    let targetRow = null;

        if (typeof runner.horseName === 'string' && runner.horseName.trim().length > 0) {
                        const horseName = runner.horseName.trim().toLowerCase();
                        targetRow = Array.from(rows).find(r => {
                            const horseElement = r.querySelector('td:nth-of-type(3) .fw-semibold');
                            if (!horseElement) {
                                return false;
                            }

                            return horseElement.textContent.trim().toLowerCase() === horseName;
                        }) || null;
                    }

                    if (!targetRow) {
                        return;
                    }

                    if (typeof runner.horseName === 'string') {
                        targetRow.dataset.horseName = runner.horseName.trim();
                    }

                    let marketProbability = null;
                    if (typeof runner.marketProbability === 'number' && Number.isFinite(runner.marketProbability) && runner.marketProbability > 0) {
                        marketProbability = runner.marketProbability;
                    } else if (typeof runner.marketDecimalOdds === 'number' && Number.isFinite(runner.marketDecimalOdds) && runner.marketDecimalOdds > 1) {
                        marketProbability = 1 / runner.marketDecimalOdds;
                    }

                    if (Number.isFinite(marketProbability) && marketProbability > 0) {
                        targetRow.dataset.marketProbability = marketProbability.toString();
                    } else {
                        delete targetRow.dataset.marketProbability;
                    }

                    const cells = targetRow.querySelectorAll('td');
                    if (cells.length < 10) {
                        return;
                    }

                    const marketOddsCell = cells[5];
                    if (marketOddsCell) {
                        if (typeof runner.marketDecimalOdds === 'number' && Number.isFinite(runner.marketDecimalOdds) && runner.marketDecimalOdds > 1) {
                            marketOddsCell.textContent = formatDecimal(runner.marketDecimalOdds);
                        } else {
                            marketOddsCell.textContent = '-';
                        }
                    }

                    const layOddsCell = cells[6];
                    if (layOddsCell) {
                        if (typeof runner.layDecimalOdds === 'number' && Number.isFinite(runner.layDecimalOdds) && runner.layDecimalOdds > 1) {
                            layOddsCell.textContent = formatDecimal(runner.layDecimalOdds);
                        } else {
                            layOddsCell.textContent = '-';
                        }
                    }

                    const marketWinCell = cells[9];
                    if (marketWinCell) {
                        if (Number.isFinite(marketProbability) && marketProbability > 0) {
                            const percentText = formatPercentage(marketProbability * 100);
                            marketWinCell.textContent = percentText ?? '-';
                        } else {
                            marketWinCell.textContent = '-';
                        }
                    }

                    const diffCell = cells[10];
                    if (diffCell) {
                        const aiProbability = Number.parseFloat(targetRow.dataset.aiProbability ?? '');
                        if (Number.isFinite(aiProbability) && Number.isFinite(marketProbability) && marketProbability > 0) {
                            const diffPercent = (aiProbability - marketProbability) * 100;
                            const diffText = formatPercentage(diffPercent);
                            diffCell.textContent = diffText ?? '-';
                        } else {
                            diffCell.textContent = '-';
                        }
                    }

                    const stakeSpan = targetRow.querySelector('.stake-value');
                    if (stakeSpan) {
                        if (typeof runner.layDecimalOdds === 'number' && Number.isFinite(runner.layDecimalOdds) && runner.layDecimalOdds > 1) {
                            stakeSpan.dataset.layOdds = runner.layDecimalOdds.toString();
                        } else if (!Number.isFinite(Number.parseFloat(stakeSpan.dataset.layOdds ?? ''))) {
                            delete stakeSpan.dataset.layOdds;
                        }
                    }
                });

                updateStakeDisplays();
            };

            const marketRefreshButtons = document.querySelectorAll('.refresh-market-only-btn');
            if (marketRefreshButtons.length > 0) {
                marketRefreshButtons.forEach(button => {
                    button.addEventListener('click', async () => {
                        if (button.disabled) {
                            return;
                        }

                        const raceUrl = button.dataset.raceUrl;
                        const marketId = button.dataset.marketId;
                        const rawGoing = button.dataset.currentGoing;
                        const currentGoing = (typeof rawGoing === 'string' && rawGoing.trim().length > 0)
                            ? rawGoing.trim()
                            : null;
                        const card = button.closest('.card');

                        if (!raceUrl) {
                            alert('No market URL is available for this race.');
                            return;
                        }

                        if (!card) {
                            alert('Unable to locate the race card for updating.');
                            return;
                        }

                        const originalHtml = button.innerHTML;
                        button.disabled = true;
                        button.innerText = 'Refreshing…';

                        try {
                            const response = await fetch(refreshMarketEndpoint, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ raceUrl, marketId, currentGoing })
                            });

                            if (!response.ok) {
                                throw new Error(`Request failed with status ${response.status}`);
                            }

                            const payload = await response.json();
                            if (payload?.success && payload?.update) {
                                applyMarketOddsUpdate(card, payload.update);
                                const newGoing = typeof payload.newGoing === 'string'
                                    ? payload.newGoing.trim()
                                    : '';

                                if (newGoing.length > 0) {
                                    button.dataset.currentGoing = newGoing;
                                } else {
                                    delete button.dataset.currentGoing;
                                }

                                const fullRefreshButton = card.querySelector('.refresh-race-btn');
                                if (fullRefreshButton) {
                                    if (newGoing.length > 0) {
                                        fullRefreshButton.dataset.currentGoing = newGoing;
                                    } else {
                                        delete fullRefreshButton.dataset.currentGoing;
                                    }
                                }

                                if (payload.goingChanged) {
                                    if (payload.aiRefreshed) {
                                        const message = newGoing.length > 0
                                            ? `Track going changed to "${newGoing}". AI odds were refreshed.`
                                            : 'Track going changed. AI odds were refreshed.';
                                        alert(message);
                                    } else {
                                        const message = newGoing.length > 0
                                            ? `Track going changed to "${newGoing}".`
                                            : 'Track going changed.';
                                        alert(message);
                                    }
                                }
                                return;
                            }

                            const message = payload?.message ?? 'Failed to refresh market odds.';
                            alert(message);
                        } catch (error) {
                            console.error('Market-only refresh request failed', error);
                            alert('Unable to refresh the market odds for this race. Please try again.');
                        } finally {
                            button.innerHTML = originalHtml;
                            button.disabled = !button.dataset.raceUrl;
                        }
                    });
                });
            }

            const refreshButtons = document.querySelectorAll('.refresh-race-btn');
            if (refreshButtons.length > 0) {
                refreshButtons.forEach(button => {
                    button.addEventListener('click', async () => {
                        if (button.disabled) {
                            return;
                        }

                        const raceUrl = button.dataset.raceUrl;
                        const marketId = button.dataset.marketId;
                        const rawGoing = button.dataset.currentGoing;
                        const currentGoing = (typeof rawGoing === 'string' && rawGoing.trim().length > 0)
                            ? rawGoing.trim()
                            : null;
                        const card = button.closest('.card');
                        if (!raceUrl) {
                            alert('No market URL is available for this race.');
                            return;
                        }

                        const originalHtml = button.innerHTML;
                        button.disabled = true;
                        button.innerText = 'Refreshing…';

                        try {
                            const response = await fetch(refreshEndpoint, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ raceUrl, marketId, currentGoing })
                            });

                            if (!response.ok) {
                                throw new Error(`Request failed with status ${response.status}`);
                            }

                            const payload = await response.json();
                            if (payload?.success) {
                                const market = payload?.race?.marketId ?? payload?.update?.marketId ?? marketId;
                                if (payload?.race) {
                                    updateRaceCard(market, payload.race);
                                } else if (payload?.update && card) {
                                    applyMarketOddsUpdate(card, payload.update);
                                }

                                const newGoing = typeof payload?.newGoing === 'string'
                                    ? payload.newGoing.trim()
                                    : '';

                                if (card) {
                                    const targets = card.querySelectorAll('.refresh-market-only-btn, .refresh-race-btn');
                                    targets.forEach(btn => {
                                        if (!btn) {
                                            return;
                                        }

                                        if (newGoing.length > 0) {
                                            btn.dataset.currentGoing = newGoing;
                                        } else {
                                            delete btn.dataset.currentGoing;
                                        }
                                    });
                                } else if (newGoing.length > 0) {
                                    button.dataset.currentGoing = newGoing;
                                } else {
                                    delete button.dataset.currentGoing;
                                }

                                if (payload?.goingChanged) {
                                    if (payload?.aiRefreshed) {
                                        const message = newGoing.length > 0
                                            ? `Track going changed to "${newGoing}". AI odds were refreshed.`
                                            : 'Track going changed. AI odds were refreshed.';
                                        alert(message);
                                    } else {
                                        const message = newGoing.length > 0
                                            ? `Track going changed to "${newGoing}".`
                                            : 'Track going changed.';
                                        alert(message);
                                    }
                                }
                                return;
                            }

                            const message = payload?.message ?? 'Failed to refresh market odds.';
                            alert(message);
                        } catch (error) {
                            console.error('Refresh request failed', error);
                            alert('Unable to refresh the market odds for this race. Please try again.');
                        } finally {
                            button.innerHTML = originalHtml;
                            button.disabled = !button.dataset.raceUrl;
                        }
                    });
                });
            }
            bindHistoricalRaceButtons(document);
            updateStakeDisplays();
        })();
    </script>
}