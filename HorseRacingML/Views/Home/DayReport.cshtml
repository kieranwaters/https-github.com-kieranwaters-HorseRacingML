                    return Reflect.apply(originalGetContext, this, [type, ...args]);
                };

                prototype.__hrmlPatchedWebGlContext = true;
            };

            suppressWebGlContextRequests();
            const initialRegionValue = (initialRegionInput?.value ?? '').trim();
            if (regionSelect && initialRegionValue.length > 0) {
