                        if (insertBefore) {
                            aiWinCell.insertBefore(secondary, insertBefore);
                        } else {
                            aiWinCell.appendChild(secondary);
                        }
                    }

                    let oddsText = '-';
                    if (fromMarket && marketOddsValue) {
                        oddsText = formatDecimal(marketOddsValue);
                    } else if (safeProbability > 0) {
                        oddsText = formatDecimal(1 / safeProbability);
                    }

                    if (oddsText && oddsText !== '-') {
                        secondary.textContent = oddsText;
                        secondary.classList.remove('d-none');
                    } else {
                        secondary.textContent = '-';
                        secondary.classList.add('d-none');
                    }

                    let indicator = aiWinCell.querySelector('.ai-market-indicator');
                    if (fromMarket) {
                        if (!indicator) {
                            indicator = document.createElement('div');
                            indicator.className = 'text-warning small ai-market-indicator';
                            indicator.textContent = 'Market probability applied';
                            const insertBefore = aiWinCell.querySelector('.ai-win-note');
                            if (insertBefore) {
                                aiWinCell.insertBefore(indicator, insertBefore);
                            } else {
                                aiWinCell.appendChild(indicator);
                            }
                        }
                    } else if (indicator) {
                        indicator.remove();
                    }
                }

                const aiOddsCell = row.querySelector('.ai-odds-cell');
                if (aiOddsCell) {
                    let aiOddsText = '-';
                    if (fromMarket && marketOddsValue) {
                        aiOddsText = formatDecimal(marketOddsValue);
                    } else if (safeProbability > 0) {
                        aiOddsText = formatDecimal(1 / safeProbability);
                    }

                    aiOddsCell.textContent = aiOddsText ?? '-';
                }

                const marketProbability = parseProbabilityAttribute(row.dataset.marketProbability);
                if (marketProbability > 0) {
                    const differential = safeProbability - marketProbability;
                    row.dataset.displayedDifferential = differential.toString();
                } else {
                    delete row.dataset.displayedDifferential;
                }

               }

            const refreshRowAiProbabilityDisplay = (row) => {
                if (!row) {
                    return;
                }

                const probability = parseProbabilityAttribute(row.dataset.aiProbability);
                const source = (row.dataset.aiProbabilitySource ?? '').toLowerCase();
                const parsedMarketOdds = Number.parseFloat(row.dataset.marketOdds ?? '');
                const marketOdds = Number.isFinite(parsedMarketOdds) ? parsedMarketOdds : null;
                setRowAiProbability(row, probability, {
                    fromMarket: source === 'market',
                    marketOdds: source === 'market' ? marketOdds : null,
                    preserveSource: true
                });
            };

            const applyMarketProbabilityToRow = (targetRow) => {
                if (!targetRow) {
                    return;
                }

                const tbody = targetRow.closest('tbody');
                if (!tbody) {
                    return;
                }

                const targetMarketProbability = parseProbabilityAttribute(targetRow.dataset.marketProbability);
                if (!(targetMarketProbability > 0)) {
                    alert('Market probability is not available for this runner.');
                    return;
                }

                const rows = Array.from(tbody.querySelectorAll('tr'));
                if (rows.length === 0) {
                    return;
                }

                const normalizedTarget = clampProbability(targetMarketProbability);
                const others = rows.filter(row => row !== targetRow);
                const otherTotal = others.reduce((sum, row) => sum + parseProbabilityAttribute(row.dataset.aiProbability), 0);
                const remaining = clampProbability(1 - normalizedTarget);

                const allocation = new Map();
                if (others.length > 0) {
                    if (otherTotal > 0) {
                        const scale = remaining / otherTotal;
                        others.forEach(row => {
                            const base = parseProbabilityAttribute(row.dataset.aiProbability);
                            allocation.set(row, clampProbability(base * scale));
                        });
                    } else if (remaining > 0) {
                        const share = remaining / others.length;
                        others.forEach(row => allocation.set(row, clampProbability(share)));
                    } else {
                        others.forEach(row => allocation.set(row, 0));
                    }
                }

                allocation.set(targetRow, normalizedTarget);

                let total = 0;
                allocation.forEach(value => {
                    total += value;
                });
                const diff = 1 - total;
                if (Math.abs(diff) > 1e-9) {
                    const adjustmentRow = diff > 0
                        ? targetRow
                        : (others.find(row => (allocation.get(row) ?? 0) > 0) ?? targetRow);
                    if (adjustmentRow) {
                        const current = allocation.get(adjustmentRow) ?? 0;
                        allocation.set(adjustmentRow, clampProbability(current + diff));
                    }
                }

                rows.forEach(row => {
                    const probability = allocation.get(row) ?? 0;
                    const parsedMarketOdds = Number.parseFloat(row.dataset.marketOdds ?? '');
                    const marketOdds = Number.isFinite(parsedMarketOdds) ? parsedMarketOdds : null;
                    const fromMarket = row === targetRow;
                    setRowAiProbability(row, probability, {
                        fromMarket,
                        marketOdds: fromMarket ? marketOdds : null,
                        preserveSource: false
                    });
                });
            };

