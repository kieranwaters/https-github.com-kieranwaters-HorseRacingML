                    setTimeout(() => URL.revokeObjectURL(url), 1000);
                });
            }

            const removePastRacesButton = document.getElementById('removePastRacesButton');
            const parseDateFromAttribute = (value) => {
                if (!value) {
                    return null;
                }

                const parsed = new Date(value);
                if (Number.isNaN(parsed.getTime())) {
                    return null;
                }

                return parsed;
            };

            if (removePastRacesButton) {
                removePastRacesButton.addEventListener('click', () => {
                    const now = new Date();
                    const raceCards = getActiveRaceCards();
                    raceCards.forEach(card => {
