                    if (Number.isFinite(historyCount) && historyCount > 0) {
                        historicalRacesSummary.textContent = `Showing ${available.toLocaleString()} recent race(s) of ${historyCount.toLocaleString()} recorded.`;
                    } else {
                        historicalRacesSummary.textContent = `Showing ${available.toLocaleString()} recent race(s).`;
                    }
                }

                historicalRacesContent.innerHTML = '';

                if (!Array.isArray(races) || races.length === 0) {
                    const empty = document.createElement('div');
                    empty.className = 'text-muted';
                    empty.textContent = 'No historical races are available for this runner.';
                    historicalRacesContent.appendChild(empty);
                } else {
                    const table = buildHistoricalRacesTable(races);
                    historicalRacesContent.appendChild(table);
                }

                if (typeof bootstrap !== 'undefined' && bootstrap?.Modal) {
                    const modalInstance = bootstrap.Modal.getOrCreateInstance(historicalRacesModalElement);
                    modalInstance.show();
                } else {
                    const fallbackLines = Array.isArray(races) && races.length > 0
                        ? races.map(race => {
                            const dateText = formatDate(race?.raceDate) ?? '-';
                            const titleText = race?.raceTitle ?? '';
                            const finishRaw = race?.finishPosition;
                            const finishNumber = typeof finishRaw === 'number'
                                ? finishRaw
                                : Number.parseInt(finishRaw, 10);
                            const finishText = Number.isFinite(finishNumber)
                                ? finishNumber.toString()
                                : (typeof finishRaw === 'string' && finishRaw.trim().length > 0
                                    ? finishRaw.trim()
                                    : '-');
                            return `${dateText} — ${titleText} (${finishText})`;
                        }).join('\n')
                        : 'No historical races are available for this runner.';
                    alert(`${displayName} — Historical races\n\n${fallbackLines}`);
                }
            };

            const handleHistoricalRacesClick = (event) => {
                event.preventDefault();
