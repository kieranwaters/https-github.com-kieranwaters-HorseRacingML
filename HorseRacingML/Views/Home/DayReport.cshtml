                    }

                    input.addEventListener('input', () => updateLayOddsFromInput(input));
                    const formatHandler = () => updateLayOddsFromInput(input, { formatValue: true });
                    input.addEventListener('change', formatHandler);
                    input.addEventListener('blur', formatHandler);
