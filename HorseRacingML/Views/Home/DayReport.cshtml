@model HorseRacingML.Models.DayReportViewModel
@using System.Collections.Generic
@using System.Globalization
@using System
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Linq
@using HorseRacingML.Models
@{
    ViewData["Title"] = "Day Report";
    var generatedLocal = Model.GeneratedAt.ToLocalTime();
    var bankrollText = Model.Bankroll > 0
        ? Model.Bankroll.ToString("C", CultureInfo.CurrentCulture)
        : Model.Bankroll.ToString("0.00", CultureInfo.CurrentCulture);

    string FormatProbabilityPercent(double value, CultureInfo culture)
    {
        if (!double.IsFinite(value) || value < 0)
        {
            return "-";
        }

        var percent = value * 100d;

        if (percent >= 0.01d)
        {
            return percent.ToString("0.##", culture) + "%";
        }

        if (percent >= 0.0001d)
        {
            return percent.ToString("0.####", culture) + "%";
        }

        if (percent > 0d)
        {
            return "<0.0001%";
        }

        return "0%";
    }

    string? BuildProbabilityTooltip(double value, CultureInfo culture)
    {
        if (!double.IsFinite(value) || value < 0)
        {
            return null;
        }

        return value.ToString("P6", culture);
    }

    string BuildHyperparameterSummary(HyperparameterSummary summary, CultureInfo culture)
    {
        var segments = new List<string>
        {
            $"Layers: {summary.Layers}",
            $"Units: {summary.Units}",
            $"Dropout: {summary.Dropout.ToString("0.###", culture)}",
            $"Learning rate: {summary.LearningRate.ToString("0.#####", culture)}",
            $"Epochs: {summary.Epochs}",
            $"Batch size: {summary.BatchSize}",
            $"Folds: {summary.Folds}"
        };

        if (summary.Fold.HasValue)
        {
            segments.Add($"Fold: {summary.Fold.Value}");
        }

        return string.Join(" | ", segments);
    }

    string? BuildHyperparameterTimestamp(HyperparameterSummary summary, CultureInfo culture)
    {
        if (!summary.TrainedAtUtc.HasValue)
        {
            return null;
        }

        var utc = summary.TrainedAtUtc.Value;
        if (utc.Kind == DateTimeKind.Unspecified)
        {
            utc = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        }

        var local = utc.Kind == DateTimeKind.Utc ? utc.ToLocalTime() : utc;
        return local.ToString("f", culture);
    }
    string? FormatFilterTime(TimeSpan? value, CultureInfo culture)
    {
        if (!value.HasValue)
        {
            return null;
        }

        return DateTime.Today.Add(value.Value).ToString("t", culture);
    }

    var filterStartText = FormatFilterTime(Model.FilterStartTime, CultureInfo.CurrentCulture);
    var filterEndText = FormatFilterTime(Model.FilterEndTime, CultureInfo.CurrentCulture);
    string? filterSummary = null;

    if (!string.IsNullOrEmpty(filterStartText) && !string.IsNullOrEmpty(filterEndText))
    {
        filterSummary = $"Showing races between {filterStartText} and {filterEndText}.";
    }
    else if (!string.IsNullOrEmpty(filterStartText))
    {
        filterSummary = $"Showing races from {filterStartText} onwards.";
    }
    else if (!string.IsNullOrEmpty(filterEndText))
    {
        filterSummary = $"Showing races until {filterEndText}.";
    }

    var filterStartRouteValue = Model.FilterStartTime.HasValue
        ? Model.FilterStartTime.Value.ToString(@"hh\:mm", CultureInfo.InvariantCulture)
        : null;
    var filterEndRouteValue = Model.FilterEndTime.HasValue
        ? Model.FilterEndTime.Value.ToString(@"hh\:mm", CultureInfo.InvariantCulture)
        : null;
    double? ExtractFeatureMetric(IReadOnlyDictionary<string, object?>? features, string key)
    {
        if (features == null || string.IsNullOrEmpty(key) || !features.TryGetValue(key, out var raw) || raw == null)
        {
            return null;
        }

        switch (raw)
        {
            case double doubleValue when double.IsFinite(doubleValue):
                return doubleValue;
            case float floatValue when float.IsFinite(floatValue):
                return floatValue;
            case decimal decimalValue:
                return (double)decimalValue;
            case int intValue:
                return intValue;
            case long longValue:
                return longValue;
            case string stringValue when double.TryParse(stringValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed):
                return parsed;
            default:
                var converted = Convert.ToString(raw, CultureInfo.InvariantCulture);
                if (!string.IsNullOrWhiteSpace(converted) &&
                    double.TryParse(converted, NumberStyles.Float, CultureInfo.InvariantCulture, out var fallbackParsed))
                {
                    return fallbackParsed;
                }

                return null;
        }
    }

    string? FormatWinRatePercentage(double? value, CultureInfo culture)
    {
        if (!value.HasValue || double.IsNaN(value.Value) || double.IsInfinity(value.Value) || value.Value < 0d)
        {
            return null;
        }

        var percent = value.Value * 100d;
        var format = percent >= 1d ? "0.0#" : "0.##";
        return percent.ToString(format, culture) + "%";
    }

    var initialRegionSelection = string.IsNullOrWhiteSpace(Model?.InitialRegion)
        ? DayReportFilterViewModel.DefaultRegion
        : Model.InitialRegion!;
    string DetermineRaceRegion(string? country)
    {
        if (string.IsNullOrWhiteSpace(country))
        {
            return "GB & IRE";
        }

        var normalized = country.Trim().ToUpperInvariant();

        if (normalized.Contains("UNITED KINGDOM") ||
            normalized.Contains("GREAT BRITAIN") ||
            normalized.Contains("ENGLAND") ||
            normalized.Contains("SCOTLAND") ||
            normalized.Contains("WALES") ||
            normalized.Contains("NORTHERN IRELAND") ||
            normalized.Contains("IRELAND") ||
            normalized == "UK" ||
            normalized == "GB" ||
            normalized == "IRE" ||
            normalized == "EIRE")
        {
            return "GB & IRE";
        }

        if (normalized.Contains("UNITED STATES") ||
            normalized.Contains("AMERICA") ||
            normalized == "USA" ||
            normalized == "US")
        {
            return "USA";
        }

        if (normalized.Contains("SOUTH AFRICA") ||
            normalized == "RSA")
        {
            return "RSA";
        }

        if (normalized.Contains("FRANCE") ||
            normalized == "FRA")
        {
            return "FRA";
        }

        if (normalized.Contains("AUSTRALIA") ||
                normalized == "AUS" ||
                normalized == "AUST")
        {
            return "AUS";
        }

        return "GB & IRE";
    }

    var regionOrder = new[] { "GB & IRE", "USA", "RSA", "FRA", "AUS" };
    var regionRaceCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var regionTrackSets = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);

    foreach (var region in regionOrder)
    {
        regionRaceCounts[region] = 0;
        regionTrackSets[region] = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    if (Model.Races != null)
    {
        foreach (var race in Model.Races)
        {
            var region = DetermineRaceRegion(race.VenueCountry);
            if (!regionRaceCounts.ContainsKey(region))
            {
                regionRaceCounts[region] = 0;
            }

            if (!regionTrackSets.ContainsKey(region))
            {
                regionTrackSets[region] = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            }

            regionRaceCounts[region]++;

            var venueName = race.VenueName?.Trim();
            if (!string.IsNullOrEmpty(venueName))
            {
                regionTrackSets[region].Add(venueName);
            }
        }
    }

    var regionSummaries = regionOrder
        .Select(region => new
        {
            Region = region,
            RaceCount = regionRaceCounts.TryGetValue(region, out var races) ? races : 0,
            TrackCount = regionTrackSets.TryGetValue(region, out var tracks) ? tracks.Count : 0
        })
        .ToList();
    var historicalRaceSerializerOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web)
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Day Report</h1>
        <p class="text-muted mb-0">
            Generated @generatedLocal.ToString("f", CultureInfo.CurrentCulture)
            <span class="ms-2">Bankroll: @bankrollText</span>
        </p>
        @if (Model.AiHyperparameters != null)
        {
            var summaryText = BuildHyperparameterSummary(Model.AiHyperparameters, CultureInfo.CurrentCulture);
            var trainedText = BuildHyperparameterTimestamp(Model.AiHyperparameters, CultureInfo.CurrentCulture);
            <div class="text-muted small mt-1">
                <span>AI hyperparameters: @summaryText</span>
                @if (!string.IsNullOrEmpty(trainedText))
                {
                    <span class="ms-2">Trained @trainedText</span>
                }
            </div>
        }
    </div>
    <div class="d-flex flex-column flex-sm-row gap-2">
        <a class="btn btn-outline-secondary" asp-action="DayReportOptions" asp-route-startTime="@filterStartRouteValue" asp-route-endTime="@filterEndRouteValue" asp-route-region="@initialRegionSelection">
            Change time filter
        </a>
        <button type="button" id="removePastRacesButton" class="btn btn-outline-danger">Remove past races</button>
        <button type="button" id="saveReportButton" class="btn btn-outline-primary">Save Report</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(filterSummary))
{
    <div class="alert alert-secondary">@filterSummary</div>
}

@if (Model.Races != null && Model.Races.Count > 0)
{
    <input type="hidden" id="dayReportInitialRegion" value="@initialRegionSelection" />
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <label for="dayReportRegionSelect" class="form-label mb-1">Region</label>
                    <select id="dayReportRegionSelect" class="form-select form-select-sm">
                        <option value="GB &amp; IRE" selected='@(initialRegionSelection == "GB & IRE" ? "selected" : null)'>GB &amp; IRE</option>
                        <option value="USA" selected='@(initialRegionSelection == "USA" ? "selected" : null)'>USA</option>
                        <option value="RSA" selected='@(initialRegionSelection == "RSA" ? "selected" : null)'>RSA</option>
                        <option value="FRA" selected='@(initialRegionSelection == "FRA" ? "selected" : null)'>FRA</option>
                        <option value="AUS" selected='@(initialRegionSelection == "AUS" ? "selected" : null)'>AUS</option>
                        <option value="All" selected='@(initialRegionSelection == "All" ? "selected" : null)'>All</option>
                    </select>
                    <div class="form-text">Use the selector to focus on specific race regions.</div>
                </div>
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-2" id="dayReportRegionButtons">
                        @foreach (var summary in regionSummaries)
                        {
                            var trackLabel = summary.TrackCount == 1 ? "track" : "tracks";
                            var raceLabel = summary.RaceCount == 1 ? "race" : "races";
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm region-filter-btn"
                                    data-region="@summary.Region">
                                @summary.Region (@summary.TrackCount @trackLabel / @summary.RaceCount @raceLabel)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="kellyBankrollInput" class="form-label mb-1">Kelly bankroll override</label>
                <input type="number"
                       class="form-control form-control-sm"
                       id="kellyBankrollInput"
                       placeholder="Enter bankroll"
                       step="0.01"
                       min="0.01"
                       inputmode="decimal"
                       data-report-bankroll="@Model.Bankroll.ToString("0.##", CultureInfo.InvariantCulture)" />
                <div class="form-text">Kelly stakes update immediately when this override is set.</div>
                <div class="invalid-feedback">Enter a positive bankroll to apply the override.</div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="stakeAmountInput" class="form-label mb-1">Stake amount override</label>
                <input type="number"
                       class="form-control form-control-sm"
                       id="stakeAmountInput"
                       placeholder="Enter flat stake"
                       step="0.01"
                       min="0.01"
                       inputmode="decimal" />
                <div class="form-text">Apply a flat stake value to every runner recommendation.</div>
                <div class="invalid-feedback">Enter a positive stake amount to apply the override.</div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="stakeDampenerInput" class="form-label mb-1">Stake dampener</label>
                <input type="number"
                       class="form-control form-control-sm"
                       id="stakeDampenerInput"
                       value="1"
                       step="0.01"
                       min="0.01"
                       inputmode="decimal" />
                <div class="form-text">Divide every stake by this value to temper staking.</div>
                <div class="invalid-feedback">Enter a dampener greater than zero.</div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="minEdgeInput" class="form-label mb-1">Min Edge %</label>
                <input type="number"
                       class="form-control form-control-sm"
                       id="minEdgeInput"
                       placeholder="e.g. 5"
                       step="0.1"
                       min="0"
                       inputmode="decimal" />
                <div class="form-text">Hide runners with an edge below this %.</div>
                <div class="invalid-feedback">Enter a non-negative percentage.</div>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="button" id="kellyBankrollUseReport" class="btn btn-outline-secondary btn-sm">
                    Use report bankroll (@bankrollText)
                </button>
                <button type="button" id="kellyBankrollReset" class="btn btn-outline-secondary btn-sm">
                    Clear bankroll override
                </button>
                <button type="button" id="stakeAmountReset" class="btn btn-outline-secondary btn-sm">
                    Clear stake override
                </button>
                <button type="button" id="stakeDampenerReset" class="btn btn-outline-secondary btn-sm">
                    Reset dampener
                </button>
                <button type="button" id="minEdgeReset" class="btn btn-outline-secondary btn-sm">
                    Reset edge filter
                </button>
            </div>
        </div>
    </div>
</div>

@if (Model.Races == null || Model.Races.Count == 0)
{
    <div class="alert alert-info">No race data was captured while scanning the open markets.</div>
}
else
{
    @for (var raceIndex = 0; raceIndex < Model.Races.Count; raceIndex++)
    {
        var race = Model.Races[raceIndex];
        var raceTitle = string.IsNullOrWhiteSpace(race.RaceTitle)
            ? "Unknown Race"
            : race.RaceTitle;

        var venueParts = new[] { race.VenueName, race.VenueCountry }
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();

        var scheduleParts = new List<string>();
        if (race.RaceDate.HasValue)
        {
            scheduleParts.Add(race.RaceDate.Value.ToString("yyyy-MM-dd", CultureInfo.CurrentCulture));
        }

        if (race.OffTime.HasValue)
        {
            scheduleParts.Add(race.OffTime.Value.ToString(@"hh\:mm", CultureInfo.CurrentCulture));
        }

        var bookParts = new List<string>();
        if (race.BackBookPercentage.HasValue)
        {
            bookParts.Add($"Back {race.BackBookPercentage.Value.ToString("0.##", CultureInfo.CurrentCulture)}%");
        }

        if (race.LayBookPercentage.HasValue)
        {
            bookParts.Add($"Lay {race.LayBookPercentage.Value.ToString("0.##", CultureInfo.CurrentCulture)}%");
        }
        var goingText = string.IsNullOrWhiteSpace(race.Going)
            ? null
            : race.Going.Trim();
        var orderedRunners = (race.Runners ?? new List<RunnerDayReport>())
                .OrderByDescending(r =>
                {
                    if (!r.LayDecimalOdds.HasValue || r.LayDecimalOdds.Value == 0)
                    {
                        return double.MinValue;
                    }
                    var prob = r.DisplayedAiProbability ?? r.AiProbability ?? 0;
                    var layProb = 1.0d / (double)r.LayDecimalOdds.Value;
                    return layProb - prob;
                })
                .ThenBy(r => r.ClothNumber ?? byte.MaxValue)
            .ThenBy(r => r.HorseName ?? string.Empty)
            .ToList();

        DateTime? raceStart = null;
        if (race.RaceDate.HasValue)
        {
            var baseDate = race.RaceDate.Value;
            if (race.OffTime.HasValue)
            {
                raceStart = baseDate.Date + race.OffTime.Value;
            }
            else
            {
                raceStart = baseDate;
            }
        }

        var raceStartIso = raceStart.HasValue
            ? raceStart.Value.ToString("o", CultureInfo.InvariantCulture)
            : string.Empty;
        var raceRegion = DetermineRaceRegion(race.VenueCountry);


        <div class="card mb-4 race-card" data-market-id="@race.MarketId" data-race-start="@raceStartIso" data-region="@raceRegion">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1 mb-sm-0">@raceTitle</h2>
                        <div class="small text-muted">
                            @if (venueParts.Count > 0)
                            {
                                <span>@string.Join(" - ", venueParts)</span>
                            }

                            @if (scheduleParts.Count > 0)
                            {
                                <span class="ms-2">@string.Join(" ", scheduleParts)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(race.RaceType))
                            {
                                <span class="ms-2">Type: @race.RaceType</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(race.RaceDetails))
                            {
                                <span class="ms-2">@race.RaceDetails</span>
                            }

                            @if (bookParts.Count > 0)
                            {
                                <span class="ms-2">Book: @string.Join(" / ", bookParts)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(goingText))
                            {
                                <span class="ms-2">Going: @goingText</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-2 text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary refresh-market-only-btn"
                                data-market-id="@race.MarketId"
                                data-race-url="@race.RaceUrl"
                                data-current-going="@goingText"
                                @(string.IsNullOrWhiteSpace(race.RaceUrl) ? "disabled" : string.Empty)>
                            Refresh market odds
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary refresh-race-btn"
                                data-market-id="@race.MarketId"
                                data-race-url="@race.RaceUrl"
                                @(string.IsNullOrWhiteSpace(race.RaceUrl) ? "disabled" : string.Empty)>
                            Full refresh (AI + odds)
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(race.RaceFallbackSummary))
                {
                    <div class="alert alert-warning small" role="status">
                        <strong>AI fallback:</strong> @race.RaceFallbackSummary
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Draw</th>
                                <th scope="col">Horse</th>
                                <th scope="col">Jockey</th>
                                <th scope="col" class="text-end">Hist. Races</th>
                                <th scope="col" class="text-end">Top 3 %</th>
                                <th scope="col" class="text-end">Top 5 %</th>
                                <th scope="col" class="text-end">Finish Vol.</th>
                                <th scope="col" class="text-end">Market Odds</th>
                                <th scope="col" class="text-end">Lay Odds</th>
                                <th scope="col" class="text-end">AI Win %</th>
                                <th scope="col" class="text-end">AI Odds</th>
                                <th scope="col" class="text-end">Use Market</th>
                                <th scope="col" class="text-end">Market Win %</th>
                                <th scope="col" class="text-end">Edge</th>
                                <th scope="col" class="text-end">Kelly %</th>
                                <th scope="col" class="text-end">Stake</th>
                                <th scope="col" class="text-end">ROI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var runner in orderedRunners)
                            {
                                var cloth = runner.ClothNumber.HasValue
                                ? runner.ClothNumber.Value.ToString(CultureInfo.CurrentCulture)
                                : "-";

                                var draw = runner.Draw.HasValue
                                ? runner.Draw.Value.ToString(CultureInfo.CurrentCulture)
                                : "-";
                                string historyCountText = "-";
                                string? historicalRacesJson = null;
                                if (runner.HistoricalRaceCount.HasValue)
                                {
                                    historyCountText = runner.HistoricalRaceCount.Value.ToString("N0", CultureInfo.CurrentCulture);
                                }
                                if (runner.HistoricalRaces != null && runner.HistoricalRaces.Count > 0)
                                {
                                    var orderedHistorical = runner.HistoricalRaces
                                    .OrderByDescending(r => r.RaceDate)
                                    .ToList();
                                    historicalRacesJson = JsonSerializer.Serialize(orderedHistorical, historicalRaceSerializerOptions);
                                }
                                var top3RateText = "-";
                                string? top3RateTitle = null;
                                if (runner.Top3FinishRate.HasValue)
                                {
                                    var rate = runner.Top3FinishRate.Value * 100d;
                                    top3RateText = rate.ToString("0.##", CultureInfo.CurrentCulture) + "%";
                                    top3RateTitle = $"{rate.ToString("0.###", CultureInfo.CurrentCulture)}% of historical runs finished in the top 3";
                                }

                                var top5RateText = "-";
                                string? top5RateTitle = null;
                                if (runner.Top5FinishRate.HasValue)
                                {
                                    var rate = runner.Top5FinishRate.Value * 100d;
                                    top5RateText = rate.ToString("0.##", CultureInfo.CurrentCulture) + "%";
                                    top5RateTitle = $"{rate.ToString("0.###", CultureInfo.CurrentCulture)}% of historical runs finished in the top 5";
                                }

                                var volatilityText = "-";
                                string? volatilityTitle = null;
                                if (runner.FinishPositionVolatility.HasValue)
                                {
                                    var volatilityPercent = runner.FinishPositionVolatility.Value * 100d;
                                    volatilityText = volatilityPercent.ToString("0.##", CultureInfo.CurrentCulture) + "%";
                                    volatilityTitle = "Standard deviation of normalized finishing positions across historical runs";
                                }

                                var marketOdds = runner.MarketDecimalOdds.HasValue
                                ? runner.MarketDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                : "-";
                                var layOdds = runner.LayDecimalOdds.HasValue
                                ? runner.LayDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                : "-";
                                var displayAiProbability = runner.DisplayedAiProbability ?? runner.AiProbability;
                                var displayAiFromMarket = runner.DisplayedAiProbability.HasValue
                                ? runner.DisplayedAiProbabilityMarketDerived
                                : runner.AiProbabilityMarketDerived;
                                string? aiProb = null;
                                string? aiProbTitle = null;
                                if (displayAiProbability.HasValue)
                                {
                                    aiProb = FormatProbabilityPercent(displayAiProbability.Value, CultureInfo.CurrentCulture);
                                    aiProbTitle = BuildProbabilityTooltip(displayAiProbability.Value, CultureInfo.CurrentCulture);
                                }
                                else if (runner.AiDecimalOdds.HasValue && runner.AiDecimalOdds.Value > 0)
                                {
                                    var derivedProbability = 1.0 / (double)runner.AiDecimalOdds.Value;
                                    aiProb = FormatProbabilityPercent(derivedProbability, CultureInfo.CurrentCulture);
                                    aiProbTitle = BuildProbabilityTooltip(derivedProbability, CultureInfo.CurrentCulture);
                                }
                                string? aiOdds = null;
                                if (displayAiFromMarket)
                                {
                                    if (runner.MarketDecimalOdds.HasValue)
                                    {
                                        aiOdds = runner.MarketDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture);
                                    }
                                }
                                else if (runner.AiDecimalOdds.HasValue)
                                {
                                    aiOdds = runner.AiDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture);
                                    if (runner.AiProbabilityClampedToMarket)
                                    {
                                        aiOdds += "!";
                                    }
                                }
                                var aiWinPrimary = "-";
                                string? aiWinSecondary = null;

                                var aiWinTitle = aiProbTitle;

                                if (!string.IsNullOrEmpty(aiProb))
                                {
                                    aiWinPrimary = aiProb;
                                    if (!string.IsNullOrEmpty(aiOdds))
                                    {
                                        aiWinSecondary = aiOdds;
                                    }
                                }
                                else if (!string.IsNullOrEmpty(aiOdds))
                                {
                                    aiWinPrimary = aiOdds;
                                }
                                var marketProb = runner.MarketProbability.HasValue
                                ? (runner.MarketProbability.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                : "-";

                                var aiProbabilityAttrValue = runner.DisplayedAiProbability ?? runner.AiProbability;
                                var effectiveAiProbability = aiProbabilityAttrValue;
                                var hasBackEdge = runner.KellyFraction.HasValue && runner.KellyFraction.Value > 0;
                                var hasLayEdge = runner.LayKellyFraction.HasValue && runner.LayKellyFraction.Value > 0;

                                double? displayedDifferential = runner.DisplayedDifferential;
                                if (!displayedDifferential.HasValue && effectiveAiProbability.HasValue)
                                {
                                    if (hasLayEdge && runner.LayDecimalOdds.HasValue && runner.LayDecimalOdds.Value > 0)
                                    {
                                        displayedDifferential = (1.0 / (double)runner.LayDecimalOdds.Value) - effectiveAiProbability.Value;
                                    }
                                    else if (runner.MarketProbability.HasValue)
                                    {
                                        displayedDifferential = effectiveAiProbability.Value - runner.MarketProbability.Value;
                                    }
                                }
                                if (!displayedDifferential.HasValue && runner.Differential.HasValue)
                                {
                                    displayedDifferential = runner.Differential.Value;
                                }
                                var diff = displayedDifferential.HasValue
                                ? (displayedDifferential.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                : "-";
                                var rowClass = hasBackEdge
                                ? "runner-edge-back"
                                : hasLayEdge
                                ? "runner-edge-lay"
                                : string.Empty;

                                var horseNameAttr = runner.HorseName?.Trim() ?? string.Empty;
                                var marketProbabilityAttr = runner.MarketProbability.HasValue
                                ? runner.MarketProbability.Value.ToString("0.################", CultureInfo.InvariantCulture)
                                : string.Empty;

                                var displayedKelly = hasBackEdge
                                ? (runner.KellyFraction!.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                : hasLayEdge
                                ? "Lay " + (runner.LayKellyFraction!.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                : "-";
                                var kellyData = hasBackEdge
                                ? runner.KellyFraction!.Value.ToString("0.######", CultureInfo.InvariantCulture)
                                : hasLayEdge
                                ? runner.LayKellyFraction!.Value.ToString("0.######", CultureInfo.InvariantCulture)
                                : string.Empty;

                                var useLayRecommendation = !hasBackEdge && hasLayEdge;
                                var displayedStakeValue = useLayRecommendation ? runner.LaySuggestedStake : runner.SuggestedStake;
                                var stakeType = useLayRecommendation ? "lay" : hasBackEdge ? "back" : "none";
                                var layOddsData = useLayRecommendation && runner.LayDecimalOdds.HasValue
                                ? runner.LayDecimalOdds.Value.ToString("0.########", CultureInfo.InvariantCulture)
                                : string.Empty;

                                var displayedStake = displayedStakeValue.HasValue && displayedStakeValue.Value > 0
                                ? (useLayRecommendation
                                ? "Lay " + displayedStakeValue.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                : displayedStakeValue.Value.ToString("0.00", CultureInfo.CurrentCulture))
                                : "-";
                                var stakeData = displayedStakeValue.HasValue && displayedStakeValue.Value > 0
                                ? displayedStakeValue.Value.ToString("0.00", CultureInfo.InvariantCulture)
                                : string.Empty;
                                var aiProbabilityAttr = aiProbabilityAttrValue.HasValue
                                ? aiProbabilityAttrValue.Value.ToString("0.################", CultureInfo.InvariantCulture)
                                : string.Empty;
                                var marketOddsAttr = runner.MarketDecimalOdds.HasValue
                                ? runner.MarketDecimalOdds.Value.ToString("0.########", CultureInfo.InvariantCulture)
                                : string.Empty;
                                var layOddsAttr = runner.LayDecimalOdds.HasValue
                                ? runner.LayDecimalOdds.Value.ToString("0.########", CultureInfo.InvariantCulture)
                                : string.Empty;
                                var aiProbabilitySourceAttr = displayAiFromMarket ? "market" : "model";
                                <tr class="@rowClass"
                                    data-horse-name="@horseNameAttr"
                                    data-ai-probability="@aiProbabilityAttr"
                                    data-market-probability="@marketProbabilityAttr"
                                    data-market-odds="@marketOddsAttr"
                                    data-lay-odds="@layOddsAttr"
                                    data-ai-probability-source="@aiProbabilitySourceAttr"
                                    data-kelly="@((runner.KellyFraction ?? 0).ToString("0.################", CultureInfo.InvariantCulture))"
                                    data-lay-kelly="@((runner.LayKellyFraction ?? 0).ToString("0.################", CultureInfo.InvariantCulture))">

                                    <td>@cloth</td>
                                    <td>@draw</td>
                                    <td>
                                        <div class="fw-semibold">
                                            @runner.HorseName
                                            @if (runner.ImputedFeatures != null && runner.ImputedFeatures.Count > 0)
                                            {
                                                var imputedText = string.Join(", ", runner.ImputedFeatures);
                                                <span class="text-warning ms-1 text-decoration-underline"
                                                      style="cursor: pointer;"
                                                      title="Imputed: @imputedText"
                                                      onclick="alert('Imputed data: @imputedText')">
                                                    (!)
                                                </span>
                                            }
                                        </div>
                                        @{
                                            var historyEntries = new List<(string Label, string Value, string? Tooltip)>();
                                            if (!string.IsNullOrWhiteSpace(top3RateTitle) && top3RateText != "-")
                                            {
                                                historyEntries.Add(("Top 3 finish rate", top3RateText, top3RateTitle));
                                            }
                                            if (!string.IsNullOrWhiteSpace(top5RateTitle) && top5RateText != "-")
                                            {
                                                historyEntries.Add(("Top 5 finish rate", top5RateText, top5RateTitle));
                                            }
                                            if (runner.FinishPositionVolatility.HasValue && volatilityText != "-")
                                            {
                                                historyEntries.Add(("Finish volatility", volatilityText, volatilityTitle));
                                            }

                                            var featureValues = runner.FeatureValues?.Count > 0
                                            ? runner.FeatureValues
                                            : null;

                                            var trainerStats = new List<(string Label, string Value, string? Tooltip)>();
                                            if (runner.TrainerHistoricalRaceCount.HasValue && runner.TrainerHistoricalRaceCount.Value > 0)
                                            {
                                                trainerStats.Add(("Sample size", runner.TrainerHistoricalRaceCount.Value.ToString("N0", CultureInfo.CurrentCulture), null));
                                            }
                                            if (runner.TrainerTop3FinishRate.HasValue)
                                            {
                                                var percent = runner.TrainerTop3FinishRate.Value * 100d;
                                                trainerStats.Add(("Sample size", runner.TrainerHistoricalRaceCount.Value.ToString("N0", CultureInfo.CurrentCulture), null));
                                            }
                                            if (runner.TrainerTop5FinishRate.HasValue)
                                            {
                                                var percent = runner.TrainerTop5FinishRate.Value * 100d;
                                                trainerStats.Add(("Top 5 finish %", percent.ToString("0.##", CultureInfo.CurrentCulture) + "%", null));
                                            }
                                            if (runner.TrainerFinishPositionVolatility.HasValue)
                                            {
                                                var percent = runner.TrainerFinishPositionVolatility.Value * 100d;
                                                trainerStats.Add(("Top 5 finish %", percent.ToString("0.##", CultureInfo.CurrentCulture) + "%", null));
                                            }
                                            if (featureValues != null)
                                            {
                                                var trainerLifetime = FormatWinRatePercentage(ExtractFeatureMetric(featureValues, "TrainerWinRate"), CultureInfo.CurrentCulture);
                                                var trainerRecentStarts = FormatWinRatePercentage(ExtractFeatureMetric(featureValues, "TrainerWinRateLast50"), CultureInfo.CurrentCulture);
                                                var trainerRecentDays = FormatWinRatePercentage(ExtractFeatureMetric(featureValues, "TrainerWinRateRecentDays"), CultureInfo.CurrentCulture);

                                                if (!string.IsNullOrWhiteSpace(trainerLifetime))
                                                {
                                                    trainerStats.Add(("Lifetime win %", trainerLifetime, null));
                                                }
                                                if (!string.IsNullOrWhiteSpace(trainerRecentStarts))
                                                {
                                                    trainerStats.Add(("Last 50 win %", trainerRecentStarts, null));
                                                }
                                                if (!string.IsNullOrWhiteSpace(trainerRecentDays))
                                                {
                                                    trainerStats.Add(("Recent days win %", trainerRecentDays, null));
                                                }
                                            }

                                            var jockeyStats = new List<(string Label, string Value, string? Tooltip)>();
                                            if (runner.JockeyHistoricalRaceCount.HasValue && runner.JockeyHistoricalRaceCount.Value > 0)
                                            {
                                                jockeyStats.Add(("Sample size", runner.JockeyHistoricalRaceCount.Value.ToString("N0", CultureInfo.CurrentCulture), null));
                                            }
                                            if (runner.JockeyTop3FinishRate.HasValue)
                                            {
                                                var percent = runner.JockeyTop3FinishRate.Value * 100d;
                                                jockeyStats.Add(("Top 3 finish %", percent.ToString("0.##", CultureInfo.CurrentCulture) + "%", null));
                                            }
                                            if (runner.JockeyTop5FinishRate.HasValue)
                                            {
                                                var percent = runner.JockeyTop5FinishRate.Value * 100d;
                                                jockeyStats.Add(("Top 5 finish %", percent.ToString("0.##", CultureInfo.CurrentCulture) + "%", null));
                                            }
                                            if (runner.JockeyFinishPositionVolatility.HasValue)
                                            {
                                                var percent = runner.JockeyFinishPositionVolatility.Value * 100d;
                                                jockeyStats.Add(("Finish volatility", percent.ToString("0.##", CultureInfo.CurrentCulture) + "%", null));
                                            }
                                            if (featureValues != null)
                                            {
                                                var jockeyLifetime = FormatWinRatePercentage(ExtractFeatureMetric(featureValues, "JockeyWinRate"), CultureInfo.CurrentCulture);
                                                var jockeyRecentStarts = FormatWinRatePercentage(ExtractFeatureMetric(featureValues, "JockeyWinRateLast50"), CultureInfo.CurrentCulture);
                                                var jockeyRecentDays = FormatWinRatePercentage(ExtractFeatureMetric(featureValues, "JockeyWinRateRecentDays"), CultureInfo.CurrentCulture);

                                                if (!string.IsNullOrWhiteSpace(jockeyLifetime))
                                                {
                                                    jockeyStats.Add(("Lifetime win %", jockeyLifetime, null));
                                                }
                                                if (!string.IsNullOrWhiteSpace(jockeyRecentStarts))
                                                {
                                                    jockeyStats.Add(("Last 50 win %", jockeyRecentStarts, null));
                                                }
                                                if (!string.IsNullOrWhiteSpace(jockeyRecentDays))
                                                {
                                                    jockeyStats.Add(("Recent days win %", jockeyRecentDays, null));
                                                }
                                            }
                                            var snapshotSections = new List<(string? Title, List<(string Label, string Value, string? Tooltip)> Entries)>();

                                            if (historyEntries.Count > 0)
                                            {
                                                var horseTitle = trainerStats.Count > 0 || jockeyStats.Count > 0
                                                ? "Horse historical"
                                                : null;
                                                snapshotSections.Add((horseTitle, historyEntries));
                                            }

                                            if (trainerStats.Count > 0)
                                            {
                                                snapshotSections.Add(("Trainer historical", trainerStats));
                                            }

                                            if (jockeyStats.Count > 0)
                                            {
                                                snapshotSections.Add(("Jockey historical", jockeyStats));
                                            }

                                            var hasHistorySummary = snapshotSections.Count > 0;
                                        }

                                        @if (hasHistorySummary)
                                        {
                                            <details class="small runner-history-details mt-1">
                                                <summary class="text-muted">Form snapshot</summary>
                                                <div class="runner-history-body mt-2">
                                                    @{
                                                        var sectionIndex = 0;
                                                    }
                                                    @foreach (var section in snapshotSections)
                                                    {
                                                        var headingClass = sectionIndex > 0 ? "mt-3" : string.Empty;
                                                        if (!string.IsNullOrEmpty(section.Title))
                                                        {
                                                            <div class="text-muted text-uppercase small fw-semibold @headingClass">@(section.Title)</div>
                                                            headingClass = "mt-1";
                                                        }

                                                        var listClass = section.Title != null
                                                        ? $"row small mb-0 {headingClass}".Trim()
                                                        : sectionIndex > 0
                                                        ? "row small mb-0 mt-3"
                                                        : "row small mb-0";

                                                        <dl class="@listClass">
                                                            @foreach (var entry in section.Entries)
                                                            {
                                                                <dt class="col-sm-6">@entry.Label</dt>
                                                                <dd class="col-sm-6">
                                                                    @if (!string.IsNullOrEmpty(entry.Tooltip))
                                                                    {
                                                                        <span title="@entry.Tooltip">@entry.Value</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        @entry.Value
                                                                    }
                                                                </dd>
                                                            }
                                                        </dl>

                                                        sectionIndex++;
                                                    }
                                                </div>
                                            </details>
                                        }
                                        @{
                                            var featurePopulation = runner.FeaturePopulation;
                                            var hasPopulationData = featurePopulation != null && featurePopulation.HasData;
                                            HashSet<string>? appliedFeatureKeys = null;
                                            if (runner.AiTrainedModelApplied && featurePopulation?.PopulatedKeys?.Count > 0)
                                            {
                                                appliedFeatureKeys = new HashSet<string>(featurePopulation.PopulatedKeys, StringComparer.OrdinalIgnoreCase);
                                            }

                                            var featureItems = (runner.FeatureValues?.AsEnumerable() ?? Enumerable.Empty<KeyValuePair<string, object?>>())
                                            .Where(feature => appliedFeatureKeys == null || appliedFeatureKeys.Contains(feature.Key))
                                            .OrderBy(feature => feature.Key, StringComparer.OrdinalIgnoreCase)
                                            .ToList();

                                            var hasFeatureValues = featureItems.Count > 0;
                                            var encodedValues = (runner.EncodedFeatureValues?.AsEnumerable() ?? Enumerable.Empty<EncodedFeatureValue>())
                                            .OrderBy(value => value.Index)
                                            .ToList();
                                            var hasEncodedValues = encodedValues.Count > 0;
                                            var encodedActiveFromValues = hasEncodedValues
                                            ? encodedValues.Count(value => value.Active)
                                            : 0;
                                            var showNormalized = encodedValues.Any(value => value.NormalizedValue.HasValue);
                                            var showWeight = encodedValues.Any(value => value.Weight.HasValue);
                                            var showContribution = encodedValues.Any(value => value.Contribution.HasValue);
                                            var populationEncodedActive = runner.FeaturePopulation?.ActiveEncodedDimensions ?? 0;
                                            var populationEncodedTotal = runner.FeaturePopulation?.TotalEncodedDimensions ?? 0;
                                            var displayEncodedActive = populationEncodedActive > 0
                                            ? populationEncodedActive
                                            : encodedActiveFromValues;
                                            var displayEncodedTotal = populationEncodedTotal > 0
                                            ? populationEncodedTotal
                                            : hasEncodedValues
                                            ? encodedValues.Count
                                            : 0;
                                            if (hasEncodedValues && encodedValues.Count > displayEncodedTotal)
                                            {
                                                displayEncodedTotal = encodedValues.Count;
                                            }
                                            if (displayEncodedActive > displayEncodedTotal)
                                            {
                                                displayEncodedActive = displayEncodedTotal;
                                            }
                                            var displayEncodedInactive = displayEncodedTotal > displayEncodedActive
                                            ? displayEncodedTotal - displayEncodedActive
                                            : 0;
                                        }

                                        @if (hasFeatureValues || hasPopulationData || hasEncodedValues)
                                        {
                                            var summaryLabel = runner.AiTrainedModelApplied ? "Neural features" : "Feature inputs";
                                            if (featurePopulation != null && featurePopulation.HasData)
                                            {
                                                if (runner.AiTrainedModelApplied)
                                                {
                                                    summaryLabel = featurePopulation.MissingCount > 0
                                                    ? $"Neural features ({featurePopulation.PopulatedCount} applied, {featurePopulation.MissingCount} missing)"
                                                    : $"Neural features ({featurePopulation.PopulatedCount} applied)";
                                                }
                                                else
                                                {
                                                    summaryLabel = featurePopulation.MissingCount > 0
                                                    ? $"Feature inputs ({featurePopulation.PopulatedCount} populated, {featurePopulation.MissingCount} missing)"
                                                    : $"Feature inputs ({featurePopulation.PopulatedCount} populated)";
                                                }
                                            }
                                            if (displayEncodedTotal > 0)
                                            {
                                                var encodedSummary = displayEncodedActive == displayEncodedTotal
                                                ? $"{displayEncodedTotal} encoded dimensions active"
                                                : $"{displayEncodedActive} of {displayEncodedTotal} encoded dimensions active";

                                                summaryLabel = string.IsNullOrEmpty(summaryLabel)
                                                ? encodedSummary
                                                : $"{summaryLabel}; {encodedSummary}";
                                            }
                                            <details class="small mt-1">
                                                <summary class="text-muted">@summaryLabel</summary>
                                                @{
                                                    var topContributorItems = showContribution && hasEncodedValues
                                                    ? encodedValues
                                                    .Where(value => value.Active && value.Contribution.HasValue && value.Contribution.Value > 0)
                                                    .OrderByDescending(value => value.Contribution!.Value)
                                                    .ToList()
                                                    : new List<EncodedFeatureValue>();
                                                    var suppressedHeadwinds = showContribution && hasEncodedValues
                                                    ? encodedValues
                                                    .Where(value => value.Active && value.Contribution.HasValue && value.Contribution.Value < 0)
                                                    .OrderBy(value => value.Contribution!.Value)
                                                    .ToList()
                                                    : new List<EncodedFeatureValue>();
                                                }
                                                @if (topContributorItems.Count > 0 || suppressedHeadwinds.Count > 0)
                                                {
                                                    <div class="mt-2">
                                                        <div class="small text-muted text-uppercase fw-semibold">Model signal explainer</div>
                                                        @if (topContributorItems.Count > 0)
                                                        {
                                                            <div class="small mt-1">
                                                                <span class="fw-semibold">Positive signal features:</span>
                                                                <ul class="mb-0 ps-3">
                                                                    @foreach (var item in topContributorItems)
                                                                    {
                                                                        var contributionText = item.Contribution!.Value.ToString("+0.######;-0.######", CultureInfo.CurrentCulture);
                                                                        <li>
                                                                            <span class="fw-semibold">@item.Label</span>
                                                                            <span class="text-success">@contributionText</span>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                        @if (suppressedHeadwinds.Count > 0)
                                                        {
                                                            <div class="small mt-2">
                                                                <span class="fw-semibold">Negative signal features:</span>
                                                                <ul class="mb-0 ps-3">
                                                                    @foreach (var item in suppressedHeadwinds)
                                                                    {
                                                                        var contributionText = item.Contribution!.Value.ToString("+0.######;-0.######", CultureInfo.CurrentCulture);
                                                                        <li>
                                                                            <span class="fw-semibold">@item.Label</span>
                                                                            <span class="text-danger">@contributionText</span>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                <dl class="row mb-0">
                                                    @if (hasFeatureValues)
                                                    {
                                                        @foreach (var feature in featureItems)
                                                        {
                                                            var valueText = feature.Value switch
                                                            {
                                                                null => "-",
                                                                IFormattable formattable => formattable.ToString(null, CultureInfo.CurrentCulture),
                                                                _ => feature.Value.ToString() ?? string.Empty
                                                            };

                                                            <dt class="col-sm-5">@feature.Key</dt>
                                                            <dd class="col-sm-7">@valueText</dd>
                                                        }
                                                    }

                                                    @if (featurePopulation != null && featurePopulation.MissingCount > 0)
                                                    {
                                                        <dt class="col-sm-5 text-danger">Missing inputs</dt>
                                                        <dd class="col-sm-7 text-danger">
                                                            @string.Join(", ", featurePopulation.MissingKeys)
                                                        </dd>
                                                    }
                                                </dl>
                                                @if (displayEncodedTotal > 0)
                                                {
                                                    <div class="mt-2">
                                                        <div class="text-muted small">
                                                            Encoded dimensions (@displayEncodedActive active, @displayEncodedInactive suppressed / @displayEncodedTotal total)
                                                        </div>
                                                        @if (hasEncodedValues)
                                                        {
                                                            <div class="table-responsive">
                                                                <table class="table table-sm table-borderless align-middle mb-0">
                                                                    <thead class="text-muted text-uppercase small">
                                                                        <tr>
                                                                            <th scope="col">Idx</th>
                                                                            <th scope="col">Label</th>
                                                                            @if (showNormalized)
                                                                            {
                                                                                <th scope="col" class="text-end">Normalized</th>
                                                                            }
                                                                            @if (showWeight)
                                                                            {
                                                                                <th scope="col" class="text-end">Weight</th>
                                                                            }
                                                                            <th scope="col" class="text-end">Value</th>
                                                                            @if (showNormalized)
                                                                            {
                                                                                <th scope="col" class="text-end">Normalized</th>
                                                                            }
                                                                            @if (showWeight)
                                                                            {
                                                                                <th scope="col" class="text-end">Weight</th>
                                                                            }
                                                                            <th scope="col" class="text-center">State</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var encoded in encodedValues)
                                                                        {
                                                                            var encodedRowClass = encoded.Active ? string.Empty : "text-muted";
                                                                            var encodedValueText = encoded.Value.ToString("0.######", CultureInfo.CurrentCulture);
                                                                            var normalizedText = showNormalized && encoded.NormalizedValue.HasValue
                                                                            ? encoded.NormalizedValue.Value.ToString("0.######", CultureInfo.CurrentCulture)
                                                                            : "-";
                                                                            var weightText = showWeight && encoded.Weight.HasValue
                                                                            ? encoded.Weight.Value.ToString("0.######", CultureInfo.CurrentCulture)
                                                                            : "-";
                                                                            var contributionText = showContribution && encoded.Contribution.HasValue
                                                                            ? encoded.Contribution.Value.ToString("+0.######;-0.######", CultureInfo.CurrentCulture)
                                                                            : "-";
                                                                            <tr class="@encodedRowClass">
                                                                                <td>@encoded.Index</td>
                                                                                <td title="@encoded.FeatureKey">@encoded.Label</td>
                                                                                @if (showNormalized)
                                                                                {
                                                                                    <td class="text-end">@normalizedText</td>
                                                                                }
                                                                                @if (showWeight)
                                                                                {
                                                                                    <td class="text-end">@weightText</td>
                                                                                }
                                                                                <td class="text-end">@encodedValueText</td>
                                                                                @if (showContribution)
                                                                                {
                                                                                    <td class="text-end">@contributionText</td>
                                                                                }
                                                                                <td class="text-center">@(encoded.Active ? "Active" : "Suppressed")</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-muted small">
                                                                Encoded feature values were not captured for this runner, but the trained model tracks @displayEncodedTotal dimensions.
                                                            </div>
                                                        }
                                                    </div>

                                                }
                                            </details>
                                        }
                                    </td>
                                    <td>@runner.JockeyName</td>
                                    <td class="text-end">
                                        @if (!string.IsNullOrEmpty(historicalRacesJson))
                                        {
                                            <button type="button"
                                                    class="btn btn-link p-0 historical-races-btn"
                                                    data-runner-name="@(runner.HorseName ?? string.Empty)"
                                                    data-history-count="@(runner.HistoricalRaceCount?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
                                                    data-historical-races="@historicalRacesJson">
                                                @historyCountText
                                            </button>
                                        }
                                        else
                                        {
                                            @historyCountText
                                        }
                                    </td>
                                    <td class="text-end top3-cell">
                                        @if (!string.IsNullOrEmpty(top3RateTitle) && top3RateText != "-")
                                        {
                                            <span title="@top3RateTitle">@top3RateText</span>
                                        }
                                        else
                                        {
                                            @top3RateText
                                        }
                                    </td>
                                    <td class="text-end top5-cell">
                                        @if (!string.IsNullOrEmpty(top5RateTitle) && top5RateText != "-")
                                        {
                                            <span title="@top5RateTitle">@top5RateText</span>
                                        }
                                        else
                                        {
                                            @top5RateText
                                        }
                                    </td>
                                    <td class="text-end finish-vol-cell">
                                        @if (!string.IsNullOrEmpty(volatilityTitle) && volatilityText != "-")
                                        {
                                            <span title="@volatilityTitle">@volatilityText</span>
                                        }
                                        else
                                        {
                                            @volatilityText
                                        }
                                    </td>
                                    <td class="text-end market-odds-cell">
                                        <input type="text"
                                               class="form-control form-control-sm text-end market-odds-input"
                                               inputmode="decimal"
                                               placeholder="-"
                                               value="@(marketOdds == "-" ? string.Empty : marketOdds)" />
                                    </td>
                                    <td class="text-end lay-odds-cell">
                                        <input type="text"
                                               class="form-control form-control-sm text-end lay-odds-input"
                                               inputmode="decimal"
                                               placeholder="-"
                                               value="@(layOdds == "-" ? string.Empty : layOdds)" />
                                    </td>
                                    <td class="text-end ai-win-cell">
                                        @if (!string.IsNullOrEmpty(aiWinTitle))
                                        {
                                            <span class="ai-win-primary" title="@aiWinTitle">@aiWinPrimary</span>
                                        }
                                        else
                                        {
                                            <span class="ai-win-primary">@aiWinPrimary</span>
                                        }

                                        @if (!string.IsNullOrEmpty(aiWinSecondary))
                                        {
                                            <div class="text-muted small ai-win-secondary">@aiWinSecondary</div>
                                        }
                                        @if (displayAiFromMarket)
                                        {
                                            <div class="text-warning small ai-market-indicator">Market probability applied</div>
                                        }
                                        @if (runner.AiTrainedModelApplied)
                                        {
                                            <div class="text-success small ai-win-note">Trained neural model applied</div>
                                            @if (!string.IsNullOrWhiteSpace(runner.AiProbabilityFallbackReason))
                                            {
                                                <div class="text-muted small ai-win-note">@runner.AiProbabilityFallbackReason</div>
                                            }
                                        }
                                        else if (runner.AiUsedLegacyModel)
                                        {
                                            var fallbackText = string.IsNullOrWhiteSpace(runner.AiProbabilityFallbackReason)
                                            ? "Legacy logistic regression fallback"
                                            : $"Legacy logistic regression fallback: {runner.AiProbabilityFallbackReason}";
                                            <div class="text-warning small ai-win-note">@fallbackText</div>
                                        }
                                        else if (runner.AiProbabilityMarketDerived)
                                        {
                                            var fallbackText = string.IsNullOrWhiteSpace(runner.AiProbabilityFallbackReason)
                                            ? "Market-derived fallback"
                                            : $"Market-derived fallback: {runner.AiProbabilityFallbackReason}";
                                            <div class="text-warning small ai-win-note">@fallbackText</div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(runner.AiProbabilityFallbackReason))
                                        {
                                            <div class="text-muted small ai-win-note">@runner.AiProbabilityFallbackReason</div>
                                        }
                                    </td>
                                    <td class="text-end ai-odds-cell">@aiOdds</td>
                                    @{
                                        var applyButtonDisabled = true;
                                        if (!string.IsNullOrEmpty(marketProbabilityAttr)
                                        && double.TryParse(marketProbabilityAttr, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsedMarketProbability))
                                        {
                                            applyButtonDisabled = parsedMarketProbability <= 0d;
                                        }
                                    }
                                    <td class="text-end apply-market-cell">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary apply-market-btn"
                                                @(applyButtonDisabled ? "disabled" : string.Empty)
                                                data-runner-name="@runner.HorseName">
                                            Use market
                                        </button>
                                    </td>
                                    <td class="text-end market-win-cell">@marketProb</td>
                                    <td class="text-end edge-cell">@diff</td>
                                    <td class="text-end kelly-cell">@displayedKelly</td>
                                    <td class="text-end">
                                        <span class="stake-value"
                                              data-default-stake="@stakeData"
                                              data-kelly-fraction="@kellyData"
                                              data-stake-type="@stakeType"
                                              data-lay-odds="@layOddsData"
                                              data-original-lay-odds="@layOddsData"
                                              data-original-text="@displayedStake">@displayedStake</span>
                                    </td>
                                    <td class="text-end roi-cell">-</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
<div class="modal fade" id="historicalRacesModal" tabindex="-1" aria-labelledby="historicalRacesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="historicalRacesModalLabel">Historical races</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="historical-races-summary text-muted small mb-3"></div>
                <div class="historical-races-content">
                    <div class="text-muted">No historical races are available for this runner.</div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        (function () {
