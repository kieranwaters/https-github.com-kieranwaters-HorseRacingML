            const formatStakeDisplay = (value, stakeType) => {
                const formatted = formatStakeAmount(value);
                if (!formatted) {
                    return null;
                }

                return stakeType === 'lay' ? `Lay ${formatted}` : formatted;
            };
            const historicalRacesModalElement = document.getElementById('historicalRacesModal');
            const historicalRacesModalLabel = document.getElementById('historicalRacesModalLabel');
            const historicalRacesSummary = historicalRacesModalElement
                ? historicalRacesModalElement.querySelector('.historical-races-summary')
                : null;
            const historicalRacesContent = historicalRacesModalElement
                ? historicalRacesModalElement.querySelector('.historical-races-content')
                : null;

            const parseHistoricalRaceList = (raw) => {
                if (!raw) {
                    return [];
                }

                if (Array.isArray(raw)) {
                    return raw;
                }

                if (typeof raw === 'string') {
                    const trimmed = raw.trim();
                    if (trimmed.length === 0) {
                        return [];
                    }

                    try {
                        const parsed = JSON.parse(trimmed);
                        return Array.isArray(parsed) ? parsed : [];
