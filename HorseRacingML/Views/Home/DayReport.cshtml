﻿
@model HorseRacingML.Models.DayReportViewModel
@using System.Collections.Generic
@using System.Globalization
@using System
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Linq
@using HorseRacingML.ML
@using HorseRacingML.Models
@{
    ViewData["Title"] = "Day Report";
    var generatedLocal = Model.GeneratedAt.ToLocalTime();
    var bankrollText = Model.Bankroll > 0
        ? Model.Bankroll.ToString("C", CultureInfo.CurrentCulture)
        : Model.Bankroll.ToString("0.00", CultureInfo.CurrentCulture);

    string FormatProbabilityPercent(double value, CultureInfo culture)
    {
        if (!double.IsFinite(value) || value < 0)
        {
            return "-";
        }

        var percent = value * 100d;

        if (percent >= 0.01d)
        {
            return percent.ToString("0.##", culture) + "%";
        }

        if (percent >= 0.0001d)
        {
            return percent.ToString("0.####", culture) + "%";
        }

        if (percent > 0d)
        {
            return "<0.0001%";
        }

        return "0%";
    }

    string? BuildProbabilityTooltip(double value, CultureInfo culture)
    {
        if (!double.IsFinite(value) || value < 0)
        {
            return null;
        }

        return value.ToString("P6", culture);
    }

    string BuildHyperparameterSummary(HyperparameterSummary summary, CultureInfo culture)
    {
        var segments = new List<string>
        {
            $"Layers: {summary.Layers}",
            $"Units: {summary.Units}",
            $"Dropout: {summary.Dropout.ToString("0.###", culture)}",
            $"Learning rate: {summary.LearningRate.ToString("0.#####", culture)}",
            $"Epochs: {summary.Epochs}",
            $"Batch size: {summary.BatchSize}",
            $"Folds: {summary.Folds}"
        };

        if (summary.Fold.HasValue)
        {
            segments.Add($"Fold: {summary.Fold.Value}");
        }

        return string.Join(" | ", segments);
    }

    string? BuildHyperparameterTimestamp(HyperparameterSummary summary, CultureInfo culture)
    {
        if (!summary.TrainedAtUtc.HasValue)
        {
            return null;
        }

        var utc = summary.TrainedAtUtc.Value;
        if (utc.Kind == DateTimeKind.Unspecified)
        {
            utc = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        }

        var local = utc.Kind == DateTimeKind.Utc ? utc.ToLocalTime() : utc;
        return local.ToString("f", culture);
    }
    string? FormatFilterTime(TimeSpan? value, CultureInfo culture)
    {
        if (!value.HasValue)
        {
            return null;
        }

        return DateTime.Today.Add(value.Value).ToString("t", culture);
    }

    var filterStartText = FormatFilterTime(Model.FilterStartTime, CultureInfo.CurrentCulture);
    var filterEndText = FormatFilterTime(Model.FilterEndTime, CultureInfo.CurrentCulture);
    string? filterSummary = null;

    if (!string.IsNullOrEmpty(filterStartText) && !string.IsNullOrEmpty(filterEndText))
    {
        filterSummary = $"Showing races between {filterStartText} and {filterEndText}.";
    }
    else if (!string.IsNullOrEmpty(filterStartText))
    {
        filterSummary = $"Showing races from {filterStartText} onwards.";
    }
    else if (!string.IsNullOrEmpty(filterEndText))
    {
        filterSummary = $"Showing races until {filterEndText}.";
    }

    var filterStartRouteValue = Model.FilterStartTime.HasValue
        ? Model.FilterStartTime.Value.ToString(@"hh\:mm", CultureInfo.InvariantCulture)
        : null;
    var filterEndRouteValue = Model.FilterEndTime.HasValue
        ? Model.FilterEndTime.Value.ToString(@"hh\:mm", CultureInfo.InvariantCulture)
        : null;
        var initialRegionSelection = string.IsNullOrWhiteSpace(Model?.InitialRegion)
        ? DayReportFilterViewModel.DefaultRegion
        : Model.InitialRegion!;
        string DetermineRaceRegion(string? country)
    {
        if (string.IsNullOrWhiteSpace(country))
        {
            return "GB & IRE";
        }

        var normalized = country.Trim().ToUpperInvariant();

        if (normalized.Contains("UNITED KINGDOM") ||
            normalized.Contains("GREAT BRITAIN") ||
            normalized.Contains("ENGLAND") ||
            normalized.Contains("SCOTLAND") ||
            normalized.Contains("WALES") ||
            normalized.Contains("NORTHERN IRELAND") ||
            normalized.Contains("IRELAND") ||
            normalized == "UK" ||
            normalized == "GB" ||
            normalized == "IRE" ||
            normalized == "EIRE")
        {
            return "GB & IRE";
        }

        if (normalized.Contains("UNITED STATES") ||
            normalized.Contains("AMERICA") ||
            normalized == "USA" ||
            normalized == "US")
        {
            return "USA";
        }

        if (normalized.Contains("SOUTH AFRICA") ||
            normalized == "RSA")
        {
            return "RSA";
        }

        if (normalized.Contains("FRANCE") ||
            normalized == "FRA")
        {
            return "FRA";
        }

    if (normalized.Contains("AUSTRALIA") ||
            normalized == "AUS" ||
            normalized == "AUST")
        {
            return "AUS";
        }

        return "GB & IRE";
    }

    var regionOrder = new[] { "GB & IRE", "USA", "RSA", "FRA", "AUS" };
    var regionRaceCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var regionTrackSets = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);

    foreach (var region in regionOrder)
    {
        regionRaceCounts[region] = 0;
        regionTrackSets[region] = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    if (Model.Races != null)
    {
        foreach (var race in Model.Races)
        {
            var region = DetermineRaceRegion(race.VenueCountry);
            if (!regionRaceCounts.ContainsKey(region))
            {
                regionRaceCounts[region] = 0;
            }

            if (!regionTrackSets.ContainsKey(region))
            {
                regionTrackSets[region] = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            }

            regionRaceCounts[region]++;

            var venueName = race.VenueName?.Trim();
            if (!string.IsNullOrEmpty(venueName))
            {
                regionTrackSets[region].Add(venueName);
            }
        }
    }

    var regionSummaries = regionOrder
        .Select(region => new
        {
            Region = region,
            RaceCount = regionRaceCounts.TryGetValue(region, out var races) ? races : 0,
            TrackCount = regionTrackSets.TryGetValue(region, out var tracks) ? tracks.Count : 0
        })
        .ToList();
    var historicalRaceSerializerOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web)
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Day Report</h1>
        <p class="text-muted mb-0">
            Generated @generatedLocal.ToString("f", CultureInfo.CurrentCulture)
            <span class="ms-2">Bankroll: @bankrollText</span>
        </p>
        @if (Model.AiHyperparameters != null)
        {
            var summaryText = BuildHyperparameterSummary(Model.AiHyperparameters, CultureInfo.CurrentCulture);
            var trainedText = BuildHyperparameterTimestamp(Model.AiHyperparameters, CultureInfo.CurrentCulture);
            <div class="text-muted small mt-1">
                <span>AI hyperparameters: @summaryText</span>
                @if (!string.IsNullOrEmpty(trainedText))
                {
                    <span class="ms-2">Trained @trainedText</span>
                }
            </div>
        }
    </div>
    <div class="d-flex flex-column flex-sm-row gap-2">
        <a class="btn btn-outline-secondary" asp-action="DayReportOptions" asp-route-startTime="@filterStartRouteValue" asp-route-endTime="@filterEndRouteValue" asp-route-region="@initialRegionSelection">
            Change time filter
        </a>
        <button type="button" id="removePastRacesButton" class="btn btn-outline-danger">Remove past races</button>
        <button type="button" id="saveReportButton" class="btn btn-outline-primary">Save Report</button>
</div>
        @if (!string.IsNullOrEmpty(filterSummary))
{
    <div class="alert alert-secondary">@filterSummary</div>
}
@if (Model.Races != null && Model.Races.Count > 0)
{
    <input type="hidden" id="dayReportInitialRegion" value="@initialRegionSelection" />
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <label for="dayReportRegionSelect" class="form-label mb-1">Region</label>
                    <select id="dayReportRegionSelect" class="form-select form-select-sm">
                        <option value="GB &amp; IRE" selected='@(initialRegionSelection == "GB & IRE" ? "selected" : null)'>GB &amp; IRE</option>
                        <option value="USA" selected='@(initialRegionSelection == "USA" ? "selected" : null)'>USA</option>
                        <option value="RSA" selected='@(initialRegionSelection == "RSA" ? "selected" : null)'>RSA</option>
                        <option value="FRA" selected='@(initialRegionSelection == "FRA" ? "selected" : null)'>FRA</option>
                         <option value="AUS" selected='@(initialRegionSelection == "AUS" ? "selected" : null)'>AUS</option>
                        <option value="All" selected='@(initialRegionSelection == "All" ? "selected" : null)'>All</option>
                    </select>
                    <div class="form-text">Use the selector to focus on specific race regions.</div>
                </div>
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-2" id="dayReportRegionButtons">
                        @foreach (var summary in regionSummaries)
                        {
                            var trackLabel = summary.TrackCount == 1 ? "track" : "tracks";
                            var raceLabel = summary.RaceCount == 1 ? "race" : "races";
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm region-filter-btn"
                                    data-region="@summary.Region">
                                @summary.Region (@summary.TrackCount @trackLabel / @summary.RaceCount @raceLabel)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
   
</div>
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="kellyBankrollInput" class="form-label mb-1">Kelly bankroll override</label>
                <input type="number"
                       class="form-control form-control-sm"
                       id="kellyBankrollInput"
                       placeholder="Enter bankroll"
                       step="0.01"
                       min="0.01"
                       inputmode="decimal"
                       data-report-bankroll="@Model.Bankroll.ToString("0.##", CultureInfo.InvariantCulture)" />
                <div class="form-text">Kelly stakes update immediately when this override is set.</div>
                <div class="invalid-feedback">Enter a positive bankroll to apply the override.</div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="stakeAmountInput" class="form-label mb-1">Stake amount override</label>
                <input type="number"
                       class="form-control form-control-sm"
                       id="stakeAmountInput"
                       placeholder="Enter flat stake"
                       step="0.01"
                       min="0.01"
                       inputmode="decimal" />
                <div class="form-text">Apply a flat stake value to every runner recommendation.</div>
                <div class="invalid-feedback">Enter a positive stake amount to apply the override.</div>
            </div>
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="stakeDampenerInput" class="form-label mb-1">Stake dampener</label>
                <input type="number"
                       class="form-control form-control-sm"
                       id="stakeDampenerInput"
                       value="1"
                       step="0.01"
                       min="0.01"
                       inputmode="decimal" />
                <div class="form-text">Divide every stake by this value to temper staking.</div>
                <div class="invalid-feedback">Enter a dampener greater than zero.</div>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="button" id="kellyBankrollUseReport" class="btn btn-outline-secondary btn-sm">
                    Use report bankroll (@bankrollText)
                </button>
                <button type="button" id="kellyBankrollReset" class="btn btn-outline-secondary btn-sm">
                    Clear bankroll override
                </button>
                <button type="button" id="stakeAmountReset" class="btn btn-outline-secondary btn-sm">
                    Clear stake override
                </button>
                <button type="button" id="stakeDampenerReset" class="btn btn-outline-secondary btn-sm">
                    Reset dampener
                </button>
            </div>
        </div>
    </div>
</div>

@if (Model.Races == null || Model.Races.Count == 0)
{
    <div class="alert alert-info">No race data was captured while scanning the open markets.</div>
}
else
{
    for (var raceIndex = 0; raceIndex < Model.Races.Count; raceIndex++)
    {
        var race = Model.Races[raceIndex];
        var raceTitle = string.IsNullOrWhiteSpace(race.RaceTitle)
            ? "Unknown Race"
            : race.RaceTitle;

        var venueParts = new[] { race.VenueName, race.VenueCountry }
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();

        var scheduleParts = new List<string>();
        if (race.RaceDate.HasValue)
        {
            scheduleParts.Add(race.RaceDate.Value.ToString("yyyy-MM-dd", CultureInfo.CurrentCulture));
        }

        if (race.OffTime.HasValue)
        {
            scheduleParts.Add(race.OffTime.Value.ToString(@"hh\:mm", CultureInfo.CurrentCulture));
        }

        var bookParts = new List<string>();
        if (race.BackBookPercentage.HasValue)
        {
            bookParts.Add($"Back {race.BackBookPercentage.Value.ToString("0.##", CultureInfo.CurrentCulture)}%");
        }

        if (race.LayBookPercentage.HasValue)
        {
            bookParts.Add($"Lay {race.LayBookPercentage.Value.ToString("0.##", CultureInfo.CurrentCulture)}%");
        }
        var goingText = string.IsNullOrWhiteSpace(race.Going)
            ? null
            : race.Going.Trim();
        var orderedRunners = (race.Runners ?? new List<RunnerDayReport>())
            .OrderBy(r => r.ClothNumber ?? byte.MaxValue)
            .ThenBy(r => r.HorseName ?? string.Empty)
            .ToList();

        DateTime? raceStart = null;
        if (race.RaceDate.HasValue)
        {
            var baseDate = race.RaceDate.Value;
            if (race.OffTime.HasValue)
            {
                raceStart = baseDate.Date + race.OffTime.Value;
            }
            else
            {
                raceStart = baseDate;
            }
        }

        var raceStartIso = raceStart.HasValue
            ? raceStart.Value.ToString("o", CultureInfo.InvariantCulture)
            : string.Empty;
var raceRegion = DetermineRaceRegion(race.VenueCountry);

        <div class="card mb-4 race-card" data-market-id="@race.MarketId" data-race-start="@raceStartIso" data-region="@raceRegion">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1 mb-sm-0">@raceTitle</h2>
                        <div class="small text-muted">
                            @if (venueParts.Count > 0)
                            {
                                <span>@string.Join(" - ", venueParts)</span>
                            }

                            @if (scheduleParts.Count > 0)
                            {
                                <span class="ms-2">@string.Join(" ", scheduleParts)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(race.RaceType))
                            {
                                <span class="ms-2">Type: @race.RaceType</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(race.RaceDetails))
                            {
                                <span class="ms-2">@race.RaceDetails</span>
                            }

                            @if (bookParts.Count > 0)
                            {
                                <span class="ms-2">Book: @string.Join(" / ", bookParts)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(goingText))
                            {
                                <span class="ms-2">Going: @goingText</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-2 text-end">
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary refresh-market-only-btn"
                            data-market-id="@race.MarketId"
                            data-race-url="@race.RaceUrl"
                                data-current-going="@goingText"
                            data-current-going="@goingText"
                            @(string.IsNullOrWhiteSpace(race.RaceUrl) ? "disabled" : string.Empty)>
                            Refresh market odds
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary refresh-race-btn"
                            data-market-id="@race.MarketId"
                            data-race-url="@race.RaceUrl"
                            @(string.IsNullOrWhiteSpace(race.RaceUrl) ? "disabled" : string.Empty)>
                            Full refresh (AI + odds)
                        </button>
                          </div>
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(race.RaceFallbackSummary))
                {
                    <div class="alert alert-warning small" role="status">
                        <strong>AI fallback:</strong> @race.RaceFallbackSummary
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Draw</th>
                                <th scope="col">Horse</th>
                                <th scope="col">Jockey</th>
                                <th scope="col" class="text-end">Hist. Races</th>
                                <th scope="col" class="text-end">Top 3 %</th>
                                <th scope="col" class="text-end">Top 5 %</th>
                                <th scope="col" class="text-end">Finish Vol.</th>
                                <th scope="col" class="text-end">Market Odds</th>
                                <th scope="col" class="text-end">Lay Odds</th>
                                <th scope="col" class="text-end">AI Win %</th>
                                <th scope="col" class="text-end">AI Odds</th>
                                <th scope="col" class="text-end">Market Win %</th>
                                <th scope="col" class="text-end">Edge</th>
                                <th scope="col" class="text-end">Kelly %</th>
                                <th scope="col" class="text-end">Stake</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var runner in orderedRunners)
                            {
                                var cloth = runner.ClothNumber.HasValue
                                    ? runner.ClothNumber.Value.ToString(CultureInfo.CurrentCulture)
                                    : "-";

                                var draw = runner.Draw.HasValue
                                    ? runner.Draw.Value.ToString(CultureInfo.CurrentCulture)
                                    : "-";
                                string historyCountText = "-";
                                string? historicalRacesJson = null;
                                if (runner.HistoricalRaceCount.HasValue)
                                {
                                    historyCountText = runner.HistoricalRaceCount.Value.ToString("N0", CultureInfo.CurrentCulture);
                                }
                                if (runner.HistoricalRaces != null && runner.HistoricalRaces.Count > 0)
                                {
                                    var orderedHistorical = runner.HistoricalRaces
                                    .OrderByDescending(r => r.RaceDate)
                                    .ToList();
                                    historicalRacesJson = JsonSerializer.Serialize(orderedHistorical, historicalRaceSerializerOptions);
                                }
            var top3RateText = "-";
            string? top3RateTitle = null;
            if (runner.Top3FinishRate.HasValue)
            {
                var rate = runner.Top3FinishRate.Value * 100d;
                top3RateText = rate.ToString("0.##", CultureInfo.CurrentCulture) + "%";
                top3RateTitle = $"{rate.ToString("0.###", CultureInfo.CurrentCulture)}% of historical runs finished in the top 3";
            }

            var top5RateText = "-";
            string? top5RateTitle = null;
            if (runner.Top5FinishRate.HasValue)
            {
                var rate = runner.Top5FinishRate.Value * 100d;
                top5RateText = rate.ToString("0.##", CultureInfo.CurrentCulture) + "%";
                top5RateTitle = $"{rate.ToString("0.###", CultureInfo.CurrentCulture)}% of historical runs finished in the top 5";
            }

            var volatilityText = "-";
            string? volatilityTitle = null;
            if (runner.FinishPositionVolatility.HasValue)
            {
                var volatilityPercent = runner.FinishPositionVolatility.Value * 100d;
                volatilityText = volatilityPercent.ToString("0.##", CultureInfo.CurrentCulture) + "%";
                volatilityTitle = "Standard deviation of normalized finishing positions across historical runs";
            }

                                var marketOdds = runner.MarketDecimalOdds.HasValue
                                    ? runner.MarketDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                    : "-";
                                var layOdds = runner.LayDecimalOdds.HasValue
                                    ? runner.LayDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                    : "-";
                                var displayAiProbability = runner.DisplayedAiProbability ?? runner.AiProbability;
                                var displayAiFromMarket = runner.DisplayedAiProbability.HasValue
                                ? runner.DisplayedAiProbabilityMarketDerived
                                : runner.AiProbabilityMarketDerived;
                                string? aiProb = null;
                                string? aiProbTitle = null;
                                if (displayAiProbability.HasValue)
                                {
                                    aiProb = FormatProbabilityPercent(displayAiProbability.Value, CultureInfo.CurrentCulture);
                                    aiProbTitle = BuildProbabilityTooltip(displayAiProbability.Value, CultureInfo.CurrentCulture);
                                }
                                else if (runner.AiDecimalOdds.HasValue && runner.AiDecimalOdds.Value > 0)
                                {
                                    var derivedProbability = 1.0 / (double)runner.AiDecimalOdds.Value;
                                    aiProb = FormatProbabilityPercent(derivedProbability, CultureInfo.CurrentCulture);
                                    aiProbTitle = BuildProbabilityTooltip(derivedProbability, CultureInfo.CurrentCulture);
                                }
                                string? aiOdds = null;
                                if (displayAiFromMarket)
                                {
                                    if (runner.MarketDecimalOdds.HasValue)
                                    {
                                        aiOdds = runner.MarketDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture);
                                    }
                                }
                                else if (runner.AiDecimalOdds.HasValue)
                                {
                                    aiOdds = runner.AiDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture);
                                    if (runner.AiProbabilityClampedToMarket)
                                    {
                                        aiOdds += "!";
                                    }
                                }
                                var aiWinPrimary = "-";
                                string? aiWinSecondary = null;

                                var aiWinTitle = aiProbTitle;

                                if (!string.IsNullOrEmpty(aiProb))
                                {
                                    aiWinPrimary = aiProb;
                                    if (!string.IsNullOrEmpty(aiOdds))
                                    {
                                        aiWinSecondary = aiOdds;
                                    }
                                }
                                else if (!string.IsNullOrEmpty(aiOdds))
                                {
                                    aiWinPrimary = aiOdds;
                                }
                                var marketProb = runner.MarketProbability.HasValue
                                    ? (runner.MarketProbability.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                    : "-";

                                var aiProbabilityAttrValue = runner.DisplayedAiProbability ?? runner.AiProbability;
                                var effectiveAiProbability = aiProbabilityAttrValue;
                                double? displayedDifferential = runner.DisplayedDifferential;
                                if (!displayedDifferential.HasValue && effectiveAiProbability.HasValue && runner.MarketProbability.HasValue)
                                {
                                    displayedDifferential = effectiveAiProbability.Value - runner.MarketProbability.Value;
                                }
                                if (!displayedDifferential.HasValue && runner.Differential.HasValue)
                                {
                                    displayedDifferential = runner.Differential.Value;
                                }
                                var diff = displayedDifferential.HasValue
                                ? (displayedDifferential.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                    : "-";

                               var hasBackEdge = runner.KellyFraction.HasValue && runner.KellyFraction.Value > 0;
                                var hasLayEdge = runner.LayKellyFraction.HasValue && runner.LayKellyFraction.Value > 0;
                                var rowClass = hasBackEdge
                                    ? "runner-edge-back"
                                    : hasLayEdge
                                        ? "runner-edge-lay"
                                        : string.Empty;

                                var horseNameAttr = runner.HorseName?.Trim() ?? string.Empty;
                                var aiProbabilityAttr = aiProbabilityAttrValue.HasValue
                                ? aiProbabilityAttrValue.Value.ToString("0.################", CultureInfo.InvariantCulture)
                                    : string.Empty;
                                var marketProbabilityAttr = runner.MarketProbability.HasValue
                                    ? runner.MarketProbability.Value.ToString("0.################", CultureInfo.InvariantCulture)
                                    : string.Empty;

                                var displayedKelly = hasBackEdge
                                    ? (runner.KellyFraction!.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                    : hasLayEdge
                                        ? "Lay " + (runner.LayKellyFraction!.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                        : "-";
                                var kellyData = hasBackEdge
                                    ? runner.KellyFraction!.Value.ToString("0.######", CultureInfo.InvariantCulture)
                                    : hasLayEdge
                                        ? runner.LayKellyFraction!.Value.ToString("0.######", CultureInfo.InvariantCulture)
                                        : string.Empty;

                                var useLayRecommendation = !hasBackEdge && hasLayEdge;
                                var displayedStakeValue = useLayRecommendation ? runner.LaySuggestedStake : runner.SuggestedStake;
                                var stakeType = useLayRecommendation ? "lay" : hasBackEdge ? "back" : "none";
                                var layOddsData = useLayRecommendation && runner.LayDecimalOdds.HasValue
                                    ? runner.LayDecimalOdds.Value.ToString("0.########", CultureInfo.InvariantCulture)
                                    : string.Empty;

                                var displayedStake = displayedStakeValue.HasValue && displayedStakeValue.Value > 0
                                    ? (useLayRecommendation
                                        ? "Lay " + displayedStakeValue.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                        : displayedStakeValue.Value.ToString("0.00", CultureInfo.CurrentCulture))
                                    : "-";
                                var stakeData = displayedStakeValue.HasValue && displayedStakeValue.Value > 0
                                ? displayedStakeValue.Value.ToString("0.00", CultureInfo.InvariantCulture)
                                : string.Empty;
                                <tr class="@rowClass"
                                    data-horse-name="@horseNameAttr"
                                    data-ai-probability="@aiProbabilityAttr"
                                    data-market-probability="@marketProbabilityAttr">
                                    <td>@cloth</td>
                                    <td>@draw</td>
                                    <td>
                                        <div class="fw-semibold">@runner.HorseName</div>
                                        @{
                                            var featurePopulation = runner.FeaturePopulation;
                                            var hasPopulationData = featurePopulation != null && featurePopulation.HasData;
                                            HashSet<string>? appliedFeatureKeys = null;
                                            if (runner.AiTrainedModelApplied && featurePopulation?.PopulatedKeys?.Count > 0)
                                            {
                                                appliedFeatureKeys = new HashSet<string>(featurePopulation.PopulatedKeys, StringComparer.OrdinalIgnoreCase);
                                            }

                                            var featureItems = (runner.FeatureValues?.AsEnumerable() ?? Enumerable.Empty<KeyValuePair<string, object?>>())
                                            .Where(feature => appliedFeatureKeys == null || appliedFeatureKeys.Contains(feature.Key))
                                            .OrderBy(feature => feature.Key, StringComparer.OrdinalIgnoreCase)
                                            .ToList();

                                            var hasFeatureValues = featureItems.Count > 0;
                                            var encodedValues = (runner.EncodedFeatureValues?.AsEnumerable() ?? Enumerable.Empty<EncodedFeatureValue>())
                                            .OrderBy(value => value.Index)
                                            .ToList();
                                            var hasEncodedValues = encodedValues.Count > 0;
                                            var encodedActiveFromValues = hasEncodedValues
                                            ? encodedValues.Count(value => value.Active)
                                            : 0;
                                            var showNormalized = encodedValues.Any(value => value.NormalizedValue.HasValue);
                                            var showWeight = encodedValues.Any(value => value.Weight.HasValue);
                                            var showContribution = encodedValues.Any(value => value.Contribution.HasValue);
                                            var populationEncodedActive = runner.FeaturePopulation?.ActiveEncodedDimensions ?? 0;
                                            var populationEncodedTotal = runner.FeaturePopulation?.TotalEncodedDimensions ?? 0;
                                            var displayEncodedActive = populationEncodedActive > 0
                                            ? populationEncodedActive
                                            : encodedActiveFromValues;
                                            var displayEncodedTotal = populationEncodedTotal > 0
                                            ? populationEncodedTotal
                                            : hasEncodedValues
                                            ? encodedValues.Count
                                            : 0;
                                            if (hasEncodedValues && encodedValues.Count > displayEncodedTotal)
                                            {
                                                displayEncodedTotal = encodedValues.Count;
                                            }
                                            if (displayEncodedActive > displayEncodedTotal)
                                            {
                                                displayEncodedActive = displayEncodedTotal;
                                            }
                                            var displayEncodedInactive = displayEncodedTotal > displayEncodedActive
                                            ? displayEncodedTotal - displayEncodedActive
                                            : 0;
                                        }

                                        @if (hasFeatureValues || hasPopulationData || hasEncodedValues)
                                        {
                                            var summaryLabel = runner.AiTrainedModelApplied ? "Neural features" : "Feature inputs";
                                            if (featurePopulation != null && featurePopulation.HasData)
                                            {
                                                if (runner.AiTrainedModelApplied)
                                                {
                                                    summaryLabel = featurePopulation.MissingCount > 0
                                                    ? $"Neural features ({featurePopulation.PopulatedCount} applied, {featurePopulation.MissingCount} missing)"
                                                    : $"Neural features ({featurePopulation.PopulatedCount} applied)";
                                                }
                                                else
                                                {
                                                    summaryLabel = featurePopulation.MissingCount > 0
                                                    ? $"Feature inputs ({featurePopulation.PopulatedCount} populated, {featurePopulation.MissingCount} missing)"
                                                    : $"Feature inputs ({featurePopulation.PopulatedCount} populated)";
                                                }
                                            }
                                            if (displayEncodedTotal > 0)
                                            {
                                                var encodedSummary = displayEncodedActive == displayEncodedTotal
                                                ? $"{displayEncodedTotal} encoded dimensions active"
                                                : $"{displayEncodedActive} of {displayEncodedTotal} encoded dimensions active";

                                                summaryLabel = string.IsNullOrEmpty(summaryLabel)
                                                ? encodedSummary
                                                : $"{summaryLabel}; {encodedSummary}";
                                            }
                                            <details class="small mt-1">
                                                <summary class="text-muted">@summaryLabel</summary>
                @{
                    var contributionThreshold = 1e-6d;
                    var topContributorItems = showContribution && hasEncodedValues
                    ? encodedValues
                    .Where(value => value.Active && value.Contribution.HasValue && value.Contribution.Value > contributionThreshold)
                    .OrderByDescending(value => value.Contribution!.Value)
                    .Take(3)
                    .ToList()
                    : new List<EncodedFeatureValue>();
                    var suppressedHeadwinds = showContribution && hasEncodedValues
                    ? encodedValues
                    .Where(value => !value.Active && value.Contribution.HasValue && value.Contribution.Value < -contributionThreshold)
                    .OrderBy(value => value.Contribution!.Value)
                    .Take(3)
                    .ToList()
                    : new List<EncodedFeatureValue>();
                }
                @if (topContributorItems.Count > 0 || suppressedHeadwinds.Count > 0)
                {
                                                    <div class="mt-2">
                                                        <div class="small text-muted text-uppercase fw-semibold">Model signal explainer</div>
                                                        @if (topContributorItems.Count > 0)
                                                        {
                                                            <div class="small mt-1">
                                                                <span class="fw-semibold">Top contributing features:</span>
                                                                <ul class="mb-0 ps-3">
                                                                    @foreach (var item in topContributorItems)
                                                                    {
                                                                        var contributionText = item.Contribution!.Value.ToString("+0.######;-0.######", CultureInfo.CurrentCulture);
                                                                        <li>
                                                                            <span class="fw-semibold">@item.Label</span>
                                                                            <span class="text-success">@contributionText</span>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                        @if (suppressedHeadwinds.Count > 0)
                                                        {
                                                            <div class="small mt-2">
                                                                <span class="fw-semibold">Suppressed dimensions reducing confidence:</span>
                                                                <ul class="mb-0 ps-3">
                                                                    @foreach (var item in suppressedHeadwinds)
                                                                    {
                                                                        var contributionText = item.Contribution!.Value.ToString("+0.######;-0.######", CultureInfo.CurrentCulture);
                                                                        <li>
                                                                            <span class="fw-semibold">@item.Label</span>
                                                                            <span class="text-danger">@contributionText</span>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                    </div>
                                                <dl class="row mb-0">
                                                    @if (hasFeatureValues)
                                                    {
                                                        @foreach (var feature in featureItems)
                                                        {
                                                            var valueText = feature.Value switch
                                                            {
                                                                null => "-",
                                                                IFormattable formattable => formattable.ToString(null, CultureInfo.CurrentCulture),
                                                                _ => feature.Value.ToString() ?? string.Empty
                                                            };

                                                            <dt class="col-sm-5">@feature.Key</dt>
                                                            <dd class="col-sm-7">@valueText</dd>
                                                        }
                                                    }

                                                    @if (featurePopulation != null && featurePopulation.MissingCount > 0)
                                                    {
                                                        <dt class="col-sm-5 text-danger">Missing inputs</dt>
                                                        <dd class="col-sm-7 text-danger">
                                                            @string.Join(", ", featurePopulation.MissingKeys)
                                                        </dd>
                                                    }
                                                </dl>
                                                @if (displayEncodedTotal > 0)
                                                {
                                                    <div class="mt-2">
                                                        <div class="text-muted small">
                                                            Encoded dimensions (@displayEncodedActive active, @displayEncodedInactive suppressed / @displayEncodedTotal total)
                                                        </div>
                                                        @if (hasEncodedValues)
                                                        {
                                                            <div class="table-responsive">
                                                                <table class="table table-sm table-borderless align-middle mb-0">
                                                                    <thead class="text-muted text-uppercase small">
                                                                        <tr>
                                                                            <th scope="col">Idx</th>
                                                                            <th scope="col">Label</th>
                                                                            @if (showNormalized)
                                                                            {
                                                                                <th scope="col" class="text-end">Normalized</th>
                                                                            }
                                                                            @if (showWeight)
                                                                            {
                                                                                <th scope="col" class="text-end">Weight</th>
                                                                            }
                                                                            <th scope="col" class="text-end">Value</th>
                                                                                @if (showContribution)
                                                                                {
                                                                                    <th scope="col" class="text-end">Contribution</th>
                                                                                }
                                                                            <th scope="col" class="text-center">State</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var encoded in encodedValues)
                                                                        {
                                                                            var encodedRowClass = encoded.Active ? string.Empty : "text-muted";
                                                                            var encodedValueText = encoded.Value.ToString("0.######", CultureInfo.CurrentCulture);
                                                                            var normalizedText = showNormalized && encoded.NormalizedValue.HasValue
                                                                            ? encoded.NormalizedValue.Value.ToString("0.######", CultureInfo.CurrentCulture)
                                                                            : "-";
                                                                            var weightText = showWeight && encoded.Weight.HasValue
                                                                            ? encoded.Weight.Value.ToString("0.######", CultureInfo.CurrentCulture)
                                                                            : "-";
                                                                            var contributionText = showContribution && encoded.Contribution.HasValue
                                                                            ? encoded.Contribution.Value.ToString("+0.######;-0.######", CultureInfo.CurrentCulture)
                                                                            : "-";
                                                                            <tr class="@encodedRowClass">
                                                                                <td>@encoded.Index</td>
                                                                                <td title="@encoded.FeatureKey">@encoded.Label</td>
                                                                                @if (showNormalized)
                                                                                {
                                                                                    <td class="text-end">@normalizedText</td>
                                                                                }
                                                                                @if (showWeight)
                                                                                {
                                                                                    <td class="text-end">@weightText</td>
                                                                                }
                                                                                <td class="text-end">@encodedValueText</td>
                                                                                @if (showContribution)
                                                                                {
                                                                                    <td class="text-end">@contributionText</td>
                                                                                }
                                                                                <td class="text-center">@(encoded.Active ? "Active" : "Suppressed")</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-muted small">
                                                                Encoded feature values were not captured for this runner, but the trained model tracks @displayEncodedTotal dimensions.
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                
                                        }
                                    </td>
                                    <td>@runner.JockeyName</td>
                                    <td class="text-end">
                                        @if (!string.IsNullOrEmpty(historicalRacesJson))
                                        {
                                            <button type="button"
                                                    class="btn btn-link p-0 historical-races-btn"
                                                    data-runner-name="@(runner.HorseName ?? string.Empty)"
                                                    data-history-count="@(runner.HistoricalRaceCount?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
                                                    data-historical-races='@Html.Raw(historicalRacesJson)'>
                                                @historyCountText
                                            </button>
                                        }
                                        else
                                        {
                                            @historyCountText
                                        }
                                    </td>
                                            <td class="text-end">
                                                @if (!string.IsNullOrEmpty(top3RateTitle))
                                                {
                                                    <span title="@top3RateTitle">@top3RateText</span>
                                                }
                                                else
                                                {
                                                    @top3RateText
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (!string.IsNullOrEmpty(top5RateTitle))
                                                {
                                                    <span title="@top5RateTitle">@top5RateText</span>
                                                }
                                                else
                                                {
                                                    @top5RateText
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (!string.IsNullOrEmpty(volatilityTitle))
                                                {
                                                    <span title="@volatilityTitle">@volatilityText</span>
                                                }
                                                else
                                                {
                                                    @volatilityText
                                                }
                                            </td>
                                    <td class="text-end">@marketOdds</td>
                                    <td class="text-end">@layOdds</td>
                                    <td class="text-end">
                                        @if (!string.IsNullOrEmpty(aiWinTitle))
                                        {
                                            <span title="@aiWinTitle">@aiWinPrimary</span>
                                        }
                                        else
                                        {
                                            @aiWinPrimary
                                        }

                                        @if (!string.IsNullOrEmpty(aiWinSecondary))
                                        {
                                            <div class="text-muted small">@aiWinSecondary</div>
                                        }
                                        @if (runner.AiTrainedModelApplied)
                                        {
                                            <div class="text-success small">Trained neural model applied</div>
                                            if (!string.IsNullOrWhiteSpace(runner.AiProbabilityFallbackReason))
                                            {
                                                <div class="text-muted small">@runner.AiProbabilityFallbackReason</div>
                                            }
                                        }
                                        else if (runner.AiUsedLegacyModel)
                                        {
                                            var fallbackText = string.IsNullOrWhiteSpace(runner.AiProbabilityFallbackReason)
                                            ? "Legacy logistic regression fallback"
                                            : $"Legacy logistic regression fallback: {runner.AiProbabilityFallbackReason}";
                                            <div class="text-warning small">@fallbackText</div>
                                        }
                                        else if (runner.AiProbabilityMarketDerived)
                                        {
                                            var fallbackText = string.IsNullOrWhiteSpace(runner.AiProbabilityFallbackReason)
                                            ? "Market-derived fallback"
                                            : $"Market-derived fallback: {runner.AiProbabilityFallbackReason}";
                                            <div class="text-warning small">@fallbackText</div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(runner.AiProbabilityFallbackReason))
                                        {
                                            <div class="text-muted small">@runner.AiProbabilityFallbackReason</div>
                                        }
                                    </td>
                                    <td class="text-end">@aiOdds</td>
                                    <td class="text-end">@marketProb</td>
                                    <td class="text-end">@diff</td>
                                    <td class="text-end">@displayedKelly</td>
                                    <td class="text-end">
                                        <span class="stake-value"
                                              data-default-stake="@stakeData"
                                              data-kelly-fraction="@kellyData"
                                              data-stake-type="@stakeType"
                                              data-lay-odds="@layOddsData"
                                              data-original-text="@displayedStake">@displayedStake</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
<div class="modal fade" id="historicalRacesModal" tabindex="-1" aria-labelledby="historicalRacesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="historicalRacesModalLabel">Historical races</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="historical-races-summary text-muted small mb-3"></div>
                <div class="historical-races-content">
                    <div class="text-muted">No historical races are available for this runner.</div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        (function () {
            const regionSelect = document.getElementById('dayReportRegionSelect');
            const initialRegionInput = document.getElementById('dayReportInitialRegion');
            const regionButtons = Array.from(document.querySelectorAll('.region-filter-btn'));
            const initialRegionValue = (initialRegionInput?.value ?? '').trim();
            if (regionSelect && initialRegionValue.length > 0) {
                regionSelect.value = initialRegionValue;
            }
            const regionProcessingOrder = ['GB & IRE', 'USA', 'RSA', 'FRA', 'AUS'];
            const delay = (ms) => {
                const value = typeof ms === 'number' ? ms : Number(ms);
                const safeValue = Number.isFinite(value) && value > 0 ? value : 0;
                return new Promise(resolve => setTimeout(resolve, safeValue));
            };

            const setActiveRegionButton = (region) => {
                const normalized = (region ?? '').trim().toLowerCase();
                regionButtons.forEach(button => {
                    const buttonRegion = (button.dataset.region ?? '').trim().toLowerCase();
                    const shouldActivate = normalized.length > 0 && normalized !== 'all' && buttonRegion === normalized;
                    button.classList.toggle('active', shouldActivate);
                });
            };

            const filterRacesByRegion = (region) => {
                const normalized = (region ?? '').trim().toLowerCase();
                const raceCards = document.querySelectorAll('.race-card');
                raceCards.forEach(card => {
                    const cardRegion = (card.dataset.region ?? '').trim().toLowerCase();
                    const shouldShow = normalized.length === 0 || normalized === 'all' || cardRegion === normalized;
                    if (shouldShow) {
                        card.classList.remove('d-none');
                    } else {
                        card.classList.add('d-none');
                    }
                });
            };

            const openVisibleRaceDetails = () => {
                const raceCards = document.querySelectorAll('.race-card');
                raceCards.forEach(card => {
                    if (card.classList.contains('d-none')) {
                        return;
                    }

                    const autoOpenDetails = card.querySelectorAll('details[data-auto-open="true"]');
                    autoOpenDetails.forEach(details => {
                        if (!details.open) {
                            details.open = true;
                        }
                    });

                    const autoOpenSummaries = card.querySelectorAll('summary[data-auto-open="true"]');
                    autoOpenSummaries.forEach(summary => {
                        const container = summary.closest('details');
                        if (container && !container.open) {
                            summary.click();
                        }
                    });

                    const toggleElements = card.querySelectorAll('[aria-expanded="false"], button[data-bs-toggle="collapse"].collapsed, button[data-toggle="collapse"].collapsed');
                    toggleElements.forEach(toggle => {
                        if (toggle instanceof HTMLElement && !toggle.disabled) {
                            toggle.click();
                        }
                    });
                });
            };

            const activateRegion = (region) => {
                const normalized = (region ?? '').trim();
                if (normalized.length === 0) {
                    filterRacesByRegion('GB & IRE');
                    setActiveRegionButton('GB & IRE');
                    if (regionSelect && regionSelect.value !== 'GB & IRE') {
                        regionSelect.value = 'GB & IRE';
                    }
                    openVisibleRaceDetails();
                    return;
                }

                const lowered = normalized.toLowerCase();
                if (lowered === 'all') {
                    filterRacesByRegion('All');
                    setActiveRegionButton('');
                    if (regionSelect && regionSelect.value !== 'All') {
                        regionSelect.value = 'All';
                    }
                    openVisibleRaceDetails();
                    return;
                }

                filterRacesByRegion(normalized);
                setActiveRegionButton(normalized);
                if (regionSelect && regionSelect.value !== normalized) {
                    regionSelect.value = normalized;
                }
                openVisibleRaceDetails();
            };

            const processAllRegionsSequentially = async () => {
                for (const region of regionProcessingOrder) {
                    activateRegion(region);
                    await delay(300);
                }

                filterRacesByRegion('All');
                setActiveRegionButton('');
                openVisibleRaceDetails();
                if (regionSelect) {
                    regionSelect.value = 'All';
                }
            };

            regionButtons.forEach(button => {
                button.addEventListener('click', event => {
                    event.preventDefault();
                    const region = (button.dataset.region ?? '').trim();
                    if (!region) {
                        return;
                    }

                    activateRegion(region);
                });
            });

            if (regionSelect) {
                regionSelect.addEventListener('change', async event => {
                    const value = (event.target?.value ?? '').trim();
                    if (!value) {
                        activateRegion('GB & IRE');
                        return;
                    }

                    if (value === 'All') {
                        await processAllRegionsSequentially();
                        return;
                    }

                    if (value !== 'GB & IRE') {
                        const match = regionButtons.find(button => (button.dataset.region ?? '').trim().toLowerCase() === value.toLowerCase());
                        if (match) {
                            match.focus();
                            match.click();
                            return;
                        }
                    }

                    activateRegion(value);
                });
            }

            if (regionButtons.length > 0) {
                const normalizedInitial = initialRegionValue.length > 0 ? initialRegionValue : 'GB & IRE';
                if (normalizedInitial.toLowerCase() === 'all') {
                    processAllRegionsSequentially();
                } else {
                    activateRegion(normalizedInitial || 'GB & IRE');
                }
            }
            const saveButton = document.getElementById('saveReportButton');
            if (saveButton) {
                saveButton.addEventListener('click', function () {
                    const fullHtml = '<!DOCTYPE html>' + document.documentElement.outerHTML;
                    const blob = new Blob([fullHtml], { type: 'text/html' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    const ts = new Date().toISOString().replace(/[:.]/g, '-');

                    a.href = url;
                    a.download = `day-report-${ts}.html`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);

                    setTimeout(() => URL.revokeObjectURL(url), 1000);
                });
            }

            const removePastRacesButton = document.getElementById('removePastRacesButton');
            const parseDateFromAttribute = (value) => {
                if (!value) {
                    return null;
                }

                const parsed = new Date(value);
                if (Number.isNaN(parsed.getTime())) {
                    return null;
                }

                return parsed;
            };

            if (removePastRacesButton) {
                removePastRacesButton.addEventListener('click', () => {
                    const now = new Date();
                    const raceCards = document.querySelectorAll('.race-card');
                    raceCards.forEach(card => {
                        const raw = card.dataset.raceStart ?? '';
                        const start = parseDateFromAttribute(raw);
                        if (!start) {
                            return;
                        }

                        if (start < now) {
                            card.remove();
                        }
                    });
                });
            }

            const refreshEndpoint = '@Url.Action("RefreshRaceMarketOdds")';
            const refreshMarketEndpoint = '@Url.Action("RefreshRaceMarketOddsMarketOnly")';
            const formatProbabilityPercent = (value) => {
                if (typeof value !== 'number' || !isFinite(value) || value < 0) {
                    return '-';
                }

                const percent = value * 100;
                if (percent >= 0.01) {
                    return percent.toLocaleString(undefined, { maximumFractionDigits: 2 }) + '%';
                }

                if (percent >= 0.0001) {
                    return percent.toLocaleString(undefined, { maximumFractionDigits: 4 }) + '%';
                }

                if (percent > 0) {
                    return '<0.0001%';
                }

                return '0%';
            };

            const buildProbabilityTooltip = (value) => {
                if (typeof value !== 'number' || !isFinite(value) || value < 0) {
                    return null;
                }

                return value.toLocaleString(undefined, {
                    style: 'percent',
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 6
                });
            };

            const formatDate = (value) => {
                if (!value) {
                    return null;
                }

                const parsed = new Date(value);
                if (Number.isNaN(parsed.getTime())) {
                    return value;
                }

                const year = parsed.getFullYear();
                const month = String(parsed.getMonth() + 1).padStart(2, '0');
                const day = String(parsed.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            };

            const formatTime = (value) => {
                if (!value) {
                    return null;
                }

                if (typeof value === 'string' && /^\d{1,2}:\d{2}(:\d{2})?$/.test(value)) {
                    return value.slice(0, 5);
                }

                if (typeof value === 'number' && Number.isFinite(value)) {
                    const hours = Math.floor(value / 60);
                    const minutes = Math.round(value % 60);
                    return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
                }

                return null;
            };

            const formatPercentage = (value) => {
                if (typeof value !== 'number' || !isFinite(value)) {
                    return null;
                }

                return value.toLocaleString(undefined, { maximumFractionDigits: 2 }) + '%';
            };

            const formatDecimal = (value, fractionDigits = 2) => {
                if (typeof value !== 'number' || !isFinite(value)) {
                    return '-';
                }

                return value.toLocaleString(undefined, {
                    minimumFractionDigits: fractionDigits,
                    maximumFractionDigits: fractionDigits
                });
            };

            const formatKellyPercent = (fraction) => {
                if (typeof fraction !== 'number' || !isFinite(fraction) || fraction <= 0) {
                    return null;
                }

                return (fraction * 100).toLocaleString(undefined, { maximumFractionDigits: 2 }) + '%';
            };

            const formatStakeAmount = (value) => {
                if (typeof value !== 'number' || !isFinite(value) || value <= 0) {
                    return null;
                }

                return formatDecimal(value);
            };

            const formatStakeDisplay = (value, stakeType) => {
                const formatted = formatStakeAmount(value);
                if (!formatted) {
                    return null;
                }

                return stakeType === 'lay' ? `Lay ${formatted}` : formatted;
            };
            const historicalRacesModalElement = document.getElementById('historicalRacesModal');
            const historicalRacesModalLabel = document.getElementById('historicalRacesModalLabel');
            const historicalRacesSummary = historicalRacesModalElement
                ? historicalRacesModalElement.querySelector('.historical-races-summary')
                : null;
            const historicalRacesContent = historicalRacesModalElement
                ? historicalRacesModalElement.querySelector('.historical-races-content')
                : null;

            const parseHistoricalRaceList = (raw) => {
                if (!raw) {
                    return [];
                }

                if (Array.isArray(raw)) {
                    return raw;
                }

                if (typeof raw === 'string') {
                    const trimmed = raw.trim();
                    if (trimmed.length === 0) {
                        return [];
                    }

                    try {
                        const parsed = JSON.parse(trimmed);
                        return Array.isArray(parsed) ? parsed : [];
                    } catch (error) {
                        console.warn('Unable to parse historical races payload', error);
                        return [];
                    }
                }

                return [];
            };

            const buildHistoricalRacesTable = (races) => {
                const table = document.createElement('table');
                table.className = 'table table-sm table-striped mb-0';

                const thead = document.createElement('thead');
                const headRow = document.createElement('tr');
                [
                    { text: 'Date' },
                    { text: 'Race' },
                    { text: 'Pos', className: 'text-end' },
                    { text: 'Outcome' },
                    { text: 'Runners', className: 'text-end' }
                ].forEach(header => {
                    const th = document.createElement('th');
                    th.scope = 'col';
                    th.textContent = header.text;
                    if (header.className) {
                        th.className = header.className;
                    }
                    headRow.appendChild(th);
                });
                thead.appendChild(headRow);
                table.appendChild(thead);

                const tbody = document.createElement('tbody');
                const sorted = Array.isArray(races) ? races.slice() : [];
                sorted.sort((a, b) => {
                    const dateA = Date.parse(a?.raceDate ?? '');
                    const dateB = Date.parse(b?.raceDate ?? '');
                    const safeA = Number.isNaN(dateA) ? 0 : dateA;
                    const safeB = Number.isNaN(dateB) ? 0 : dateB;
                    return safeB - safeA;
                });

                sorted.forEach(race => {
                    const row = document.createElement('tr');

                    const dateCell = document.createElement('td');
                    dateCell.textContent = formatDate(race?.raceDate) ?? '-';
                    row.appendChild(dateCell);

                    const titleCell = document.createElement('td');
                    titleCell.textContent = race?.raceTitle ?? '';
                    row.appendChild(titleCell);

                    const positionCell = document.createElement('td');
                    positionCell.className = 'text-end';
                    const finishRaw = race?.finishPosition;
                    const finishNumber = typeof finishRaw === 'number'
                        ? finishRaw
                        : Number.parseInt(finishRaw, 10);
                    if (Number.isFinite(finishNumber)) {
                        positionCell.textContent = finishNumber.toLocaleString(undefined, { maximumFractionDigits: 0 });
                    } else if (typeof finishRaw === 'string' && finishRaw.trim().length > 0) {
                        positionCell.textContent = finishRaw.trim();
                    } else {
                        positionCell.textContent = '-';
                    }
                    row.appendChild(positionCell);

                    const outcomeCell = document.createElement('td');
                    outcomeCell.textContent = race?.outcomeCode ?? '';
                    row.appendChild(outcomeCell);

                    const runnerCountCell = document.createElement('td');
                    runnerCountCell.className = 'text-end';
                    const runnersRaw = race?.runnerCount;
                    const runnersNumber = typeof runnersRaw === 'number'
                        ? runnersRaw
                        : Number.parseInt(runnersRaw, 10);
                    if (Number.isFinite(runnersNumber)) {
                        runnerCountCell.textContent = runnersNumber.toLocaleString(undefined, { maximumFractionDigits: 0 });
                    } else if (typeof runnersRaw === 'string' && runnersRaw.trim().length > 0) {
                        runnerCountCell.textContent = runnersRaw.trim();
                    } else {
                        runnerCountCell.textContent = '-';
                    }
                    row.appendChild(runnerCountCell);

                    tbody.appendChild(row);
                });

                table.appendChild(tbody);
                return table;
            };

            const showHistoricalRacesModal = (runnerName, historyCount, races) => {
                if (!historicalRacesModalElement || !historicalRacesContent) {
                    return;
                }

                const displayName = (runnerName ?? '').trim().length > 0
                    ? runnerName.trim()
                    : 'Runner';

                if (historicalRacesModalLabel) {
                    historicalRacesModalLabel.textContent = `${displayName} — Historical races`;
                }

                if (historicalRacesSummary) {
                    const available = Array.isArray(races) ? races.length : 0;
                    if (Number.isFinite(historyCount) && historyCount > 0) {
                        historicalRacesSummary.textContent = `Showing ${available.toLocaleString()} recent race(s) of ${historyCount.toLocaleString()} recorded.`;
                    } else {
                        historicalRacesSummary.textContent = `Showing ${available.toLocaleString()} recent race(s).`;
                    }
                }

                historicalRacesContent.innerHTML = '';

                if (!Array.isArray(races) || races.length === 0) {
                    const empty = document.createElement('div');
                    empty.className = 'text-muted';
                    empty.textContent = 'No historical races are available for this runner.';
                    historicalRacesContent.appendChild(empty);
                } else {
                    const table = buildHistoricalRacesTable(races);
                    historicalRacesContent.appendChild(table);
                }

                if (typeof bootstrap !== 'undefined' && bootstrap?.Modal) {
                    const modalInstance = bootstrap.Modal.getOrCreateInstance(historicalRacesModalElement);
                    modalInstance.show();
                } else {
                    const fallbackLines = Array.isArray(races) && races.length > 0
                        ? races.map(race => {
                            const dateText = formatDate(race?.raceDate) ?? '-';
                            const titleText = race?.raceTitle ?? '';
                            const finishRaw = race?.finishPosition;
                            const finishNumber = typeof finishRaw === 'number'
                                ? finishRaw
                                : Number.parseInt(finishRaw, 10);
                            const finishText = Number.isFinite(finishNumber)
                                ? finishNumber.toString()
                                : (typeof finishRaw === 'string' && finishRaw.trim().length > 0
                                    ? finishRaw.trim()
                                    : '-');
                            return `${dateText} — ${titleText} (${finishText})`;
                        }).join('\n')
                        : 'No historical races are available for this runner.';
                    alert(`${displayName} — Historical races\n\n${fallbackLines}`);
                }
            };

            const handleHistoricalRacesClick = (event) => {
                event.preventDefault();
                const button = event.currentTarget;
                if (!button) {
                    return;
                }

                const runnerName = button.dataset.runnerName ?? '';
                const historyCountRaw = button.dataset.historyCount ?? '';
                const parsedCount = Number.parseInt(historyCountRaw, 10);
                const historyCount = Number.isFinite(parsedCount) && parsedCount >= 0 ? parsedCount : null;
                const races = parseHistoricalRaceList(button.dataset.historicalRaces ?? '[]');

                showHistoricalRacesModal(runnerName, historyCount, races);
            };

            const bindHistoricalRaceButtons = (root = document) => {
                if (!root || typeof root.querySelectorAll !== 'function') {
                    return;
                }

                const buttons = root.querySelectorAll('.historical-races-btn');
                if (!buttons || buttons.length === 0) {
                    return;
                }

                buttons.forEach(button => {
                    if (!button || button.dataset.historicalBound === '1') {
                        return;
                    }

                    button.dataset.historicalBound = '1';
                    button.addEventListener('click', handleHistoricalRacesClick);
                });
            };
            const parseTimeToMinutes = (value) => {
                if (value === null || typeof value === 'undefined') {
                    return null;
                }

                if (value instanceof Date) {
                    return value.getHours() * 60 + value.getMinutes() + value.getSeconds() / 60;
                }

                if (typeof value === 'number' && Number.isFinite(value)) {
                    return value;
                }

                if (typeof value === 'string') {
                    const trimmed = value.trim();
                    if (trimmed.length === 0) {
                        return null;
                    }

                    const match = trimmed.match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?$/);
                    if (match) {
                        const hours = Number.parseInt(match[1], 10);
                        const minutes = Number.parseInt(match[2], 10);
                        const seconds = match[3] ? Number.parseInt(match[3], 10) : 0;
                        return hours * 60 + minutes + seconds / 60;
                    }

                    const isoMatch = trimmed.match(/^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/i);
                    if (isoMatch) {
                        const hours = isoMatch[1] ? Number.parseInt(isoMatch[1], 10) : 0;
                        const minutes = isoMatch[2] ? Number.parseInt(isoMatch[2], 10) : 0;
                        const seconds = isoMatch[3] ? Number.parseInt(isoMatch[3], 10) : 0;
                        return hours * 60 + minutes + seconds / 60;
                    }
                }

                if (typeof value === 'object') {
                    const hours = Number.parseFloat(value.hours ?? value.Hours);
                    const minutes = Number.parseFloat(value.minutes ?? value.Minutes);
                    const seconds = Number.parseFloat(value.seconds ?? value.Seconds);
                    if ([hours, minutes, seconds].some(v => Number.isFinite(v))) {
                        return (Number.isFinite(hours) ? hours : 0) * 60
                            + (Number.isFinite(minutes) ? minutes : 0)
                            + (Number.isFinite(seconds) ? seconds : 0) / 60;
                    }
                }

                return null;
            };

            const parseRaceDate = (value) => {
                if (!value) {
                    return null;
                }

                if (value instanceof Date) {
                    return new Date(value.getTime());
                }

                if (typeof value === 'string') {
                    const trimmed = value.trim();
                    if (trimmed.length === 0) {
                        return null;
                    }

                    const parsed = new Date(trimmed);
                    if (!Number.isNaN(parsed.getTime())) {
                        return parsed;
                    }

                    if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) {
                        const [year, month, day] = trimmed.split('-').map(part => Number.parseInt(part, 10));
                        return new Date(year, month - 1, day);
                    }
                }

                return null;
            };

            const resolveRaceStart = (race) => {
                const date = parseRaceDate(race?.raceDate);
                if (!date) {
                    return null;
                }

                const minutes = parseTimeToMinutes(race?.offTime);
                if (minutes !== null) {
                    const start = new Date(date.getTime());
                    start.setHours(0, 0, 0, 0);
                    start.setMinutes(start.getMinutes() + minutes);
                    return start;
                }

                return date;
            };

            const updateCardRaceStart = (card, race) => {
                if (!card) {
                    return;
                }

                const start = resolveRaceStart(race);
                if (start) {
                    card.dataset.raceStart = start.toISOString();
                } else {
                    card.dataset.raceStart = '';
                }
            };

            const resolveBettingRecommendation = (runner) => {
                const hasBack = typeof runner?.kellyFraction === 'number' && runner.kellyFraction > 0;
                if (hasBack) {
                    const stakeValue = typeof runner?.suggestedStake === 'number' && runner.suggestedStake > 0
                        ? runner.suggestedStake
                        : NaN;
                    const kellyPercent = formatKellyPercent(runner.kellyFraction);
                    return {
                        type: 'back',
                        rowClass: 'runner-edge-back',
                        kellyText: kellyPercent ?? '-',
                        kellyData: runner.kellyFraction.toFixed(6),
                        stakeText: formatStakeDisplay(stakeValue, 'back') ?? '-',
                        stakeData: Number.isFinite(stakeValue) && stakeValue > 0 ? stakeValue.toFixed(2) : '',
                        layOddsData: ''
                    };
                }

                const hasLay = typeof runner?.layKellyFraction === 'number' && runner.layKellyFraction > 0;
                if (hasLay) {
                    const stakeValue = typeof runner?.laySuggestedStake === 'number' && runner.laySuggestedStake > 0
                        ? runner.laySuggestedStake
                        : NaN;
                    const layOdds = typeof runner?.layDecimalOdds === 'number' && runner.layDecimalOdds > 1
                        ? runner.layDecimalOdds
                        : NaN;
                    const kellyPercent = formatKellyPercent(runner.layKellyFraction);
                    const kellyText = kellyPercent ? `Lay ${kellyPercent}` : 'Lay -';
                    return {
                        type: 'lay',
                        rowClass: 'runner-edge-lay',
                        kellyText,
                        kellyData: runner.layKellyFraction.toFixed(6),
                        stakeText: formatStakeDisplay(stakeValue, 'lay') ?? '-',
                        stakeData: Number.isFinite(stakeValue) && stakeValue > 0 ? stakeValue.toFixed(2) : '',
                        layOddsData: Number.isFinite(layOdds) ? layOdds.toString() : ''
                    };
                }

                return {
                    type: 'none',
                    rowClass: '',
                    kellyText: '-',
                    kellyData: '',
                    stakeText: '-',
                    stakeData: '',
                    layOddsData: ''
                };
            };

            let customKellyBankroll = null;
            let customStakeAmount = null;
            let stakeDampener = 1;

            const updateStakeDisplays = () => {
                const stakeElements = document.querySelectorAll('.stake-value');
                stakeElements.forEach(element => {
                    const stakeTypeRaw = element.dataset.stakeType ?? '';
                    const stakeType = stakeTypeRaw === 'lay' ? 'lay' : stakeTypeRaw === 'none' ? 'none' : 'back';
                    const defaultStakeRaw = element.dataset.defaultStake ?? '';
                    const kellyFraction = Number.parseFloat(element.dataset.kellyFraction ?? '');
                    const layOdds = Number.parseFloat(element.dataset.layOdds ?? '');
                    const originalText = element.dataset.originalText ?? '';

                    let stake = NaN;

                    if (customStakeAmount !== null && stakeType !== 'none') {
                        stake = customStakeAmount;
                    } else if (customKellyBankroll !== null && stakeType !== 'none') {
                        if (Number.isFinite(kellyFraction) && kellyFraction > 0) {
                            if (stakeType === 'lay') {
                                if (Number.isFinite(layOdds) && layOdds > 1) {
                                    const liability = customKellyBankroll * kellyFraction;
                                    stake = liability / (layOdds - 1);
                                }
                            } else {
                                stake = customKellyBankroll * kellyFraction;
                            }
                        }
                    } else if (defaultStakeRaw) {
                        const parsedDefault = Number.parseFloat(defaultStakeRaw);
                        if (Number.isFinite(parsedDefault) && parsedDefault > 0) {
                            stake = parsedDefault;
                        }
                    }

                    if (Number.isFinite(stake) && stake > 0) {
                        let adjustedStake = stake;
                        if (Number.isFinite(stakeDampener) && stakeDampener > 0) {
                            adjustedStake = adjustedStake / stakeDampener;
                        }

                        if (adjustedStake > 0) {
                            const formatted = formatStakeDisplay(adjustedStake, stakeType);
                            if (formatted) {
                                element.textContent = formatted;
                                return;
                            }
                        }
                    }

                    element.textContent = originalText && originalText.trim().length > 0 ? originalText : '-';
                });
            };

            const setCustomKellyBankroll = (value) => {
                if (Number.isFinite(value) && value > 0) {
                    customKellyBankroll = value;
                } else {
                    customKellyBankroll = null;
                }

                updateStakeDisplays();
            };

            const setCustomStakeAmount = (value) => {
                if (Number.isFinite(value) && value > 0) {
                    customStakeAmount = value;
                } else {
                    customStakeAmount = null;
                }

                updateStakeDisplays();
            };

            const setStakeDampener = (value) => {
                if (Number.isFinite(value) && value > 0) {
                    stakeDampener = value;
                } else {
                    stakeDampener = 1;
                }

                updateStakeDisplays();
            };

            const bankrollInput = document.getElementById('kellyBankrollInput');
            const applyReportBankrollButton = document.getElementById('kellyBankrollUseReport');
            const resetBankrollButton = document.getElementById('kellyBankrollReset');

            const handleBankrollInput = () => {
                if (!bankrollInput) {
                    return;
                }

                const raw = bankrollInput.value.trim();
                if (raw.length === 0) {
                    bankrollInput.classList.remove('is-invalid');
                    setCustomKellyBankroll(null);
                    return;
                }

                const parsed = Number.parseFloat(raw);
                if (!Number.isFinite(parsed) || parsed <= 0) {
                    bankrollInput.classList.add('is-invalid');
                    setCustomKellyBankroll(null);
                    return;
                }

                bankrollInput.classList.remove('is-invalid');
                setCustomKellyBankroll(parsed);
            };

            if (bankrollInput) {
                bankrollInput.addEventListener('input', handleBankrollInput);
                bankrollInput.addEventListener('change', handleBankrollInput);
            }

            if (applyReportBankrollButton && bankrollInput) {
                applyReportBankrollButton.addEventListener('click', () => {
                    const defaultValue = bankrollInput.dataset.reportBankroll ?? '';
                    if (defaultValue.length === 0) {
                        return;
                    }

                    bankrollInput.value = defaultValue;
                    bankrollInput.dispatchEvent(new Event('input', { bubbles: true }));
                    bankrollInput.focus();
                    bankrollInput.select();
                });
            }

            if (resetBankrollButton && bankrollInput) {
                resetBankrollButton.addEventListener('click', () => {
                    bankrollInput.value = '';
                    bankrollInput.classList.remove('is-invalid');
                    setCustomKellyBankroll(null);
                    bankrollInput.focus();
                });
            }

            const stakeAmountInput = document.getElementById('stakeAmountInput');
            const stakeAmountReset = document.getElementById('stakeAmountReset');

            const handleStakeAmountInput = () => {
                if (!stakeAmountInput) {
                    return;
                }

                const raw = stakeAmountInput.value.trim();
                if (raw.length === 0) {
                    stakeAmountInput.classList.remove('is-invalid');
                    setCustomStakeAmount(null);
                    return;
                }

                const parsed = Number.parseFloat(raw);
                if (!Number.isFinite(parsed) || parsed <= 0) {
                    stakeAmountInput.classList.add('is-invalid');
                    setCustomStakeAmount(null);
                    return;
                }

                stakeAmountInput.classList.remove('is-invalid');
                setCustomStakeAmount(parsed);
            };

            if (stakeAmountInput) {
                stakeAmountInput.addEventListener('input', handleStakeAmountInput);
                stakeAmountInput.addEventListener('change', handleStakeAmountInput);
            }

            if (stakeAmountReset && stakeAmountInput) {
                stakeAmountReset.addEventListener('click', () => {
                    stakeAmountInput.value = '';
                    stakeAmountInput.classList.remove('is-invalid');
                    setCustomStakeAmount(null);
                    stakeAmountInput.focus();
                });
            }

            const stakeDampenerInput = document.getElementById('stakeDampenerInput');
            const stakeDampenerReset = document.getElementById('stakeDampenerReset');

            const handleStakeDampenerInput = () => {
                if (!stakeDampenerInput) {
                    return;
                }

                const raw = stakeDampenerInput.value.trim();
                if (raw.length === 0) {
                    stakeDampenerInput.classList.remove('is-invalid');
                    setStakeDampener(1);
                    return;
                }

                const parsed = Number.parseFloat(raw);
                if (!Number.isFinite(parsed) || parsed <= 0) {
                    stakeDampenerInput.classList.add('is-invalid');
                    return;
                }

                stakeDampenerInput.classList.remove('is-invalid');
                setStakeDampener(parsed);
            };

            if (stakeDampenerInput) {
                stakeDampenerInput.addEventListener('input', handleStakeDampenerInput);
                stakeDampenerInput.addEventListener('change', handleStakeDampenerInput);
