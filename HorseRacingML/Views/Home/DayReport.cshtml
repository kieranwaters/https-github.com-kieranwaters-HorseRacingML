                const historyCountRaw = button.dataset.historyCount ?? '';
                const parsedCount = Number.parseInt(historyCountRaw, 10);
                const historyCount = Number.isFinite(parsedCount) && parsedCount >= 0 ? parsedCount : null;
                const races = parseHistoricalRaceList(button.dataset.historicalRaces ?? '[]');

                showHistoricalRacesModal(runnerName, historyCount, races);
            };

            const bindHistoricalRaceButtons = (root = document) => {
                if (!root || typeof root.querySelectorAll !== 'function') {
                    return;
                }

                const buttons = root.querySelectorAll('.historical-races-btn');
                if (!buttons || buttons.length === 0) {
                    return;
                }

                buttons.forEach(button => {
                    if (!button) {
                        return;
                    }

                    if (button[HISTORICAL_BUTTON_HANDLER_FLAG]) {
                        return;
                    }

                    button[HISTORICAL_BUTTON_HANDLER_FLAG] = true;
                    button.dataset.historicalBound = '1';
                    button.addEventListener('click', handleHistoricalRacesClick);
                });
            };
            const parseTimeToMinutes = (value) => {
                if (value === null || typeof value === 'undefined') {
                    return null;
                }

                if (value instanceof Date) {
                    return value.getHours() * 60 + value.getMinutes() + value.getSeconds() / 60;
                }

                if (typeof value === 'number' && Number.isFinite(value)) {
                    return value;
                }

                if (typeof value === 'string') {
                    const trimmed = value.trim();
                    if (trimmed.length === 0) {
                        return null;
                    }

                    const match = trimmed.match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?$/);
                    if (match) {
                        const hours = Number.parseInt(match[1], 10);
                        const minutes = Number.parseInt(match[2], 10);
                        const seconds = match[3] ? Number.parseInt(match[3], 10) : 0;
                        return hours * 60 + minutes + seconds / 60;
                    }

                    const isoMatch = trimmed.match(/^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/i);
                    if (isoMatch) {
                        const hours = isoMatch[1] ? Number.parseInt(isoMatch[1], 10) : 0;
                        const minutes = isoMatch[2] ? Number.parseInt(isoMatch[2], 10) : 0;
                        const seconds = isoMatch[3] ? Number.parseInt(isoMatch[3], 10) : 0;
                        return hours * 60 + minutes + seconds / 60;
                    }
                }

                if (typeof value === 'object') {
                    const hours = Number.parseFloat(value.hours ?? value.Hours);
                    const minutes = Number.parseFloat(value.minutes ?? value.Minutes);
                    const seconds = Number.parseFloat(value.seconds ?? value.Seconds);
                    if ([hours, minutes, seconds].some(v => Number.isFinite(v))) {
                        return (Number.isFinite(hours) ? hours : 0) * 60
                            + (Number.isFinite(minutes) ? minutes : 0)
                            + (Number.isFinite(seconds) ? seconds : 0) / 60;
                    }
                }

                return null;
            };

            const parseRaceDate = (value) => {
                if (!value) {
                    return null;
                }

                if (value instanceof Date) {
                    return new Date(value.getTime());
                }

                if (typeof value === 'string') {
                    const trimmed = value.trim();
                    if (trimmed.length === 0) {
                        return null;
                    }

                    const parsed = new Date(trimmed);
                    if (!Number.isNaN(parsed.getTime())) {
                        return parsed;
                    }

                    if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) {
                        const [year, month, day] = trimmed.split('-').map(part => Number.parseInt(part, 10));
                        return new Date(year, month - 1, day);
                    }
                }

                return null;
            };

            const resolveRaceStart = (race) => {
                const date = parseRaceDate(race?.raceDate);
                if (!date) {
                    return null;
                }

                const minutes = parseTimeToMinutes(race?.offTime);
                if (minutes !== null) {
                    const start = new Date(date.getTime());
                    start.setHours(0, 0, 0, 0);
                    start.setMinutes(start.getMinutes() + minutes);
                    return start;
                }

                return date;
            };

            const updateCardRaceStart = (card, race) => {
                if (!card) {
                    return;
                }

                const start = resolveRaceStart(race);
                if (start) {
                    card.dataset.raceStart = start.toISOString();
                } else {
                    card.dataset.raceStart = '';
                }
            };

            const resolveBettingRecommendation = (runner) => {
                const hasBack = typeof runner?.kellyFraction === 'number' && runner.kellyFraction > 0;
                if (hasBack) {
                    const stakeValue = typeof runner?.suggestedStake === 'number' && runner.suggestedStake > 0
                        ? runner.suggestedStake
                        : NaN;
                    const kellyPercent = formatKellyPercent(runner.kellyFraction);
                    return {
                        type: 'back',
                        rowClass: 'runner-edge-back',
                        kellyText: kellyPercent ?? '-',
                        kellyData: runner.kellyFraction.toFixed(6),
                        stakeText: formatStakeDisplay(stakeValue, 'back') ?? '-',
                        stakeData: Number.isFinite(stakeValue) && stakeValue > 0 ? stakeValue.toFixed(2) : '',
                        layOddsData: ''
                    };
                }

                const hasLay = typeof runner?.layKellyFraction === 'number' && runner.layKellyFraction > 0;
                if (hasLay) {
                    const stakeValue = typeof runner?.laySuggestedStake === 'number' && runner.laySuggestedStake > 0
                        ? runner.laySuggestedStake
                        : NaN;
                    const layOdds = typeof runner?.layDecimalOdds === 'number' && runner.layDecimalOdds > 1
                        ? runner.layDecimalOdds
                        : NaN;
                    const kellyPercent = formatKellyPercent(runner.layKellyFraction);
                    const kellyText = kellyPercent ? `Lay ${kellyPercent}` : 'Lay -';
                    return {
                        type: 'lay',
                        rowClass: 'runner-edge-lay',
                        kellyText,
                        kellyData: runner.layKellyFraction.toFixed(6),
                        stakeText: formatStakeDisplay(stakeValue, 'lay') ?? '-',
                        stakeData: Number.isFinite(stakeValue) && stakeValue > 0 ? stakeValue.toFixed(2) : '',
                        layOddsData: Number.isFinite(layOdds) ? layOdds.toString() : ''
                    };
                }

                return {
                    type: 'none',
                    rowClass: '',
                    kellyText: '-',
                    kellyData: '',
                    stakeText: '-',
                    stakeData: '',
                    layOddsData: ''
                };
            };
            const clampProbability = (value) => {
                if (typeof value !== 'number' || !Number.isFinite(value)) {
                    return 0;
                }

                if (value < 0) {
                    return 0;
                }

                if (value > 1) {
                    return 1;
                }

                return value;
            };

            const parseProbabilityAttribute = (value) => {
                if (typeof value === 'number' && Number.isFinite(value) && value > 0) {
                    return clampProbability(value);
                }

                if (typeof value === 'string') {
                    const parsed = Number.parseFloat(value);
                    if (Number.isFinite(parsed) && parsed > 0) {
                        return clampProbability(parsed);
                    }
                }

                return 0;
            };
            const parseOddsInputValue = (raw) => {
                if (typeof raw !== 'string') {
                    return NaN;
                }

                const trimmed = raw.trim();
                if (trimmed.length === 0) {
                    return NaN;
                }

                const sanitized = trimmed.replace(/[^0-9.,]/g, '');
                if (sanitized.length === 0) {
                    return NaN;
                }

                const lastComma = sanitized.lastIndexOf(',');
                const lastDot = sanitized.lastIndexOf('.');
                const decimalIndex = Math.max(lastComma, lastDot);

                if (decimalIndex === -1) {
                    const integerPart = sanitized.replace(/[^0-9]/g, '');
                    if (integerPart.length === 0) {
                        return NaN;
                    }

                    const parsed = Number.parseFloat(integerPart);
                    return Number.isFinite(parsed) ? parsed : NaN;
                }

                const integerPart = sanitized.slice(0, decimalIndex).replace(/[^0-9]/g, '');
                const fractionalPart = sanitized.slice(decimalIndex + 1).replace(/[^0-9]/g, '');
                if (integerPart.length === 0 && fractionalPart.length === 0) {
                    return NaN;
                }

                const normalized = `${integerPart.length > 0 ? integerPart : '0'}.${fractionalPart}`;
                const parsed = Number.parseFloat(normalized);
                return Number.isFinite(parsed) ? parsed : NaN;
            };

            const updateMarketOddsFromInput = (input, options = {}) => {
