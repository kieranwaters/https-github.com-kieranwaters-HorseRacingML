                    });
                });
            }

            const refreshEndpoint = '@Url.Action("RefreshRaceMarketOdds")';
            const refreshMarketEndpoint = '@Url.Action("RefreshRaceMarketOddsMarketOnly")';
            const formatProbabilityPercent = (value) => {
                if (typeof value !== 'number' || !isFinite(value) || value < 0) {
                    return '-';
                }

                const percent = value * 100;
                if (percent >= 0.01) {
                    return percent.toLocaleString(undefined, { maximumFractionDigits: 2 }) + '%';
                }

                if (percent >= 0.0001) {
                    return percent.toLocaleString(undefined, { maximumFractionDigits: 4 }) + '%';
                }

                if (percent > 0) {
                    return '<0.0001%';
                }

                return '0%';
            };

            const buildProbabilityTooltip = (value) => {
                if (typeof value !== 'number' || !isFinite(value) || value < 0) {
                    return null;
                }

                return value.toLocaleString(undefined, {
                    style: 'percent',
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 6
                });
            };

            const formatDate = (value) => {
                if (!value) {
                    return null;
                }

                const parsed = new Date(value);
                if (Number.isNaN(parsed.getTime())) {
                    return value;
                }

                const year = parsed.getFullYear();
                const month = String(parsed.getMonth() + 1).padStart(2, '0');
                const day = String(parsed.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            };

            const formatTime = (value) => {
                if (!value) {
                    return null;
                }

                if (typeof value === 'string' && /^\d{1,2}:\d{2}(:\d{2})?$/.test(value)) {
                    return value.slice(0, 5);
                }

                if (typeof value === 'number' && Number.isFinite(value)) {
                    const hours = Math.floor(value / 60);
                    const minutes = Math.round(value % 60);
                    return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
                }

                return null;
            };

            const formatPercentage = (value) => {
                if (typeof value !== 'number' || !isFinite(value)) {
                    return null;
                }

                return value.toLocaleString(undefined, { maximumFractionDigits: 2 }) + '%';
            };
            const resolveFeatureMetric = (features, key) => {
                if (!features || typeof features !== 'object' || !key) {
                    return null;
                }

                const raw = features[key];
                if (typeof raw === 'number' && isFinite(raw)) {
                    return raw;
                }

                if (typeof raw === 'string' || typeof raw === 'bigint') {
                    const parsed = Number(raw);
                    return Number.isFinite(parsed) ? parsed : null;
                }

                if (raw !== null && typeof raw !== 'undefined') {
                    const parsed = Number(raw);
                    return Number.isFinite(parsed) ? parsed : null;
                }

                return null;
            };

            const formatWinRatePercent = (value) => {
                if (typeof value !== 'number' || !isFinite(value) || value < 0) {
                    return null;
                }

                const percent = value * 100;
                const options = percent >= 1
                    ? { minimumFractionDigits: 1, maximumFractionDigits: 2 }
                    : { maximumFractionDigits: 2 };
                return percent.toLocaleString(undefined, options) + '%';
            };
            const toFiniteNumber = (value) => {
                if (typeof value === 'number' && Number.isFinite(value)) {
                    return value;
                }

                if (typeof value === 'string') {
                    const parsed = Number.parseFloat(value);
                    return Number.isFinite(parsed) ? parsed : null;
                }

                return null;
            };

            const formatFinishRateMetric = (value, description) => {
                const numeric = toFiniteNumber(value);
                if (numeric === null || !Number.isFinite(numeric) || numeric < 0) {
                    return { text: '-', title: null };
                }

                const percent = numeric * 100;
                const text = formatPercentage(percent);
                if (!text) {
                    return { text: '-', title: null };
                }

                const title = description
                    ? `${percent.toLocaleString(undefined, { maximumFractionDigits: 3 })}% ${description}`
                    : null;

                return { text, title };
            };

            const formatVolatilityMetric = (value) => {
                const numeric = toFiniteNumber(value);
                if (numeric === null || !Number.isFinite(numeric) || numeric < 0) {
                    return { text: '-', title: null };
                }

                const percent = numeric * 100;
                const text = formatPercentage(percent);
                if (!text) {
                    return { text: '-', title: null };
                }

                return {
                    text,
                    title: 'Standard deviation of normalized finishing positions across historical runs'
                };
            };

            const setMetricCellContent = (cell, text, title) => {
                if (!cell) {
                    return;
                }

                cell.innerHTML = '';
                const displayText = (typeof text === 'string' && text.length > 0) ? text : '-';
                if (title) {
                    const span = document.createElement('span');
                    span.textContent = displayText;
                    span.title = title;
                    cell.appendChild(span);
                } else {
                    cell.textContent = displayText;
                }
            };
            const formatDecimal = (value, fractionDigits = 2) => {
                if (typeof value !== 'number' || !isFinite(value)) {
                    return '-';
                }

                return value.toLocaleString(undefined, {
                    minimumFractionDigits: fractionDigits,
                    maximumFractionDigits: fractionDigits
                });
            };

            const formatKellyPercent = (fraction) => {
                if (typeof fraction !== 'number' || !isFinite(fraction) || fraction <= 0) {
                    return null;
                }

                return (fraction * 100).toLocaleString(undefined, { maximumFractionDigits: 2 }) + '%';
            };

            const formatStakeAmount = (value) => {
                if (typeof value !== 'number' || !isFinite(value) || value <= 0) {
                    return null;
