﻿
@model HorseRacingML.Models.DayReportViewModel
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using HorseRacingML.ML
@using HorseRacingML.Models
@{
    ViewData["Title"] = "Day Report";
    var generatedLocal = Model.GeneratedAt.ToLocalTime();
    var bankrollText = Model.Bankroll > 0
        ? Model.Bankroll.ToString("C", CultureInfo.CurrentCulture)
        : Model.Bankroll.ToString("0.00", CultureInfo.CurrentCulture);

    string FormatProbabilityPercent(double value, CultureInfo culture)
    {
        if (!double.IsFinite(value) || value < 0)
        {
            return "-";
        }

        var percent = value * 100d;

        if (percent >= 0.01d)
        {
            return percent.ToString("0.##", culture) + "%";
        }

        if (percent >= 0.0001d)
        {
            return percent.ToString("0.####", culture) + "%";
        }

        if (percent > 0d)
        {
            return "<0.0001%";
        }

        return "0%";
    }

    string? BuildProbabilityTooltip(double value, CultureInfo culture)
    {
        if (!double.IsFinite(value) || value < 0)
        {
            return null;
        }

        return value.ToString("P6", culture);
    }

    string BuildHyperparameterSummary(HyperparameterSummary summary, CultureInfo culture)
    {
        var segments = new List<string>
        {
            $"Layers: {summary.Layers}",
            $"Units: {summary.Units}",
            $"Dropout: {summary.Dropout.ToString("0.###", culture)}",
            $"Learning rate: {summary.LearningRate.ToString("0.#####", culture)}",
            $"Epochs: {summary.Epochs}",
            $"Batch size: {summary.BatchSize}",
            $"Folds: {summary.Folds}"
        };

        if (summary.Fold.HasValue)
        {
            segments.Add($"Fold: {summary.Fold.Value}");
        }

        return string.Join(" | ", segments);
    }

    string? BuildHyperparameterTimestamp(HyperparameterSummary summary, CultureInfo culture)
    {
        if (!summary.TrainedAtUtc.HasValue)
        {
            return null;
        }

        var utc = summary.TrainedAtUtc.Value;
        if (utc.Kind == DateTimeKind.Unspecified)
        {
            utc = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        }

        var local = utc.Kind == DateTimeKind.Utc ? utc.ToLocalTime() : utc;
        return local.ToString("f", culture);
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Day Report</h1>
        <p class="text-muted mb-0">
            Generated @generatedLocal.ToString("f", CultureInfo.CurrentCulture)
            <span class="ms-2">Bankroll: @bankrollText</span>
        </p>
        @if (Model.AiHyperparameters != null)
        {
            var summaryText = BuildHyperparameterSummary(Model.AiHyperparameters, CultureInfo.CurrentCulture);
            var trainedText = BuildHyperparameterTimestamp(Model.AiHyperparameters, CultureInfo.CurrentCulture);
            <div class="text-muted small mt-1">
                <span>AI hyperparameters: @summaryText</span>
                @if (!string.IsNullOrEmpty(trainedText))
                {
                    <span class="ms-2">Trained @trainedText</span>
                }
            </div>
        }
    </div>
    <button type="button" id="saveReportButton" class="btn btn-outline-primary">Save Report</button>
</div>
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-4 col-lg-3">
                <label for="kellyBankrollInput" class="form-label mb-1">Kelly bankroll override</label>
                <input type="number"
                       class="form-control form-control-sm"
                       id="kellyBankrollInput"
                       placeholder="Enter bankroll"
                       step="0.01"
                       min="0"
                       inputmode="decimal"
                       data-report-bankroll="@Model.Bankroll.ToString("0.##", CultureInfo.InvariantCulture)" />
                <div class="form-text">Kelly stakes update immediately when this override is set.</div>
                <div class="invalid-feedback">Enter a positive bankroll to apply the override.</div>
            </div>
            <div class="col-auto d-flex flex-wrap gap-2">
                <button type="button" id="kellyBankrollUseReport" class="btn btn-outline-secondary btn-sm">
                    Use report bankroll (@bankrollText)
                </button>
                <button type="button" id="kellyBankrollReset" class="btn btn-outline-secondary btn-sm">
                    Clear override
                </button>
            </div>
        </div>
    </div>
</div>

@if (Model.Races == null || Model.Races.Count == 0)
{
    <div class="alert alert-info">No race data was captured while scanning the open markets.</div>
}
else
{
    for (var raceIndex = 0; raceIndex < Model.Races.Count; raceIndex++)
    {
        var race = Model.Races[raceIndex];
        var raceTitle = string.IsNullOrWhiteSpace(race.RaceTitle)
            ? "Unknown Race"
            : race.RaceTitle;

        var venueParts = new[] { race.VenueName, race.VenueCountry }
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();

        var scheduleParts = new List<string>();
        if (race.RaceDate.HasValue)
        {
            scheduleParts.Add(race.RaceDate.Value.ToString("yyyy-MM-dd", CultureInfo.CurrentCulture));
        }

        if (race.OffTime.HasValue)
        {
            scheduleParts.Add(race.OffTime.Value.ToString(@"hh\:mm", CultureInfo.CurrentCulture));
        }

        var bookParts = new List<string>();
        if (race.BackBookPercentage.HasValue)
        {
            bookParts.Add($"Back {race.BackBookPercentage.Value.ToString("0.##", CultureInfo.CurrentCulture)}%");
        }

        if (race.LayBookPercentage.HasValue)
        {
            bookParts.Add($"Lay {race.LayBookPercentage.Value.ToString("0.##", CultureInfo.CurrentCulture)}%");
        }

        var orderedRunners = (race.Runners ?? new List<RunnerDayReport>())
            .OrderBy(r => r.ClothNumber ?? byte.MaxValue)
            .ThenBy(r => r.HorseName ?? string.Empty)
            .ToList();

        <div class="card mb-4" data-market-id="@race.MarketId">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2 class="h5 mb-1 mb-sm-0">@raceTitle</h2>
                        <div class="small text-muted">
                            @if (venueParts.Count > 0)
                            {
                                <span>@string.Join(" - ", venueParts)</span>
                            }

                            @if (scheduleParts.Count > 0)
                            {
                                <span class="ms-2">@string.Join(" ", scheduleParts)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(race.RaceType))
                            {
                                <span class="ms-2">Type: @race.RaceType</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(race.RaceDetails))
                            {
                                <span class="ms-2">@race.RaceDetails</span>
                            }

                            @if (bookParts.Count > 0)
                            {
                                <span class="ms-2">Book: @string.Join(" / ", bookParts)</span>
                            }
                        </div>
                    </div>
                    <div class="text-end">
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary refresh-race-btn"
                            data-market-id="@race.MarketId"
                            data-race-url="@race.RaceUrl"
                            @(string.IsNullOrWhiteSpace(race.RaceUrl) ? "disabled" : string.Empty)>
                            Refresh market odds
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Draw</th>
                                <th scope="col">Horse</th>
                                <th scope="col">Jockey</th>
                                <th scope="col" class="text-end">Hist. Races</th>
                                <th scope="col" class="text-end">Market Odds</th>
                                <th scope="col" class="text-end">Lay Odds</th>
                                <th scope="col" class="text-end">AI Win %</th>
                                <th scope="col" class="text-end">AI Odds</th>
                                <th scope="col" class="text-end">Market Win %</th>
                                <th scope="col" class="text-end">Edge</th>
                                <th scope="col" class="text-end">Kelly %</th>
                                <th scope="col" class="text-end">Stake</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var runner in orderedRunners)
                            {
                                var cloth = runner.ClothNumber.HasValue
                                    ? runner.ClothNumber.Value.ToString(CultureInfo.CurrentCulture)
                                    : "-";

                                var draw = runner.Draw.HasValue
                                    ? runner.Draw.Value.ToString(CultureInfo.CurrentCulture)
                                    : "-";
                                var historyCount = runner.HistoricalRaceCount.HasValue
                                    ? runner.HistoricalRaceCount.Value.ToString("N0", CultureInfo.CurrentCulture)
                                    : "-";


                                var marketOdds = runner.MarketDecimalOdds.HasValue
                                    ? runner.MarketDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                    : "-";
                                var layOdds = runner.LayDecimalOdds.HasValue
                                    ? runner.LayDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                    : "-";

                                string aiProb;
                                string? aiProbTitle = null;
                                if (runner.AiProbability.HasValue)
                                {
                                    aiProb = FormatProbabilityPercent(runner.AiProbability.Value, CultureInfo.CurrentCulture);
                                    aiProbTitle = BuildProbabilityTooltip(runner.AiProbability.Value, CultureInfo.CurrentCulture);
                                }
                                else
                                {
                                    aiProb = "-";
                                }

                                var aiOdds = runner.AiDecimalOdds.HasValue
                                    ? runner.AiDecimalOdds.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                    : "-";

                                var marketProb = runner.MarketProbability.HasValue
                                    ? (runner.MarketProbability.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                    : "-";

                                var diff = runner.Differential.HasValue
                                    ? (runner.Differential.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                    : "-";

                               var hasBackEdge = runner.KellyFraction.HasValue && runner.KellyFraction.Value > 0;
                                var hasLayEdge = runner.LayKellyFraction.HasValue && runner.LayKellyFraction.Value > 0;
                                var rowClass = hasBackEdge
                                    ? "runner-edge-back"
                                    : hasLayEdge
                                        ? "runner-edge-lay"
                                        : string.Empty;

                                var displayedKelly = hasBackEdge
                                    ? (runner.KellyFraction!.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                    : hasLayEdge
                                        ? "Lay " + (runner.LayKellyFraction!.Value * 100).ToString("0.##", CultureInfo.CurrentCulture) + "%"
                                        : "-";
                                var kellyData = hasBackEdge
                                    ? runner.KellyFraction!.Value.ToString("0.######", CultureInfo.InvariantCulture)
                                    : hasLayEdge
                                        ? runner.LayKellyFraction!.Value.ToString("0.######", CultureInfo.InvariantCulture)
                                        : string.Empty;

                                var useLayRecommendation = !hasBackEdge && hasLayEdge;
                                var displayedStakeValue = useLayRecommendation ? runner.LaySuggestedStake : runner.SuggestedStake;
                                var stakeType = useLayRecommendation ? "lay" : hasBackEdge ? "back" : "none";
                                var layOddsData = useLayRecommendation && runner.LayDecimalOdds.HasValue
                                    ? runner.LayDecimalOdds.Value.ToString("0.########", CultureInfo.InvariantCulture)
                                    : string.Empty;

                                var displayedStake = displayedStakeValue.HasValue && displayedStakeValue.Value > 0
                                    ? (useLayRecommendation
                                        ? "Lay " + displayedStakeValue.Value.ToString("0.00", CultureInfo.CurrentCulture)
                                        : displayedStakeValue.Value.ToString("0.00", CultureInfo.CurrentCulture))
                                    : "-";
                                var stakeData = displayedStakeValue.HasValue && displayedStakeValue.Value > 0
                                    ? displayedStakeValue.Value.ToString("0.00", CultureInfo.InvariantCulture)
                                    : string.Empty;
                                <tr class="@rowClass">
                                    <td>@cloth</td>
                                    <td>@draw</td>
                                    <td>
                                        <div class="fw-semibold">@runner.HorseName</div>
                                        @if (!string.IsNullOrWhiteSpace(runner.SelectionId))
                                        {
                                            <div class="text-muted small">Selection ID: @runner.SelectionId</div>
                                        }

                                        @if (runner.FeatureValues != null && runner.FeatureValues.Count > 0)
                                        {
                                            <details class="small mt-1">
                                                <summary class="text-muted">Feature inputs</summary>
                                                <dl class="row mb-0">
                                                    @foreach (var feature in runner.FeatureValues.OrderBy(f => f.Key))
                                                    {
                                                        var valueText = feature.Value switch
                                                        {
                                                            null => "-",
                                                            IFormattable formattable => formattable.ToString(null, CultureInfo.CurrentCulture),
                                                            _ => feature.Value.ToString() ?? string.Empty
                                                        };

                                                        <dt class="col-sm-5">@feature.Key</dt>
                                                        <dd class="col-sm-7">@valueText</dd>
                                                    }
                                                </dl>
                                            </details>
                                        }
                                    </td>
                                    <td>@runner.JockeyName</td>
                                     <td class="text-end">@historyCount</td>
                                    <td class="text-end">@marketOdds</td>
                                    <td class="text-end">@layOdds</td>
                                    <td class="text-end">
                                        @if (runner.AiProbability.HasValue)
                                        {
                                            <span title="@aiProbTitle">@aiProb</span>
                                        }
                                        else
                                        {
                                            @aiProb
                                        }
                                        @if (runner.AiProbabilityMarketDerived)
                                        {
                                            <div class="text-warning small">Market-derived fallback</div>
                                        }
                                    </td>
                                    <td class="text-end">@aiOdds</td>
                                    <td class="text-end">@marketProb</td>
                                    <td class="text-end">@diff</td>
                                   <td class="text-end">@displayedKelly</td>
                                    <td class="text-end">
                                        <span class="stake-value" data-default-stake="@stakeData" data-kelly-fraction="@kellyData" data-stake-type="@stakeType" data-lay-odds="@layOddsData">@displayedStake</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        (function () {
            const saveButton = document.getElementById('saveReportButton');
            if (saveButton) {
                saveButton.addEventListener('click', function () {
                    const fullHtml = '<!DOCTYPE html>' + document.documentElement.outerHTML;
                    const blob = new Blob([fullHtml], { type: 'text/html' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    const ts = new Date().toISOString().replace(/[:.]/g, '-');

                    a.href = url;
                    a.download = `day-report-${ts}.html`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);

                    setTimeout(() => URL.revokeObjectURL(url), 1000);
                });
            }

            const refreshButtons = document.querySelectorAll('.refresh-race-btn');
            if (refreshButtons.length > 0) {
                const refreshEndpoint = '@Url.Action("RefreshRaceOdds")';
 const formatProbabilityPercent = (value) => {
                    if (typeof value !== 'number' || !isFinite(value) || value < 0) {
                        return '-';
                    }

                    const percent = value * 100;
                    if (percent >= 0.01) {
                        return percent.toLocaleString(undefined, { maximumFractionDigits: 2 }) + '%';
                    }

                    if (percent >= 0.0001) {
                        return percent.toLocaleString(undefined, { maximumFractionDigits: 4 }) + '%';
                    }

                    if (percent > 0) {
                        return '<0.0001%';
                    }

                    return '0%';
                };

                const buildProbabilityTooltip = (value) => {
                    if (typeof value !== 'number' || !isFinite(value) || value < 0) {
                        return null;
                    }

                    return (value).toLocaleString(undefined, {
                        style: 'percent',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 6
                    });
                };

                const formatDate = (value) => {
                    if (!value) {
                        return null;
                    }

                    const parsed = new Date(value);
                    if (Number.isNaN(parsed.getTime())) {
                        return value;
                    }

                    const year = parsed.getFullYear();
                    const month = String(parsed.getMonth() + 1).padStart(2, '0');
                    const day = String(parsed.getDate()).padStart(2, '0');
                    return `${year}-${month}-${day}`;
                };

                const formatTime = (value) => {
                    if (!value) {
                        return null;
                    }

                    if (typeof value === 'string' && /^\d{1,2}:\d{2}(:\d{2})?$/.test(value)) {
                        return value.slice(0, 5);
                    }

                    if (typeof value === 'number' && Number.isFinite(value)) {
                        // assume minutes
                        const hours = Math.floor(value / 60);
                        const minutes = Math.round(value % 60);
                        return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
                    }

                    return null;
                };

                const formatPercentage = (value) => {
                    if (typeof value !== 'number' || !isFinite(value)) {
                        return null;
                    }

                    return value.toLocaleString(undefined, { maximumFractionDigits: 2 }) + '%';
                };

                const formatDecimal = (value, fractionDigits = 2) => {
                    if (typeof value !== 'number' || !isFinite(value)) {
                        return '-';
                    }

                    return value.toLocaleString(undefined, {
                        minimumFractionDigits: fractionDigits,
                        maximumFractionDigits: fractionDigits
                    });
                };

               const formatKellyPercent = (fraction) => {
                    if (typeof fraction !== 'number' || !isFinite(fraction) || fraction <= 0) {
                        return null;
                    }

                    return (fraction * 100).toLocaleString(undefined, { maximumFractionDigits: 2 }) + '%';
                };

                const formatStakeAmount = (value) => {
                    if (typeof value !== 'number' || !isFinite(value) || value <= 0) {
                        return null;
                    }

                    return formatDecimal(value);
                };

                const formatStakeDisplay = (value, stakeType) => {
                    const formatted = formatStakeAmount(value);
                    if (!formatted) {
                        return null;
                    }

                    return stakeType === 'lay' ? `Lay ${formatted}` : formatted;
                };

                const resolveBettingRecommendation = (runner) => {
                    const hasBack = typeof runner?.kellyFraction === 'number' && runner.kellyFraction > 0;
                    if (hasBack) {
                        const stakeValue = typeof runner?.suggestedStake === 'number' && runner.suggestedStake > 0
                            ? runner.suggestedStake
                            : NaN;
                        const kellyPercent = formatKellyPercent(runner.kellyFraction);
                        return {
                            type: 'back',
                            rowClass: 'runner-edge-back',
                            kellyText: kellyPercent ?? '-',
                            kellyData: runner.kellyFraction.toFixed(6),
                            stakeText: formatStakeDisplay(stakeValue, 'back') ?? '-',
                            stakeData: Number.isFinite(stakeValue) && stakeValue > 0 ? stakeValue.toFixed(2) : '',
                            layOddsData: ''
                        };
                    }

                    const hasLay = typeof runner?.layKellyFraction === 'number' && runner.layKellyFraction > 0;
                    if (hasLay) {
                        const stakeValue = typeof runner?.laySuggestedStake === 'number' && runner.laySuggestedStake > 0
                            ? runner.laySuggestedStake
                            : NaN;
                        const layOdds = typeof runner?.layDecimalOdds === 'number' && runner.layDecimalOdds > 1
                            ? runner.layDecimalOdds
                            : NaN;
                        const kellyPercent = formatKellyPercent(runner.layKellyFraction);
                        const kellyText = kellyPercent ? `Lay ${kellyPercent}` : 'Lay -';
                        return {
                            type: 'lay',
                            rowClass: 'runner-edge-lay',
                            kellyText,
                            kellyData: runner.layKellyFraction.toFixed(6),
                            stakeText: formatStakeDisplay(stakeValue, 'lay') ?? '-',
                            stakeData: Number.isFinite(stakeValue) && stakeValue > 0 ? stakeValue.toFixed(2) : '',
                            layOddsData: Number.isFinite(layOdds) ? layOdds.toString() : ''
                        };
                    }

                    return {
                        type: 'none',
                        rowClass: '',
                        kellyText: '-',
                        kellyData: '',
                        stakeText: '-',
                        stakeData: '',
                        layOddsData: ''
                    };
                };
                let customKellyBankroll = null;


                const updateStakeDisplays = () => {
                    const stakeElements = document.querySelectorAll('.stake-value');
                    stakeElements.forEach(element => {
                        const defaultStakeRaw = element.dataset.defaultStake ?? '';
                        const kellyFractionRaw = element.dataset.kellyFraction ?? '';
                        const stakeTypeRaw = element.dataset.stakeType ?? '';
                        const stakeType = stakeTypeRaw === 'lay' ? 'lay' : stakeTypeRaw === 'none' ? 'none' : 'back';
                        if (customKellyBankroll !== null) {
                            const fraction = Number.parseFloat(kellyFractionRaw);
                            if (Number.isFinite(fraction) && fraction > 0) {
                                let computedStake = customKellyBankroll * fraction;
                                if (stakeType === 'lay') {
                                    const layOdds = Number.parseFloat(element.dataset.layOdds ?? '');
                                    if (!Number.isFinite(layOdds) || layOdds <= 1) {
                                        computedStake = NaN;
                                    } else {
                                        const liability = customKellyBankroll * fraction;
                                        computedStake = liability / (layOdds - 1);
                                    }
                                }

                                const formattedDefault = formatStakeDisplay(defaultStake, stakeType);
                                if (formattedComputed) {
                                    element.textContent = formattedComputed;
                                    return;
                                }
                            }
                        }

                        if (defaultStakeRaw) {
                            const defaultStake = Number.parseFloat(defaultStakeRaw);
                            const formattedDefault = formatStakeAmount(defaultStake);
                            if (formattedDefault) {
                                element.textContent = formattedDefault;
                                return;
                            }
                        }

                        element.textContent = '-';
                    });
                };

                const setCustomKellyBankroll = (value) => {
                    if (Number.isFinite(value) && value > 0) {
                        customKellyBankroll = value;
                    } else {
                        customKellyBankroll = null;
                    }

                    updateStakeDisplays();
                };

                const bankrollInput = document.getElementById('kellyBankrollInput');
                const applyReportBankrollButton = document.getElementById('kellyBankrollUseReport');
                const resetBankrollButton = document.getElementById('kellyBankrollReset');

                const handleBankrollInput = () => {
                    if (!bankrollInput) {
                        return;
                    }

                    const raw = bankrollInput.value.trim();
                    if (raw.length === 0) {
                        bankrollInput.classList.remove('is-invalid');
                        setCustomKellyBankroll(null);
                        return;
                    }

                    const parsed = Number.parseFloat(raw);
                    if (!Number.isFinite(parsed) || parsed <= 0) {
                        bankrollInput.classList.add('is-invalid');
                        setCustomKellyBankroll(null);
                        return;
                    }

                    bankrollInput.classList.remove('is-invalid');
                    setCustomKellyBankroll(parsed);
                };

                if (bankrollInput) {
                    bankrollInput.addEventListener('input', handleBankrollInput);
                    bankrollInput.addEventListener('change', handleBankrollInput);
                }

                if (applyReportBankrollButton && bankrollInput) {
                    applyReportBankrollButton.addEventListener('click', () => {
                        const defaultValue = bankrollInput.dataset.reportBankroll ?? '';
                        if (defaultValue.length === 0) {
                            return;
                        }

                        bankrollInput.value = defaultValue;
                        bankrollInput.dispatchEvent(new Event('input', { bubbles: true }));
                        bankrollInput.focus();
                        bankrollInput.select();
                    });
                }

                if (resetBankrollButton && bankrollInput) {
                    resetBankrollButton.addEventListener('click', () => {
                        bankrollInput.value = '';
                        bankrollInput.classList.remove('is-invalid');
                        setCustomKellyBankroll(null);
                        bankrollInput.focus();
                    });
                }

                const updateRaceMetadata = (card, race) => {
                    const title = card.querySelector('h2.h5');
                    if (title) {
                        const text = race?.raceTitle && race.raceTitle.trim().length > 0
                            ? race.raceTitle
                            : 'Unknown Race';
                        title.textContent = text;
                    }

                    const infoContainer = card.querySelector('.card-header .small.text-muted');
                    if (infoContainer) {
                        infoContainer.innerHTML = '';

                        const appendSpan = (text, classes = []) => {
                            if (!text) {
                                return;
                            }

                            const span = document.createElement('span');
                            span.textContent = text;
                            classes.forEach(cls => span.classList.add(cls));
                            infoContainer.appendChild(span);
                        };

                        const venueParts = [race?.venueName, race?.venueCountry]
                            .filter(part => typeof part === 'string' && part.trim().length > 0)
                            .map(part => part.trim());
                        if (venueParts.length > 0) {
                            appendSpan(venueParts.join(' - '));
                        }

                        const scheduleParts = [];
                        const formattedDate = formatDate(race?.raceDate);
                        if (formattedDate) {
                            scheduleParts.push(formattedDate);
                        }

                        const formattedTime = formatTime(race?.offTime);
                        if (formattedTime) {
                            scheduleParts.push(formattedTime);
                        }

                        if (scheduleParts.length > 0) {
                            appendSpan(scheduleParts.join(' '), ['ms-2']);
                        }

                        if (race?.raceDetails && race.raceDetails.trim().length > 0) {
                            appendSpan(race.raceDetails.trim(), ['ms-2']);
                        }

                        const bookParts = [];
                        const backText = formatPercentage(race?.backBookPercentage);
                        if (backText) {
                            bookParts.push(`Back ${backText}`);
                        }

                        const layText = formatPercentage(race?.layBookPercentage);
                        if (layText) {
                            bookParts.push(`Lay ${layText}`);
                        }

                        if (bookParts.length > 0) {
                            appendSpan(`Book: ${bookParts.join(' / ')}`, ['ms-2']);
                        }
                    }

                    const refreshButton = card.querySelector('.refresh-race-btn');
                    if (refreshButton) {
                        const url = race?.raceUrl ?? '';
                        refreshButton.dataset.raceUrl = url;
                        refreshButton.disabled = !url;
                    }
                };

                const renderRaceRows = (card, race) => {
                    const tbody = card.querySelector('tbody');
                    if (!tbody) {
                        return;
                    }

                    tbody.innerHTML = '';

                    const runners = Array.isArray(race?.runners) ? [...race.runners] : [];
                    runners.sort((a, b) => {
                        const clothA = Number.isFinite(a?.clothNumber) ? a.clothNumber : Number.MAX_SAFE_INTEGER;
                        const clothB = Number.isFinite(b?.clothNumber) ? b.clothNumber : Number.MAX_SAFE_INTEGER;
                        if (clothA !== clothB) {
                            return clothA - clothB;
                        }

                        const horseA = (a?.horseName ?? '').toString();
                        const horseB = (b?.horseName ?? '').toString();
                        return horseA.localeCompare(horseB);
                    });

                    runners.forEach(runner => {
                        const row = document.createElement('tr');

                        const appendCell = (text, className) => {
                            const cell = document.createElement('td');
                            if (className) {
                                cell.className = className;
                            }
                            cell.textContent = text;
                            row.appendChild(cell);
                            return cell;
                        };

                        appendCell(Number.isFinite(runner?.clothNumber) ? runner.clothNumber.toString() : '-');
                        appendCell(Number.isFinite(runner?.draw) ? runner.draw.toString() : '-');

                        const horseCell = document.createElement('td');
                        const horseName = document.createElement('div');
                        horseName.className = 'fw-semibold';
                        horseName.textContent = runner?.horseName ?? '';
                        horseCell.appendChild(horseName);

                        if (runner?.selectionId) {
                            const selection = document.createElement('div');
                            selection.className = 'text-muted small';
                            selection.textContent = `Selection ID: ${runner.selectionId}`;
                            horseCell.appendChild(selection);
                        }

                        if (runner?.featureValues && typeof runner.featureValues === 'object' && Object.keys(runner.featureValues).length > 0) {
                            const details = document.createElement('details');
                            details.className = 'small mt-1';

                            const summary = document.createElement('summary');
                            summary.className = 'text-muted';
                            summary.textContent = 'Feature inputs';
                            details.appendChild(summary);

                            const dl = document.createElement('dl');
                            dl.className = 'row mb-0';

                            Object.keys(runner.featureValues)
                                .sort((a, b) => a.localeCompare(b))
                                .forEach(key => {
                                    const value = runner.featureValues[key];
                                    const dt = document.createElement('dt');
                                    dt.className = 'col-sm-5';
                                    dt.textContent = key;

                                    const dd = document.createElement('dd');
                                    dd.className = 'col-sm-7';
                                    let valueText;
                                    if (value === null || typeof value === 'undefined') {
                                        valueText = '-';
                                    } else if (typeof value === 'number' && isFinite(value)) {
                                        valueText = value.toLocaleString();
                                    } else {
                                        valueText = value.toString();
                                    }
                                    dd.textContent = valueText;

                                    dl.appendChild(dt);
                                    dl.appendChild(dd);
                                });

                            details.appendChild(dl);
                            horseCell.appendChild(details);
                        }

                        row.appendChild(horseCell);

                        appendCell(runner?.jockeyName ?? '');
                        appendCell(Number.isFinite(runner?.historicalRaceCount)
                            ? runner.historicalRaceCount.toLocaleString(undefined, { maximumFractionDigits: 0 })
                            : '-', 'text-end');

                        appendCell(typeof runner?.marketDecimalOdds === 'number'
                            ? formatDecimal(runner.marketDecimalOdds)
                            : '-', 'text-end');

                        appendCell(typeof runner?.layDecimalOdds === 'number'
                            ? formatDecimal(runner.layDecimalOdds)
                            : '-', 'text-end');

                        const aiProbCell = appendCell('-', 'text-end');
                        if (typeof runner?.aiProbability === 'number') {
                            const display = formatProbabilityPercent(runner.aiProbability);
                            if (display !== '-') {
                                const span = document.createElement('span');
                                span.textContent = display;
                                const tooltip = buildProbabilityTooltip(runner.aiProbability);
                                if (tooltip) {
                                    span.title = tooltip;
                                }
                                aiProbCell.textContent = '';
                                aiProbCell.appendChild(span);
                            } else {
                                aiProbCell.textContent = display;
                            }
                        }

                        appendCell(typeof runner?.aiDecimalOdds === 'number'
                            ? formatDecimal(runner.aiDecimalOdds)
                            : '-', 'text-end');

                        const marketPercent = typeof runner?.marketProbability === 'number'
                            ? formatPercentage(runner.marketProbability * 100)
                            : null;
                        appendCell(marketPercent ?? '-', 'text-end');

                        const diffPercent = typeof runner?.differential === 'number'
                            ? formatPercentage(runner.differential * 100)
                            : null;
                        appendCell(diffPercent ?? '-', 'text-end');

                        const betting = resolveBettingRecommendation(runner);
                        if (betting.rowClass) {
                            row.classList.add(betting.rowClass);
                        }

                        appendCell(betting.kellyText, 'text-end');
                        const stakeCell = document.createElement('td');
                        stakeCell.className = 'text-end';
                        const stakeSpan = document.createElement('span');
                        stakeSpan.className = 'stake-value';
     stakeSpan.dataset.defaultStake = betting.stakeData;
                        stakeSpan.dataset.kellyFraction = betting.kellyData;
                        stakeSpan.dataset.stakeType = betting.type;
                        stakeSpan.dataset.layOdds = betting.layOddsData;
                        stakeSpan.textContent = betting.stakeText;
                        stakeCell.appendChild(stakeSpan);
                        row.appendChild(stakeCell);

                        tbody.appendChild(row);
                    });
                    updateStakeDisplays();
                };

                const updateRaceCard = (marketId, race) => {
                    if (!marketId) {
                        return;
                    }

                    const card = document.querySelector(`.card[data-market-id="${marketId}"]`);
                    if (!card) {
                        return;
                    }

                    if (race?.marketId) {
                        card.dataset.marketId = race.marketId;
                        const refreshButton = card.querySelector('.refresh-race-btn');
                        if (refreshButton) {
                            refreshButton.dataset.marketId = race.marketId;
                        }
                    }

                    updateRaceMetadata(card, race);
                    renderRaceRows(card, race);
                };

                refreshButtons.forEach(button => {
                    button.addEventListener('click', async () => {
                        if (button.disabled) {
                            return;
                        }

                        const raceUrl = button.dataset.raceUrl;
                        const marketId = button.dataset.marketId;

                        if (!raceUrl) {
                            alert('No market URL is available for this race.');
                            return;
                        }

                        const originalHtml = button.innerHTML;
                        button.disabled = true;
                        button.innerText = 'Refreshing…';

                        try {
                            const response = await fetch(refreshEndpoint, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ raceUrl, marketId })
                            });

                            if (!response.ok) {
                                throw new Error(`Request failed with status ${response.status}`);
                            }

                            const payload = await response.json();
                            if (payload?.success && payload?.race) {
                                const market = payload.race.marketId ?? marketId;
                                updateRaceCard(market, payload.race);
                                return;
                            }

                            const message = payload?.message ?? 'Failed to refresh market odds.';
                            alert(message);
                        } catch (error) {
                            console.error('Refresh request failed', error);
                            alert('Unable to refresh the market odds for this race. Please try again.');
                        } finally {
                            button.innerHTML = originalHtml;
                            button.disabled = !button.dataset.raceUrl;
                        }
                    });
                });
            }
            updateStakeDisplays();
        })();
    </script>
}