                        applyMarketProbabilityToRow(targetRow);
                        updateStakeDisplays();
                    });
                });
            };
            let customKellyBankroll = null;
            let customStakeAmount = null;
            let stakeDampener = 1;
            let minEdgeFilter = null;

            const filterRunnersByEdge = () => {
                const raceCards = getActiveRaceCards();
                raceCards.forEach(card => {
                    const rows = Array.from(card.querySelectorAll('tbody tr'));
                    let visibleCount = 0;

                    rows.forEach(row => {
                        if (minEdgeFilter === null) {
                            row.classList.remove('d-none');
                            visibleCount++;
                            return;
                        }

                        const edge = Number.parseFloat(row.dataset.edge ?? '0');
                        const meetsCriteria = (edge * 100) >= (minEdgeFilter - 1e-9);

                        if (meetsCriteria) {
                            row.classList.remove('d-none');
                            visibleCount++;
                        } else {
                            row.classList.add('d-none');
                        }
                    });

                    card.dataset.hasVisibleRunners = visibleCount > 0 ? 'true' : 'false';
                });

                updateAllCardsVisibility();
            };

            const setMinEdgeFilter = (value) => {
                if (value === null) {
                    minEdgeFilter = null;
                } else if (Number.isFinite(value)) {
                    minEdgeFilter = value;
                } else {
                    minEdgeFilter = null;
                }
                filterRunnersByEdge();
            };

            const calculateBackKellyFraction = (probability, decimalOdds) => {
                if (!(typeof probability === 'number' && Number.isFinite(probability) && probability > 0 && probability < 1)) {
                    return 0;
                }

                if (!(typeof decimalOdds === 'number' && Number.isFinite(decimalOdds) && decimalOdds > 1)) {
                    return 0;
                }

                const b = decimalOdds - 1;
                if (!Number.isFinite(b) || Math.abs(b) < Number.EPSILON) {
                    return 0;
                }

                const q = 1 - probability;
                const fraction = (b * probability - q) / b;
                if (!Number.isFinite(fraction)) {
                    return 0;
                }

                if (fraction <= 0) {
                    return 0;
                }

                if (fraction >= 1) {
                    return 1;
                }

                return fraction;
            };

            const calculateLayKellyFractionFromOdds = (probability, layDecimalOdds) => {
                if (!(typeof probability === 'number' && Number.isFinite(probability) && probability > 0 && probability < 1)) {
                    return 0;
                }

                if (!(typeof layDecimalOdds === 'number' && Number.isFinite(layDecimalOdds) && layDecimalOdds > 1)) {
                    return 0;
                }

                const fraction = 1 - (probability * layDecimalOdds);
                if (!Number.isFinite(fraction)) {
                    return 0;
                }

                if (fraction <= 0) {
                    return 0;
                }

                if (fraction >= 1) {
                    return 1;
                }

                return fraction;
            };
            //
           const updateStakeDisplays = () => {
                const stakeElements = document.querySelectorAll('.stake-value');
                const reportBankroll = Number.parseFloat(bankrollInput?.dataset.reportBankroll ?? '');
                stakeElements.forEach(element => {
                    const row = element.closest('tr');
                    if (!row) {
                        return;
                    }
                    const originalStakeType = element.dataset.stakeType ?? 'none';
                    const originalText = element.dataset.originalText ?? '-';
                    const defaultStakeValue = Number.parseFloat(element.dataset.defaultStake ?? '');
                    const originalBackKelly = Number.parseFloat(row.dataset.kelly ?? '');
                    const originalLayKelly = Number.parseFloat(row.dataset.layKelly ?? '');
                    const originalLayOdds = Number.parseFloat(element.dataset.originalLayOdds ?? '');
                    const aiProbability = parseProbabilityAttribute(row.dataset.aiProbability);
                    const marketOdds = Number.parseFloat(row.dataset.marketOdds ?? '');
                    const layOdds = Number.parseFloat(row.dataset.layOdds ?? element.dataset.layOdds ?? '');
                    const kellyCell = row.querySelector('.kelly-cell');
                    const computedBackKelly = calculateBackKellyFraction(aiProbability, marketOdds);
                    const computedLayKelly = calculateLayKellyFractionFromOdds(aiProbability, layOdds);
                    let effectiveStakeType = 'none';
                    let effectiveKellyFraction = 0;
                    if (computedBackKelly > 0) {
                        effectiveStakeType = 'back';
                        effectiveKellyFraction = computedBackKelly;
                    } else if (computedLayKelly > 0) {
                        effectiveStakeType = 'lay';
                        effectiveKellyFraction = computedLayKelly;
                    }
                    let impliedBankroll = NaN;
                    if (originalStakeType === 'lay') {
                        const baseLayOdds = Number.isFinite(originalLayOdds) && originalLayOdds > 1 ?
                            originalLayOdds :
                            (Number.isFinite(layOdds) && layOdds > 1 ? layOdds : NaN);
                        if (Number.isFinite(baseLayOdds) &&
                            baseLayOdds > 1 &&
                            Number.isFinite(originalLayKelly) &&
                            originalLayKelly > 0 &&
                            Number.isFinite(defaultStakeValue) &&
                            defaultStakeValue > 0) {
                            impliedBankroll = (defaultStakeValue * (baseLayOdds - 1)) / originalLayKelly;
                        }
                    } else if (originalStakeType === 'back') {
                        if (Number.isFinite(originalBackKelly) &&
                            originalBackKelly > 0 &&
                            Number.isFinite(defaultStakeValue) &&
                            defaultStakeValue > 0) {
                            impliedBankroll = defaultStakeValue / originalBackKelly;
                        }
                    }
                    let stake = NaN;
                    const bankroll = customKellyBankroll ?? reportBankroll ?? null;
                    if (customStakeAmount !== null && effectiveStakeType !== 'none') {
                        stake = customStakeAmount;
                    } else if (bankroll !== null &&
                        Number.isFinite(bankroll) &&
                        bankroll > 0 &&
                        effectiveKellyFraction > 0) {
                        if (effectiveStakeType === 'lay') {
                            if (Number.isFinite(layOdds) && layOdds > 1) {
                                const liability = bankroll * effectiveKellyFraction;
                                stake = liability / (layOdds - 1);
                            }
                        } else {
                            stake = bankroll * effectiveKellyFraction;
                        }
                    }
                    row.classList.remove('runner-edge-back', 'runner-edge-lay');
                    if (effectiveStakeType === 'back') {
                        row.classList.add('runner-edge-back');
                    } else if (effectiveStakeType === 'lay') {
                        row.classList.add('runner-edge-lay');
                    }
                    if (kellyCell) {
                        const kellyText = formatKellyPercent(effectiveKellyFraction);
                        if (effectiveStakeType === 'lay') {
                            kellyCell.textContent = kellyText ? `Lay ${kellyText}` : 'Lay -';
                        } else {
                            kellyCell.textContent = kellyText ?? '-';
                        }
                    }
                    const edgeCell = row.querySelector('.edge-cell');
                    let currentEdge = 0;
                    if (edgeCell) {
                        let backEdge = -Infinity;
                        if (marketOdds > 1) {
                            backEdge = aiProbability - (1.0 / marketOdds);
                        }

                        let layEdge = -Infinity;
                        if (layOdds > 1) {
                            layEdge = (1.0 / layOdds) - aiProbability;
                        }

                        if (effectiveStakeType === 'back') {
                            currentEdge = backEdge;
                        } else if (effectiveStakeType === 'lay') {
                            currentEdge = layEdge;
                        } else {
                            if (backEdge !== -Infinity && layEdge !== -Infinity) {
                                currentEdge = Math.max(backEdge, layEdge);
                            } else if (backEdge !== -Infinity) {
                                currentEdge = backEdge;
                            } else if (layEdge !== -Infinity) {
                                currentEdge = layEdge;
                            }
                        }

                        edgeCell.textContent = formatPercentage(currentEdge * 100) ?? '-';
                    }
                    row.dataset.edge = currentEdge.toString();

                    const roiCell = row.querySelector('.roi-cell');
                    if (roiCell) {
                        let roiValue = null;
                        if (effectiveStakeType === 'back') {
                             if (Number.isFinite(marketOdds) && marketOdds > 1) {
                                 roiValue = (aiProbability * marketOdds) - 1;
                             }
                        } else if (effectiveStakeType === 'lay') {
                             if (Number.isFinite(layOdds) && layOdds > 1) {
                                 roiValue = (1 - (aiProbability * layOdds)) / (layOdds - 1);
                             }
                        } else {
                             if (Number.isFinite(marketOdds) && marketOdds > 1) {
                                 roiValue = (aiProbability * marketOdds) - 1;
                             } else if (Number.isFinite(layOdds) && layOdds > 1) {
                                 roiValue = (1 - (aiProbability * layOdds)) / (layOdds - 1);
                             }
                        }

                        if (roiValue !== null) {
                            roiCell.textContent = formatPercentage(roiValue * 100) ?? '-';
                        } else {
                            roiCell.textContent = '-';
                        }
                    }
                     let displayedText = '-';

                    // If no active stake but there was original text and NO current recommendation, show original text (or dash)
                    if (effectiveStakeType === 'none') {
                         displayedText = '-';
                    }
                   if (Number.isFinite(stake) && stake > 0) {
                        let adjustedStake = stake;
                        if (Number.isFinite(stakeDampener) && stakeDampener > 0) {
                            adjustedStake /= stakeDampener;
