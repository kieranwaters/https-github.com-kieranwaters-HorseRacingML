            };

            const bindOddsInputs = (root) => {
                bindMarketOddsInputs(root);
                bindLayOddsInputs(root);
            };
            const setRowAiProbability = (row, probability, options = {}) => {
                if (!row) {
                    return;
                }

                const safeProbability = clampProbability(typeof probability === 'number' ? probability : 0);
                const fromMarket = options.fromMarket === true;
