            const APPLY_MARKET_HANDLER_FLAG = '__hrmlApplyMarketHandler';
            const HISTORICAL_BUTTON_HANDLER_FLAG = '__hrmlHistoricalButton';
            const MARKET_REFRESH_HANDLER_FLAG = '__hrmlMarketRefreshHandler';
            const FULL_REFRESH_HANDLER_FLAG = '__hrmlFullRefreshHandler';
            const suppressWebGlContextRequests = () => {
                const CanvasConstructor = window.HTMLCanvasElement;
                if (!CanvasConstructor || !CanvasConstructor.prototype) {
                    return;
                }

                const prototype = CanvasConstructor.prototype;
                if (prototype.__hrmlPatchedWebGlContext) {
                    return;
                }

                const originalGetContext = prototype.getContext;
                if (typeof originalGetContext !== 'function') {
                    return;
                }

                const blockedContexts = new Set(['webgl', 'webgl2', 'experimental-webgl']);

                prototype.getContext = function (type, ...args) {
                    const contextId = typeof type === 'string' ? type.toLowerCase() : type;
                    if (typeof contextId === 'string' && blockedContexts.has(contextId)) {
