                             marketOddsInput.value = formatDecimal(runner.marketDecimalOdds);
                         }
                         marketOddsCell.appendChild(marketOddsInput);
                         row.appendChild(marketOddsCell);

                         const layOddsCell = document.createElement('td');
                         layOddsCell.className = 'text-end lay-odds-cell';
                         const layOddsInput = document.createElement('input');
                         layOddsInput.type = 'text';
                         layOddsInput.className = 'form-control form-control-sm text-end lay-odds-input';
                         layOddsInput.inputMode = 'decimal';
                         layOddsInput.placeholder = '-';
                         if (typeof runner?.layDecimalOdds === 'number' && Number.isFinite(runner.layDecimalOdds) && runner.layDecimalOdds > 1) {
                             layOddsInput.value = formatDecimal(runner.layDecimalOdds);
                         }
                         layOddsCell.appendChild(layOddsInput);
                         row.appendChild(layOddsCell);

                    appendCell('-', 'text-end ai-win-cell');

                    appendCell('-', 'text-end ai-odds-cell');

                    const applyCell = document.createElement('td');
                    applyCell.className = 'text-end apply-market-cell';
                    const applyButton = document.createElement('button');
                    applyButton.type = 'button';
                    applyButton.className = 'btn btn-sm btn-outline-primary apply-market-btn';
                    applyButton.textContent = 'Use market';
                    const marketProbabilityValue = parseProbabilityAttribute(row.dataset.marketProbability);
                    applyButton.disabled = !(marketProbabilityValue > 0);
                    applyCell.appendChild(applyButton);
                    row.appendChild(applyCell);

                    const marketPercent = typeof runner?.marketProbability === 'number'
                        ? formatPercentage(runner.marketProbability * 100)
                        : null;
                    appendCell(marketPercent ?? '-', 'text-end market-win-cell');

                    appendCell('-', 'text-end edge-cell');
                    const betting = resolveBettingRecommendation(runner);
                    if (betting.rowClass) {
                        row.classList.add(betting.rowClass);
                    }

                    appendCell(betting.kellyText, 'text-end kelly-cell');
                    const stakeCell = document.createElement('td');
                    stakeCell.className = 'text-end';
                    const stakeSpan = document.createElement('span');
                    stakeSpan.className = 'stake-value';
                    stakeSpan.dataset.defaultStake = betting.stakeData;
                    stakeSpan.dataset.kellyFraction = betting.kellyData;
                    stakeSpan.dataset.stakeType = betting.type;
                    stakeSpan.dataset.layOdds = betting.layOddsData;
                    stakeSpan.dataset.originalLayOdds = betting.layOddsData;
                    stakeSpan.dataset.originalText = betting.stakeText ?? '-';
                    stakeSpan.textContent = betting.stakeText;
                    stakeCell.appendChild(stakeSpan);
                    row.appendChild(stakeCell);
                      appendCell('-', 'text-end roi-cell');
                    const initialProbability = Number.isFinite(aiProbability) && aiProbability >= 0 ? aiProbability : 0;
                    const fromMarket = (row.dataset.aiProbabilitySource ?? '').toLowerCase() === 'market';
                    const parsedMarketOdds = Number.parseFloat(row.dataset.marketOdds ?? '');
                    const effectiveMarketOdds = Number.isFinite(parsedMarketOdds) ? parsedMarketOdds : null;
                    setRowAiProbability(row, initialProbability, {
                        fromMarket,
                        marketOdds: fromMarket ? effectiveMarketOdds : null,
                        preserveSource: true
                    });

                    tbody.appendChild(row);
                });
                bindOddsInputs(tbody);
                bindHistoricalRaceButtons(tbody);
                bindApplyMarketButtons(tbody);
                updateStakeDisplays();
            };

            const updateRaceCard = (marketId, race) => {
                if (!marketId) {
                    return;
                }

                const card = document.querySelector(`.card[data-market-id="${marketId}"]`);
                if (!card) {
                    return;
                }

                if (race?.marketId) {
                    card.dataset.marketId = race.marketId;
                    const refreshButton = card.querySelector('.refresh-race-btn');
                    if (refreshButton) {
                        refreshButton.dataset.marketId = race.marketId;
                    }
                    const marketOnlyButton = card.querySelector('.refresh-market-only-btn');
                    if (marketOnlyButton) {
                        marketOnlyButton.dataset.marketId = race.marketId;
                    }
                }

                updateRaceMetadata(card, race);
                renderRaceRows(card, race);
            };

            const applyMarketOddsUpdate = (card, update) => {
                if (!card || !update) {
                    return;
                }

                if (update.marketId) {
                    card.dataset.marketId = update.marketId;
                    const refreshButton = card.querySelector('.refresh-race-btn');
                    if (refreshButton) {
                        refreshButton.dataset.marketId = update.marketId;
                    }

                    const marketOnlyButton = card.querySelector('.refresh-market-only-btn');
                    if (marketOnlyButton) {
                        marketOnlyButton.dataset.marketId = update.marketId;
                    }
                }

                if (typeof update.backBookPercentage === 'number' || typeof update.layBookPercentage === 'number') {
                    const infoContainer = card.querySelector('.card-header .small.text-muted');
                    if (infoContainer) {
                        const spans = Array.from(infoContainer.querySelectorAll('span'));
                        const bookSpan = spans.find(span => span.textContent && span.textContent.trim().startsWith('Book:'));
                        if (bookSpan) {
                            const parts = [];
                            const backText = typeof update.backBookPercentage === 'number' && Number.isFinite(update.backBookPercentage)
                                ? formatPercentage(update.backBookPercentage)
                                : null;
                            if (backText) {
                                parts.push(`Back ${backText}`);
                            }

                            const layText = typeof update.layBookPercentage === 'number' && Number.isFinite(update.layBookPercentage)
                                ? formatPercentage(update.layBookPercentage)
                                : null;
                            if (layText) {
                                parts.push(`Lay ${layText}`);
                            }

                            bookSpan.textContent = parts.length > 0
                                ? `Book: ${parts.join(' / ')}`
                                : 'Book: -';
                        }
                    }
                }
                if (typeof update.going === 'string') {
                    const infoContainer = card.querySelector('.card-header .small.text-muted');
                    const goingText = update.going.trim();
                    if (infoContainer) {
                        const spans = Array.from(infoContainer.querySelectorAll('span'));
                        const goingSpan = spans.find(span => span.textContent && span.textContent.trim().startsWith('Going:'));
                        if (goingSpan) {
                            goingSpan.textContent = goingText.length > 0 ? `Going: ${goingText}` : 'Going: -';
                        }
                    }

                    const refreshButtons = card.querySelectorAll('.refresh-market-only-btn, .refresh-race-btn');
                    refreshButtons.forEach(btn => {
                        if (goingText.length > 0) {
                            btn.dataset.currentGoing = goingText;
                        } else {
                            delete btn.dataset.currentGoing;
                        }
                    });
                }

                const rows = card.querySelectorAll('tbody tr');
                const runners = Array.isArray(update.runners) ? update.runners : [];
                runners.forEach(runner => {
                    if (!runner) {
                        return;
                    }

                    let targetRow = null;

        if (typeof runner.horseName === 'string' && runner.horseName.trim().length > 0) {
                        const horseName = runner.horseName.trim().toLowerCase();
                        targetRow = Array.from(rows).find(r => {
                            const horseElement = r.querySelector('td:nth-of-type(3) .fw-semibold');
                            if (!horseElement) {
                                return false;
                            }

                            return horseElement.textContent.trim().toLowerCase() === horseName;
                        }) || null;
                    }

                    if (!targetRow) {
                        return;
                    }

                    if (typeof runner.horseName === 'string') {
                        targetRow.dataset.horseName = runner.horseName.trim();
                    }

                    let marketProbability = null;
                    if (typeof runner.marketProbability === 'number' && Number.isFinite(runner.marketProbability) && runner.marketProbability > 0) {
                        marketProbability = runner.marketProbability;
                    } else if (typeof runner.marketDecimalOdds === 'number' && Number.isFinite(runner.marketDecimalOdds) && runner.marketDecimalOdds > 1) {
                        marketProbability = 1 / runner.marketDecimalOdds;
                    }

                    if (Number.isFinite(marketProbability) && marketProbability > 0) {
                        targetRow.dataset.marketProbability = marketProbability.toString();
                    } else {
                        delete targetRow.dataset.marketProbability;
                    }

                    if (typeof runner.marketDecimalOdds === 'number' && Number.isFinite(runner.marketDecimalOdds) && runner.marketDecimalOdds > 1) {
                        targetRow.dataset.marketOdds = runner.marketDecimalOdds.toString();
                    } else {
                        delete targetRow.dataset.marketOdds;
                    }
                    const top3Metric = formatFinishRateMetric(runner?.top3FinishRate, 'of historical runs finished in the top 3');
                    const top5Metric = formatFinishRateMetric(runner?.top5FinishRate, 'of historical runs finished in the top 5');
                    const volatilityMetric = formatVolatilityMetric(runner?.finishPositionVolatility);

                    const top3Cell = targetRow.querySelector('.top3-cell');
                    if (top3Cell) {
                        setMetricCellContent(top3Cell, top3Metric.text, top3Metric.title);
                    }

                    const top5Cell = targetRow.querySelector('.top5-cell');
                    if (top5Cell) {
                        setMetricCellContent(top5Cell, top5Metric.text, top5Metric.title);
                    }

                    const finishVolCell = targetRow.querySelector('.finish-vol-cell');
                    if (finishVolCell) {
                        setMetricCellContent(finishVolCell, volatilityMetric.text, volatilityMetric.title);
                    }

                    const marketOddsCell = targetRow.querySelector('.market-odds-cell');
                    if (marketOddsCell) {
                        const marketInput = marketOddsCell.querySelector('.market-odds-input');
                        if (marketInput) {
                            if (typeof runner.marketDecimalOdds === 'number' && Number.isFinite(runner.marketDecimalOdds) && runner.marketDecimalOdds > 1) {
                                marketInput.value = formatDecimal(runner.marketDecimalOdds);
                                marketInput.classList.remove('is-invalid');
                            } else {
                                marketInput.value = '';
                                marketInput.classList.remove('is-invalid');
                            }
                            }
                    }

                    const layOddsCell = targetRow.querySelector('.lay-odds-cell');
                    if (layOddsCell) {
                        const layInput = layOddsCell.querySelector('.lay-odds-input');
                        if (layInput) {
                            if (typeof runner.layDecimalOdds === 'number' && Number.isFinite(runner.layDecimalOdds) && runner.layDecimalOdds > 1) {
                                layInput.value = formatDecimal(runner.layDecimalOdds);
                                layInput.classList.remove('is-invalid');
                            } else {
                                layInput.value = '';
                                layInput.classList.remove('is-invalid');
                            }
                        }
                    }

                    const marketWinCell = targetRow.querySelector('.market-win-cell');
                    if (marketWinCell) {
                        if (Number.isFinite(marketProbability) && marketProbability > 0) {
                            const percentText = formatPercentage(marketProbability * 100);
                            marketWinCell.textContent = percentText ?? '-';
                        } else {
                            marketWinCell.textContent = '-';
                        }
                    }

                    const applyButton = targetRow.querySelector('.apply-market-btn');
                    if (applyButton) {
                        applyButton.disabled = !(Number.isFinite(marketProbability) && marketProbability > 0);
                    }

                    const stakeSpan = targetRow.querySelector('.stake-value');
                    if (stakeSpan) {
                        if (typeof runner.layDecimalOdds === 'number' && Number.isFinite(runner.layDecimalOdds) && runner.layDecimalOdds > 1) {
                            const layOddsValue = runner.layDecimalOdds.toString();
                            stakeSpan.dataset.layOdds = layOddsValue;
                            stakeSpan.dataset.originalLayOdds = layOddsValue;
                        } else if (!Number.isFinite(Number.parseFloat(stakeSpan.dataset.layOdds ?? ''))) {
                            delete stakeSpan.dataset.layOdds;
                        }
                    }

                    const source = (targetRow.dataset.aiProbabilitySource ?? '').toLowerCase();
                    if (source === 'market' && Number.isFinite(marketProbability) && marketProbability > 0) {
                        const parsedMarketOdds = Number.parseFloat(targetRow.dataset.marketOdds ?? '');
                        const effectiveMarketOdds = Number.isFinite(parsedMarketOdds) ? parsedMarketOdds : null;
                        setRowAiProbability(targetRow, marketProbability, {
                            fromMarket: true,
                            marketOdds: effectiveMarketOdds,
                            preserveSource: true
                        });
                    } else {
                        refreshRowAiProbabilityDisplay(targetRow);
                    }
                });

                bindApplyMarketButtons(card);
                bindOddsInputs(card);
                updateStakeDisplays();
            };

            const bindMarketRefreshButtons = (root = document) => {
                if (!root || typeof root.querySelectorAll !== 'function') {
                    return;
                }

                const buttons = root.querySelectorAll('.refresh-market-only-btn');
                buttons.forEach(button => {
                    if (!button) {
                        return;
                    }

                    if (button[MARKET_REFRESH_HANDLER_FLAG]) {
                        return;
                    }

                    button[MARKET_REFRESH_HANDLER_FLAG] = true;

                    button.dataset.marketRefreshBound = '1';
                    button.addEventListener('click', async () => {
                        if (button.disabled) {
                            return;
                        }

                        const raceUrl = button.dataset.raceUrl;
                        const marketId = button.dataset.marketId;
                        const rawGoing = button.dataset.currentGoing;
                        const currentGoing = (typeof rawGoing === 'string' && rawGoing.trim().length > 0)
                            ? rawGoing.trim()
                            : null;
                        const card = button.closest('.card');

                        if (!raceUrl) {
                            alert('No market URL is available for this race.');
                            return;
                        }

                        if (!card) {
                            alert('Unable to locate the race card for updating.');
                            return;
                        }

                        const originalHtml = button.innerHTML;
                        button.disabled = true;
                        button.innerText = 'Refreshing…';

                        try {
                            const response = await fetch(refreshMarketEndpoint, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ raceUrl, marketId, currentGoing })
                            });

                            if (!response.ok) {
                                throw new Error(`Request failed with status ${response.status}`);
                            }

                            const payload = await response.json();
                            if (payload?.success && payload?.update) {
                                applyMarketOddsUpdate(card, payload.update);
                                const newGoing = typeof payload.newGoing === 'string'
                                    ? payload.newGoing.trim()
                                    : '';

                                if (newGoing.length > 0) {
                                    button.dataset.currentGoing = newGoing;
                                } else {
                                    delete button.dataset.currentGoing;
                                }

                                const fullRefreshButton = card.querySelector('.refresh-race-btn');
                                if (fullRefreshButton) {
                                    if (newGoing.length > 0) {
                                        fullRefreshButton.dataset.currentGoing = newGoing;
                                    } else {
                                        delete fullRefreshButton.dataset.currentGoing;
                                    }
                                }

                                if (payload.goingChanged) {
                                    if (payload.aiRefreshed) {
                                        const message = newGoing.length > 0
                                            ? `Track going changed to "${newGoing}". AI odds were refreshed.`
                                            : 'Track going changed. AI odds were refreshed.';
                                        alert(message);
                                    } else {
                                        const message = newGoing.length > 0
                                            ? `Track going changed to "${newGoing}".`
                                            : 'Track going changed.';
                                        alert(message);
                                    }
                                }
                                return;
                            }

                            const message = payload?.message ?? 'Failed to refresh market odds.';
                            alert(message);
                        } catch (error) {
                            console.error('Market-only refresh request failed', error);
                            alert('Unable to refresh the market odds for this race. Please try again.');
                        } finally {
                            button.innerHTML = originalHtml;
                            button.disabled = !button.dataset.raceUrl;
                        }
                    });
                });
             };

            const bindFullRefreshButtons = (root = document) => {
                if (!root || typeof root.querySelectorAll !== 'function') {
                    return;
                }

            const buttons = root.querySelectorAll('.refresh-race-btn');
                if (!buttons || buttons.length === 0) {
                    return;
                }

                buttons.forEach(button => {
                    if (!button) {
                        return;
                    }

                    if (button[FULL_REFRESH_HANDLER_FLAG]) {
                        return;
                    }

                    button[FULL_REFRESH_HANDLER_FLAG] = true;
                    button.dataset.fullRefreshBound = '1';
                    button.addEventListener('click', async () => {
                        if (button.disabled) {
                            return;
                        }

                        const raceUrl = button.dataset.raceUrl;
                        const marketId = button.dataset.marketId;
                        const rawGoing = button.dataset.currentGoing;
                        const currentGoing = (typeof rawGoing === 'string' && rawGoing.trim().length > 0)
                            ? rawGoing.trim()
                            : null;
                        const card = button.closest('.card');
                        if (!raceUrl) {
                            alert('No market URL is available for this race.');
                            return;
                        }

                        const originalHtml = button.innerHTML;
                        button.disabled = true;
                        button.innerText = 'Refreshing…';

                        try {
                            const response = await fetch(refreshEndpoint, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ raceUrl, marketId, currentGoing })
                            });

                            if (!response.ok) {
                                throw new Error(`Request failed with status ${response.status}`);
                            }

                            const payload = await response.json();
                            if (payload?.success) {
                                const market = payload?.race?.marketId ?? payload?.update?.marketId ?? marketId;
                                if (payload?.race) {
                                    updateRaceCard(market, payload.race);
                                } else if (payload?.update && card) {
                                    applyMarketOddsUpdate(card, payload.update);
                                }

                                const newGoing = typeof payload?.newGoing === 'string'
                                    ? payload.newGoing.trim()
                                    : '';

                                if (card) {
                                    const targets = card.querySelectorAll('.refresh-market-only-btn, .refresh-race-btn');
                                    targets.forEach(btn => {
                                        if (!btn) {
                                            return;
                                        }

                                        if (newGoing.length > 0) {
                                            btn.dataset.currentGoing = newGoing;
                                        } else {
                                            delete btn.dataset.currentGoing;
                                        }
                                    });
                                } else if (newGoing.length > 0) {
                                    button.dataset.currentGoing = newGoing;
                                } else {
                                    delete button.dataset.currentGoing;
                                }

                                if (payload?.goingChanged) {
                                    if (payload?.aiRefreshed) {
                                        const message = newGoing.length > 0
                                            ? `Track going changed to "${newGoing}". AI odds were refreshed.`
                                            : 'Track going changed. AI odds were refreshed.';
                                        alert(message);
                                    } else {
                                        const message = newGoing.length > 0
                                            ? `Track going changed to "${newGoing}".`
                                            : 'Track going changed.';
                                        alert(message);
                                    }
                                }
                                return;
                            }

                            const message = payload?.message ?? 'Failed to refresh market odds.';
                            alert(message);
                        } catch (error) {
                            console.error('Refresh request failed', error);
                            alert('Unable to refresh the market odds for this race. Please try again.');
                        } finally {
                            button.innerHTML = originalHtml;
                            button.disabled = !button.dataset.raceUrl;
                        }
                    });
                });
            };

            bindOddsInputs(document);
            bindHistoricalRaceButtons(document);
            bindApplyMarketButtons(document);
            bindMarketRefreshButtons(document);
            bindFullRefreshButtons(document);
            updateStakeDisplays();
        })();
    </script>
}
