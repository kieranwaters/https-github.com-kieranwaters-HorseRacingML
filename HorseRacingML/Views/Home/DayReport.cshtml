                        marketWinCell.textContent = '-';
                    }
                }

                const applyButton = row.querySelector('.apply-market-btn');
                if (applyButton) {
                    applyButton.disabled = !(probability > 0);
                }

                refreshRowAiProbabilityDisplay(row);

                if (options.formatValue) {
                    input.value = formatDecimal(parsed);
