                    const runnersRaw = race?.runnerCount;
                    const runnersNumber = typeof runnersRaw === 'number'
                        ? runnersRaw
                        : Number.parseInt(runnersRaw, 10);
                    if (Number.isFinite(runnersNumber)) {
                        runnerCountCell.textContent = runnersNumber.toLocaleString(undefined, { maximumFractionDigits: 0 });
                    } else if (typeof runnersRaw === 'string' && runnersRaw.trim().length > 0) {
                        runnerCountCell.textContent = runnersRaw.trim();
                    } else {
                        runnerCountCell.textContent = '-';
