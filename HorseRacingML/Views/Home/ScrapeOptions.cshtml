@{
    ViewData["Title"] = "Scrape Options";
}

<div class="text-center mt-5">
    <h1 class="display-4">Select Scrape Region</h1>
    <p class="lead">Choose which region to scrape data from.</p>

    <div class="d-flex justify-content-center gap-4 mt-5">
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Western</h5>
                <p class="card-text">Scrape data using the standard scraping logic (Sporting Life).</p>
                <a asp-controller="Home" asp-action="ScrapeRaceResults" class="btn btn-primary btn-lg w-100">Western</a>
            </div>
        </div>

        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Eastern</h5>
                <p class="card-text">Iterate Sky Racing World results from selected date to present.</p>
                <form asp-controller="Home" asp-action="ScrapeEasternResults" method="post">
                    <div class="mb-3">
                        <label for="startDate" class="form-label">Start Date</label>
                        <input type="date" class="form-control" id="startDate" name="startDate" value="2015-05-17">
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100">Eastern</button>
                </form>
            </div>
        </div>
    </div>
</div>
