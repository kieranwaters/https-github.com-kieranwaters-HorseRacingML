@model HorseRacingML.Models.DayReportFilterViewModel
@{
    ViewData["Title"] = "Day Report";
    string startValue = string.IsNullOrWhiteSpace(Model.StartTime) ? string.Empty : Model.StartTime!;
    string endValue = string.IsNullOrWhiteSpace(Model.EndTime) ? string.Empty : Model.EndTime!;
    string regionValue = string.IsNullOrWhiteSpace(Model.Region)
        ? HorseRacingML.Models.DayReportFilterViewModel.DefaultRegion
        : Model.Region;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-3">Day Report</h1>
                <p class="text-muted">Select the time window you want to include in your day report. Leave a field empty to include all races before or after the other selection.</p>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                }

                <form asp-action="DayReport" asp-controller="Home" method="get" class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="startTimeInput">Start time</label>
                        <input type="time"
                               class="form-control"
                               id="startTimeInput"
                               name="startTime"
                               value="@startValue"
                               placeholder="HH:MM" />
                        <div class="form-text">Include races from this time onwards.</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="endTimeInput">End time</label>
                        <input type="time"
                               class="form-control"
                               id="endTimeInput"
                               name="endTime"
                               value="@endValue"
                               placeholder="HH:MM" />
                        <div class="form-text">Include races up to this time.</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="regionSelect">Region</label>
                        <select class="form-select" id="regionSelect" name="region">
                            @foreach (var option in HorseRacingML.Models.DayReportFilterViewModel.AvailableRegions)
                            {
                                if (string.Equals(regionValue, option, System.StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@option" selected>@option</option>
                                }
                                else
                                {
                                    <option value="@option">@option</option>
                                }
                            }
                        </select>
                        <div class="form-text">Choose which Betfair region to expand automatically.</div>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="showFeatureSignificanceCheck" name="showFeatureSignificance" value="true" @(Model.ShowFeatureSignificance ? "checked" : "")>
                            <label class="form-check-label" for="showFeatureSignificanceCheck">
                                Calculate feature significance
                            </label>
                        </div>
                        <div class="form-text">Calculate how much each input contributed to the AI's score (slower).</div>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="runHeadlessCheck" name="runHeadless" value="true">
                            <label class="form-check-label" for="runHeadlessCheck">
                                Run headless (invisible browser)
                            </label>
                        </div>
                        <div class="form-text">Runs the browser in the background for faster processing and lower memory usage.</div>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="useHybridCheck" name="useHybrid" value="true">
                            <label class="form-check-label" for="useHybridCheck">
                                Use Hybrid Model (NN + LightGBM)
                            </label>
                        </div>
                        <div class="form-text">Uses the separately trained 'NNLightGBM.json' model which combines predictions from both Neural Network and LightGBM models.</div>
                    </div>
                    <div class="col-12 d-flex justify-content-between flex-wrap gap-2 mt-3">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Back to dashboard</a>
                        <button type="submit" class="btn btn-primary">Generate day report</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>