@model HorseRacingML.Models.MLParameter
@{
    ViewData["Title"] = "Custom Hyperparameters";
}

<h1>Custom Hyperparameters</h1>

<form asp-action="Custom" method="post">
    <div class="mb-3">
        <label asp-for="Units" class="form-label"></label>
        <input asp-for="Units" class="form-control" />
        <span asp-validation-for="Units" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Dropout" class="form-label"></label>
        <input asp-for="Dropout" class="form-control" />
        <span asp-validation-for="Dropout" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Layers" class="form-label"></label>
        <input asp-for="Layers" class="form-control" />
        <span asp-validation-for="Layers" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LearningRate" class="form-label"></label>
        <input asp-for="LearningRate" class="form-control" />
        <span asp-validation-for="LearningRate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Epochs" class="form-label"></label>
        <input asp-for="Epochs" class="form-control" />
        <span asp-validation-for="Epochs" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BatchSize" class="form-label"></label>
        <input asp-for="BatchSize" class="form-control" />
        <span asp-validation-for="BatchSize" class="text-danger"></span>
    </div>
    <input type="hidden" asp-for="RunDate" />
    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}