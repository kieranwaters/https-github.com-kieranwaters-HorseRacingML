@model HorseRacingML.Models.MLParameterBatch
@{
    ViewData["Title"] = "Custom Hyperparameters";
}

<h1>Custom Hyperparameters</h1>

<form asp-action="Custom" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <table class="table">
        <thead>
            <tr>
                <th>Model</th>
                <th>Units / Leaves</th>
                <th>Dropout / Min Data</th>
                <th>Layers / Max Depth</th>
                <th>Learning Rate</th>
                <th>Epochs</th>
                <th>Batch Size</th>
                <th>Folds</th>
                <th>Last Fold Only?</th>
                <th style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody id="parameterRows">
            @for (int i = 0; i < Model.Parameters.Count; i++)
            {
                <tr class="parameter-row">
                    <td>
                        <select asp-for="Parameters[i].ModelType" class="form-select model-type-select" onchange="toggleInputs(this)">
                            <option value="0">Neural Network</option>
                            <option value="1">LightGBM</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="Parameters[i].Units" type="number" class="form-control nn-input" placeholder="Units" />
                        <input asp-for="Parameters[i].LgbmLeaves" type="number" class="form-control lgbm-input" placeholder="Leaves" style="display:none" />
                    </td>
                    <td>
                        <input asp-for="Parameters[i].Dropout" type="number" step="any" class="form-control nn-input" placeholder="Dropout" />
                        <input asp-for="Parameters[i].LgbmMinDataInLeaf" type="number" class="form-control lgbm-input" placeholder="Min Data" style="display:none" />
                    </td>
                    <td>
                        <input asp-for="Parameters[i].Layers" type="number" class="form-control nn-input" placeholder="Layers" />
                        <input asp-for="Parameters[i].LgbmMaxDepth" type="number" class="form-control lgbm-input" placeholder="Max Depth" style="display:none" />
                    </td>
                    <td><input asp-for="Parameters[i].LearningRate" type="number" step="any" class="form-control" /></td>
                    <td><input asp-for="Parameters[i].Epochs" type="number" class="form-control" /></td>
                    <td>
                        <input asp-for="Parameters[i].BatchSize" type="number" class="form-control nn-input" />
                        <span class="lgbm-input text-muted small" style="display:none">N/A</span>
                    </td>
                    <td><input asp-for="Parameters[i].Folds" type="number" class="form-control" /></td>
                    <td><div class="form-check d-flex justify-content-center"><input asp-for="Parameters[i].TrainFinalFoldOnly" class="form-check-input" /></div></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveRowUp(this)" title="Move Up">↑</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveRowDown(this)" title="Move Down">↓</button>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)" title="Remove">✕</button>
                        </div>
                    </td>
                    <input type="hidden" asp-for="Parameters[i].RunDate" />
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex align-items-center gap-3">
        <button type="button" class="btn btn-secondary" onclick="addRow()">Add Row</button>
        <div class="input-group" style="width: 200px;">
            <span class="input-group-text">Threads</span>
            <input type="number" id="concurrencyLimit" class="form-control" value="2" min="1" max="8">
        </div>
        <button type="button" class="btn btn-primary" id="btnStartProcessing" onclick="startProcessingQueue()">Start Processing Queue</button>
        <div id="processingStatus" class="fw-bold text-info" style="display:none;"></div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Initialize existing rows
            document.querySelectorAll('.model-type-select').forEach(select => toggleInputs(select));
        });

        function toggleInputs(selectElement) {
            const row = selectElement.closest('tr');
            const isLgbm = selectElement.value === "1";

            row.querySelectorAll('.nn-input').forEach(el => el.style.display = isLgbm ? 'none' : '');
            row.querySelectorAll('.lgbm-input').forEach(el => el.style.display = isLgbm ? '' : 'none');
        }

        function addRow() {
            const rows = document.querySelectorAll('#parameterRows tr');
            const index = rows.length;
            const template = `
                <tr class="parameter-row">
                    <td>
                        <select name="Parameters[${index}].ModelType" class="form-select model-type-select" onchange="toggleInputs(this)">
                            <option value="0">Neural Network</option>
                            <option value="1">LightGBM</option>
                        </select>
                    </td>
                    <td>
                        <input name="Parameters[${index}].Units" type="number" class="form-control nn-input" placeholder="Units" />
                        <input name="Parameters[${index}].LgbmLeaves" type="number" class="form-control lgbm-input" placeholder="Leaves" style="display:none" />
                    </td>
                    <td>
                        <input name="Parameters[${index}].Dropout" type="number" step="any" class="form-control nn-input" placeholder="Dropout" />
                        <input name="Parameters[${index}].LgbmMinDataInLeaf" type="number" class="form-control lgbm-input" placeholder="Min Data" style="display:none" />
                    </td>
                    <td>
                        <input name="Parameters[${index}].Layers" type="number" class="form-control nn-input" placeholder="Layers" />
                        <input name="Parameters[${index}].LgbmMaxDepth" type="number" class="form-control lgbm-input" placeholder="Max Depth" style="display:none" />
                    </td>
                    <td><input name="Parameters[${index}].LearningRate" type="number" step="any" class="form-control" /></td>
                    <td><input name="Parameters[${index}].Epochs" type="number" class="form-control" /></td>
                    <td>
                         <input name="Parameters[${index}].BatchSize" type="number" class="form-control nn-input" />
                         <span class="lgbm-input text-muted small" style="display:none">N/A</span>
                    </td>
                    <td><input name="Parameters[${index}].Folds" type="number" class="form-control" /></td>
                    <td><div class="form-check d-flex justify-content-center"><input class="form-check-input" type="checkbox" name="Parameters[${index}].TrainFinalFoldOnly" value="true"></div></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveRowUp(this)" title="Move Up">↑</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveRowDown(this)" title="Move Down">↓</button>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)" title="Remove">✕</button>
                        </div>
                    </td>
                    <input type="hidden" name="Parameters[${index}].RunDate" value="${new Date().toISOString()}" />
                </tr>`;
            document.getElementById('parameterRows').insertAdjacentHTML('beforeend', template);
        }
        function removeRow(btn) {
            btn.closest('tr').remove();
            updateIndexes();
        }
        function moveRowUp(btn) {
            const row = btn.closest('tr');
            const prev = row.previousElementSibling;
            if (prev) {
                row.parentNode.insertBefore(row, prev);
                updateIndexes();
            }
        }
        function moveRowDown(btn) {
            const row = btn.closest('tr');
            const next = row.nextElementSibling;
            if (next) {
                row.parentNode.insertBefore(next, row);
                updateIndexes();
            }
        }
        function updateIndexes() {
            const rows = document.querySelectorAll('#parameterRows tr');
            rows.forEach((row, idx) => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name) {
                        input.setAttribute('name', name.replace(/Parameters\[\d+\]/, `Parameters[${idx}]`));
                    }
                    const id = input.getAttribute('id');
                    if (id) {
                        input.setAttribute('id', id.replace(/_\d+__/, `_${idx}__`));
                    }
                });
            });
        }

        async function startProcessingQueue() {
            const btn = document.getElementById('btnStartProcessing');
            const statusDiv = document.getElementById('processingStatus');
            const concurrencyInput = document.getElementById('concurrencyLimit');

            const maxConcurrency = parseInt(concurrencyInput.value) || 1;

            btn.disabled = true;
            concurrencyInput.disabled = true;
            statusDiv.style.display = 'block';
            statusDiv.textContent = 'Initializing...';

            let activeCount = 0;
            let totalProcessed = 0;
            let hasError = false;

            async function processNext() {
                if (hasError) return;

                const rows = document.querySelectorAll('#parameterRows tr.parameter-row:not(.processing-row)');
                if (rows.length === 0) {
                    if (activeCount === 0) {
                        statusDiv.textContent = 'All items processed.';
                        btn.disabled = false;
                        concurrencyInput.disabled = false;
                        setTimeout(() => statusDiv.style.display = 'none', 3000);
                    }
                    return;
                }

                // Pick the first available row and mark it as processing
                const row = rows[0];
                row.classList.add('processing-row');

                activeCount++;
                statusDiv.textContent = `Processing... (${activeCount} active)`;

                // Extract data from the row inputs
                const modelType = parseInt(row.querySelector('.model-type-select').value);
                const isLgbm = modelType === 1;

                const model = {
                    ModelType: modelType,
                    LearningRate: parseFloat(row.querySelector('input[name*=".LearningRate"]').value) || 0.1,
                    Epochs: parseInt(row.querySelector('input[name*=".Epochs"]').value) || 100,
                    Folds: parseInt(row.querySelector('input[name*=".Folds"]').value) || 1,
                    TrainFinalFoldOnly: row.querySelector('input[name*=".TrainFinalFoldOnly"]').checked,
                    RunDate: new Date().toISOString()
                };

                if (isLgbm) {
                    model.LgbmLeaves = parseInt(row.querySelector('.lgbm-input[placeholder="Leaves"]').value) || 31;
                    model.LgbmMinDataInLeaf = parseInt(row.querySelector('.lgbm-input[placeholder="Min Data"]').value) || 20;
                    model.LgbmMaxDepth = parseInt(row.querySelector('.lgbm-input[placeholder="Max Depth"]').value) || -1;
                } else {
                    model.Units = parseInt(row.querySelector('.nn-input[placeholder="Units"]').value) || 10;
                    model.Dropout = parseFloat(row.querySelector('.nn-input[placeholder="Dropout"]').value) || 0;
                    model.Layers = parseInt(row.querySelector('.nn-input[placeholder="Layers"]').value) || 1;
                    model.BatchSize = parseInt(row.querySelector('input[name*=".BatchSize"]').value) || 32;
                }

                try {
                    const response = await fetch('/Hyperparameter/TrainCustomModel', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify(model)
                    });

                    if (!response.ok) {
                        throw new Error(`Server returned ${response.status} ${response.statusText}`);
                    }

                    const result = await response.json();
                    if (result.success) {
                        row.remove();
                        totalProcessed++;
                        // We don't update indexes here to avoid breaking concurrent processing
                    } else {
                        hasError = true;
                        alert('Training failed: ' + result.message);
                        statusDiv.textContent = 'Stopped due to error.';
                        row.classList.remove('processing-row');
                        // Highlight error?
                        row.style.backgroundColor = '#ffe6e6';
                    }
                } catch (error) {
                    hasError = true;
                    console.error('Error:', error);
                    alert('An error occurred during processing: ' + error.message);
                    statusDiv.textContent = 'Stopped due to error.';
                    row.classList.remove('processing-row');
                    row.style.backgroundColor = '#ffe6e6';
                } finally {
                    activeCount--;
                    if (!hasError) {
                        processNext();
                    } else if (activeCount === 0) {
                         btn.disabled = false;
                         concurrencyInput.disabled = false;
                    }
                }
            }

            // Start initial batch
            for (let i = 0; i < maxConcurrency; i++) {
                processNext();
            }
        }
    </script>
}