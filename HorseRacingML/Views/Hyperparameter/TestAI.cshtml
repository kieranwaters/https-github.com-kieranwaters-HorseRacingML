                <dt class="col-sm-4">Training loss</dt>
                <dd class="col-sm-8">@Model.TrainLoss?.ToString("F4")</dd>
                <dt class="col-sm-4">Validation Brier score</dt>
                <dd class="col-sm-8">@Model.ValidationBrier?.ToString("F4")</dd>
                <dt class="col-sm-4">Training Brier score</dt>
                <dd class="col-sm-8">@Model.TrainBrier?.ToString("F4")</dd>
                <dt class="col-sm-4">Validation Focal loss</dt>
                <dd class="col-sm-8">@Model.ValidationFocalLoss?.ToString("F4")</dd>
                <dt class="col-sm-4">Training Focal loss</dt>
                <dd class="col-sm-8">@Model.TrainFocalLoss?.ToString("F4")</dd>
            </dl>

            @if (Model.ParameterUsed != null)
            {
                <h6>Parameters Used</h6>
                <ul>
                    <li>Layers: @Model.ParameterUsed.Layers</li>
                    <li>Units per Layer: @Model.ParameterUsed.Units</li>
                    <li>Dropout: @Model.ParameterUsed.Dropout</li>
                    <li>Learning Rate: @Model.ParameterUsed.LearningRate</li>
                    <li>Epochs: @Model.ParameterUsed.Epochs</li>
                    <li>Batch Size: @Model.ParameterUsed.BatchSize</li>
                    @if (Model.ParameterUsed.Folds > 0)
                    {
                        <li>Folds: @Model.ParameterUsed.Folds</li>
                    }
                </ul>
            }
        </div>
    </div>
}

<a asp-action="TrainAI" class="btn btn-link mt-3">Back to Train AI</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Toggle details on row click
            const raceRows = document.querySelectorAll('.clickable-row');
            raceRows.forEach(row => {
                row.addEventListener('click', function () {
                    const detailsRow = this.nextElementSibling;
                    if (detailsRow && detailsRow.classList.contains('race-details')) {
                        detailsRow.classList.toggle('hidden');
                    }
                });
            });

            const hasResults = @Model.HasResult.ToString().ToLower();
            if (hasResults) {
                document.getElementById('apply-filters-btn').addEventListener('click', function () {
                    // --- 1. Gather User Inputs ---
                    const minStarts = parseInt(document.getElementById('min-starts-filter').value, 10);
                    const maxRunners = parseInt(document.getElementById('max-runners-filter').value, 10);

                    const minEdgeFavVal = parseFloat(document.getElementById('min-edge-filter').value);
                    const minEdgeFav = isNaN(minEdgeFavVal) ? -100 : minEdgeFavVal;

                    const minEdgeOtherVal = parseFloat(document.getElementById('min-other-edge-filter').value);
                    const minEdgeOther = isNaN(minEdgeOtherVal) ? 100 : minEdgeOtherVal;

                    const minEdgeLayVal = parseFloat(document.getElementById('min-lay-edge-filter').value);
                    const minEdgeLay = isNaN(minEdgeLayVal) ? 100 : minEdgeLayVal;

                    const minEdgeLayFavVal = parseFloat(document.getElementById('min-lay-edge-fav-filter').value);
                    const minEdgeLayFav = isNaN(minEdgeLayFavVal) ? 100 : minEdgeLayFavVal;

                    const includeFees = document.getElementById('include-fees-checkbox').checked;
                    const kellyDampener = parseFloat(document.getElementById('KellyDampener').value);
                    const startingBankroll = parseFloat(document.getElementById('StartingBankroll').value);

                    let currentBankroll = startingBankroll;
                    let totalStaked = 0;
                    let winCount = 0;
                    let lossCount = 0;
                    let totalBets = 0;

                    const allRaceRows = document.querySelectorAll('.race-row');

                    let visibleRaceCount = 0;
                    let correctPredictions = 0; // Tracks if AI's top pick won (for summary accuracy)

                    // --- 2. Iterate Races ---
                    allRaceRows.forEach(row => {
                        const runnerCount = parseInt(row.dataset.runnerCount, 10);
                        const runnerStartsArr = row.dataset.runnerStarts.split(',').map(s => parseInt(s, 10) || 0);
                        const predictedWinnerName = row.dataset.predictedWinner;

                        // Parse full runner data
                        let runners = [];
                        try {
                            runners = JSON.parse(row.dataset.runners);
                        } catch (e) {
                            console.error("Failed to parse runners JSON", e);
                        }

                        // Basic filtering (Starts & Max Runners)
                        const meetsMinStarts = !runnerStartsArr.some(starts => starts < minStarts);
                        const meetsMaxRunners = runnerCount <= maxRunners;

                        // If race doesn't meet basic criteria, hide it
                        if (!meetsMinStarts || !meetsMaxRunners) {
                            row.style.display = 'none';
                            const detailsRow = row.nextElementSibling;
                            if (detailsRow && detailsRow.classList.contains('race-details')) {
                                detailsRow.style.display = 'none';
                            }
                            return;
                        }

                        // Race is visible
                        visibleRaceCount++;
                        row.style.display = '';
                        const detailsRow = row.nextElementSibling;
                        if (detailsRow && detailsRow.classList.contains('race-details')) {
                            detailsRow.style.display = '';
                        }

                        // Determine AI Favorite (Max AI Prob)
                        let aiFavorite = null;
                        let maxProb = -1;
                        runners.forEach(r => {
                            if (r.AiProbability > maxProb) {
                                maxProb = r.AiProbability;
                                aiFavorite = r;
                            }
                        });

                        // Identify Candidates & Calculate Edges
                        let bets = [];

                        runners.forEach(r => {
                            const aiProb = r.AiProbability;
                            const bookOdds = r.BookmakerOdds;
                            const marketProb = bookOdds > 1 ? (1.0 / bookOdds) : 0;
                            const isFav = (aiFavorite && r.HorseName === aiFavorite.HorseName);

                            // Skip if no odds
                            if (bookOdds <= 1) return;

                            // 1. Back Bets (AI Fav or Other)
                            if (aiProb > marketProb) {
                                const edgePercent = (aiProb - marketProb) * 100;
                                let isCandidate = false;

                                if (isFav && edgePercent >= minEdgeFav) {
                                    isCandidate = true;
                                } else if (!isFav && edgePercent >= minEdgeOther) {
                                    isCandidate = true;
                                }

                                if (isCandidate) {
                                    bets.push({
                                        runner: r,
                                        type: 'Back',
                                        edge: edgePercent,
                                        odds: bookOdds,
                                        aiProb: aiProb,
                                        marketProb: marketProb
                                    });
                                }
                            }

                            // 2. Lay Bets
                            // Lay Edge: Market Prob > AI Prob.
                            // Meaning market thinks it wins (high prob), AI thinks it loses (low prob).
                            // Edge = MarketProb - AIProb
                            if (marketProb > aiProb) {
                                const edgePercent = (marketProb - aiProb) * 100;
                                let isCandidate = false;

                                if (isFav && edgePercent >= minEdgeLayFav) {
                                    isCandidate = true;
                                } else if (!isFav && edgePercent >= minEdgeLay) {
                                    isCandidate = true;
                                }

                                if (isCandidate) {
                                    bets.push({
                                        runner: r,
                                        type: 'Lay',
                                        edge: edgePercent,
                                        odds: bookOdds,
                                        aiProb: aiProb,
                                        marketProb: marketProb
                                    });
                                }
                            }
                        });

                        // Sort Bets by Edge Descending (Priority)
                        bets.sort((a, b) => b.edge - a.edge);

                        // Calculate Stakes & Outcomes
                        let raceNetProfit = 0;
                        let raceStaked = 0;
                        let executedBets = [];

                        bets.forEach(bet => {
                            let stake = 0;
                            let profit = 0;
                            let won = false;

                            // Calculate Kelly Stake
                            if (bet.type === 'Back') {
                                // Standard Kelly: (p(b-1) - q) / (b-1)  =  (p*b - 1) / (b - 1) ?
                                // Simpler: Edge / (Odds - 1)
                                // Edge is prob diff.
                                // Proper Kelly Fraction f* = (p*b - 1) / (b - 1)
                                // where p = winning prob, b = decimal odds.
                                // Note: (p - 1/b) * b / (b-1) ... let's use the Edge / (Odds - 1) approx which is common
                                // or the exact formula:
                                // Fraction = (AiProb * bet.odds - 1) / (bet.odds - 1);

                                const kellyFraction = (bet.aiProb * bet.odds - 1) / (bet.odds - 1);
                                if (kellyFraction > 0) {
                                    stake = (currentBankroll * kellyFraction) / kellyDampener;
                                }

                                // Outcome
                                if (stake > 0) {
                                    raceStaked += stake;
                                    // Back bet wins if horse wins
                                    if (bet.runner.IsWinner) {
                                        won = true;
                                        let grossProfit = stake * (bet.odds - 1);
                                        if (includeFees) grossProfit *= 0.98;
                                        profit = grossProfit;
                                    } else {
                                        won = false;
                                        profit = -stake;
                                    }
                                }
                            } else if (bet.type === 'Lay') {
                                // Lay Kelly: Stake (backer's stake) = Bankroll * (MarketProb - AiProb) / (1 - MarketProb) ?
                                // A common Lay Kelly formula: Liability = Bankroll * Fraction
                                // Fraction = (q * (1 - p_market) - p_market * (1-q)) / (1-p_market) ... complex.
                                // Let's use the simple "Back the other side" logic.
                                // We are backing "Not Horse". Odds = 1 / (1 - MarketProb)? No, Lay Odds are specific.
                                // Lay Odds = BookmakerOdds.
                                // Effective Back Odds for us = Odds / (Odds - 1) ? No.
                                // Let's use the formula: Fraction = (TrueProbOfLosing - ImpliedProbOfLosing) / ImpliedProbOfLosing ?
                                // Let's stick to user's requirement: Dampener decides liability.
                                // We will use Edge Magnitude to scale.
                                // Edge = MarketProb - AiProb.
                                // Let's assume proportional stake based on edge magnitude similar to Back.
                                // Fraction = Edge / (1 - 1/Odds)?
                                // Let's use a robust approximation:
                                // Fraction = (Probability of Winning Lay - Market Probability of Winning Lay) / (Market Odds of Winning Lay - 1) ??
                                // Actually, simpler: Treat it as backing "The Field".
                                // Prob(Field Wins) = 1 - AiProb.
                                // Market Prob(Field Wins) = 1 - MarketProb.
                                // Odds(Field Wins) ~ 1 / (1 - MarketProb).
                                // Edge for Field = (1 - AiProb) - (1 - MarketProb) = MarketProb - AiProb. (Matches our Edge calc).
                                // Kelly Fraction = Edge / (OddsField - 1).
                                // OddsField - 1 = (1 / (1 - MarketProb)) - 1 = MarketProb / (1 - MarketProb).
                                // So Fraction = (MarketProb - AiProb) * (1 - MarketProb) / MarketProb.

                                const edge = bet.marketProb - bet.aiProb;
                                const oddsFieldMinus1 = (bet.marketProb / (1.0 - bet.marketProb));
                                const kellyFraction = edge / oddsFieldMinus1;

                                if (kellyFraction > 0) {
                                    // Stake here represents LIABILITY or STAKE?
                                    // User said "lose nearly my bankroll". Standard Kelly calculates AMOUNT TO RISK (Liability).
                                    // So Liability = Bankroll * Fraction / Dampener.
                                    const liability = (currentBankroll * kellyFraction) / kellyDampener;

                                    // For a Lay bet at odds O, Liability = Stake * (O - 1).
                                    // So Backer's Stake (Volume) = Liability / (O - 1).
                                    const backersStake = liability / (bet.odds - 1);

                                    stake = liability; // We track liability as our "stake" / risk.

                                    if (stake > 0) {
                                        raceStaked += stake;
                                        // Lay bet wins if horse LOSES (IsWinner == false)
                                        if (!bet.runner.IsWinner) {
                                            won = true;
                                            // We win the backer's stake
                                            let grossProfit = backersStake;
                                            if (includeFees) grossProfit *= 0.98;
                                            profit = grossProfit;
                                        } else {
                                            won = false;
                                            // We lose the liability
                                            profit = -stake;
                                        }
                                    }
                                }
                            }

                            // Limits
                            stake = Math.round(stake * 100) / 100;
                            if (stake < 0.01) stake = 0;
                            // Ensure we don't bet more than we have (simple check, though Kelly theoretically prevents ruin)
                            // But since we are iterating bets in a race sequentially...
                            // Actually, standard practice is to use STARTING bankroll for all bets in same event to avoid correlation issues,
                            // OR update "Available Funds".
                            // We will just cap at currentBankroll.
                            if (stake > currentBankroll) stake = currentBankroll;

                            if (stake > 0) {
                                executedBets.push({
                                    runner: bet.runner,
                                    type: bet.type,
                                    odds: bet.odds,
                                    stake: stake, // Risk Amount
                                    profit: profit,
                                    won: won
                                });

                                // Update Bankroll immediately? Or after race?
                                // "Priority given to biggest edge". This implies we use funds for best bets first.
                                // So we deduct from 'available' currentBankroll.
                                // BUT we add profit back only after race?
                                // Let's simulate sequential allocation.
                                // We deduct the RISK (stake) from currentBankroll immediately so next bet has less.
                                // If we win, we add (Stake + Profit) back.
                                // If we lose, we add nothing (Stake is gone).

                                currentBankroll -= stake; // Deduct risk
                                if (profit > 0) {
                                    // Win: Get back risk + profit
                                    // Lay Win: Risk (Liability) was "held", we get it back + profit.
                                    // Back Win: Stake was paid, we get Stake + Profit.
                                    // Math: currentBankroll = (current - Stake) + Stake + Profit = current + Profit.
                                    // So just add (Stake + Profit) to the reduced bankroll.

                                    // Actually, simpler:
                                    // Bankroll is updated by Profit at end.
                                    // But for staking calc of NEXT horse in SAME race, should we reduce?
                                    // Yes, to respect "Priority".

                                    // Deferred update for "Winning" part, immediate update for "Risking" part.
                                    raceNetProfit += profit;
                                } else {
                                    // Loss: Risk is gone.
                                    raceNetProfit += profit; // Profit is negative (-stake)
                                }

                                if (won) winCount++; else lossCount++;
                                totalBets++;
                            }
                        });

                        // End of Race Re-conciliation
                        // We deducted stakes as we went. Now we add back the Returns (Stake + Profit) for winners?
                        // Wait, my logic above: `currentBankroll -= stake`.
                        // If Win: `profit` is positive net gain. Return = Stake + Profit.
                        // If Lose: `profit` is -stake. Return = 0.
                        // So correct update after race is:
                        // We already subtracted stakes. Now add back Returns.

                        executedBets.forEach(b => {
                            if (b.profit > 0) {
                                // We won. We get back our Risk (Stake) + Net Profit.
                                currentBankroll += (b.stake + b.profit);
                            }
                            // If lost, we get back nothing. Stake remains deducted.
                        });

                        // Update Race Row UI
                        // Summary Cells
                        const profitCell = row.querySelector('.race-profit-cell');
                        const bankrollCell = row.querySelector('.race-bankroll-cell');
                        const betsCountCell = row.querySelector('.race-bets-count-cell');
                        const outcomeCell = row.querySelector('.race-outcome-cell');

                        profitCell.textContent = raceNetProfit.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                        if (raceNetProfit > 0) profitCell.classList.add('text-success'); else if (raceNetProfit < 0) profitCell.classList.add('text-danger'); else profitCell.classList.remove('text-success', 'text-danger');

                        bankrollCell.textContent = currentBankroll.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                        betsCountCell.textContent = executedBets.length;

                        // Check if Predicted Winner Won (for AI Accuracy stat only)
                        const predWinner = runners.find(r => r.HorseName === predictedWinnerName);
                        if (predWinner && predWinner.IsWinner) {
                            correctPredictions++;
                            outcomeCell.textContent = "AI Winner";
                            outcomeCell.classList.add('text-success');
                        } else {
                            outcomeCell.textContent = "AI Lost";
                            outcomeCell.classList.remove('text-success');
                        }

                        // Update Details Table
                        const detailsBody = detailsRow.querySelector('.bets-details-body');
                        detailsBody.innerHTML = ''; // Clear previous

                        if (executedBets.length === 0) {
                            detailsBody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No bets placed meeting criteria.</td></tr>';
                        } else {
                            executedBets.forEach(b => {
                                const tr = document.createElement('tr');
                                tr.innerHTML = `
                                    <td>${b.runner.HorseName}</td>
                                    <td><span class="badge ${b.type === 'Back' ? 'bg-success' : 'bg-danger'}">${b.type}</span></td>
                                    <td>${b.odds.toFixed(2)}</td>
                                    <td>${b.stake.toLocaleString('en-US', { style: 'currency', currency: 'USD' })}</td>
                                    <td class="${b.won ? 'text-success' : 'text-danger'}">${b.won ? 'Win' : 'Loss'}</td>
                                    <td class="${b.profit >= 0 ? 'text-success' : 'text-danger'}">${b.profit.toLocaleString('en-US', { style: 'currency', currency: 'USD' })}</td>
                                `;
                                detailsBody.appendChild(tr);
                            });
                        }

                        totalStaked += raceStaked;
                    });

                    // --- 3. Update Global Summary ---
                    const finalProfit = currentBankroll - startingBankroll;
                    const roi = totalStaked > 0 ? (finalProfit / totalStaked) : 0;
                    const accuracy = visibleRaceCount > 0 ? (correctPredictions / visibleRaceCount) : 0;

                    document.getElementById('summary-validation-races').textContent = visibleRaceCount;
                    document.getElementById('summary-validation-accuracy').textContent = accuracy.toLocaleString('en-US', { style: 'percent', minimumFractionDigits: 2 });
                    document.getElementById('summary-ending-bankroll').textContent = currentBankroll.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                    document.getElementById('summary-profit').textContent = finalProfit.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                    document.getElementById('summary-total-staked').textContent = totalStaked.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                    document.getElementById('summary-roi').textContent = roi.toLocaleString('en-US', { style: 'percent', minimumFractionDigits: 2 });
                    document.getElementById('summary-bets-placed').textContent = `${totalBets} (Wins: ${winCount}, Losses: ${lossCount})`;
                });
            }
        });
    </script>
}
