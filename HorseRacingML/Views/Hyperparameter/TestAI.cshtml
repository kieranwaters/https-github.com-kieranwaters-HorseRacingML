@model HorseRacingML.Models.AITestResultViewModel

@{
    ViewData["Title"] = "Test AI";
}

<h1>Test AI</h1>
<p>
    Run an evaluation by either retraining the AI model or using the latest pre-trained model weights.
    When retraining, the model is trained on all available historical data, excluding the selected validation window,
    and then its accuracy is calculated against the races within that window. Alternatively, you can
    skip retraining and directly evaluate the performance of the latest saved model on the chosen
    validation window.
</p>

<form asp-action="TestAI" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (Model.RequestedUnits.HasValue)
    {
        <input asp-for="RequestedUnits" type="hidden" />
    }
    @if (Model.RequestedDropout.HasValue)
    {
        <input asp-for="RequestedDropout" type="hidden" />
    }
    @if (Model.RequestedLayers.HasValue)
    {
        <input asp-for="RequestedLayers" type="hidden" />
    }
    @if (Model.RequestedLearningRate.HasValue)
    {
        <input asp-for="RequestedLearningRate" type="hidden" />
    }
    @if (Model.RequestedEpochs.HasValue)
    {
        <input asp-for="RequestedEpochs" type="hidden" />
    }
    @if (Model.RequestedBatchSize.HasValue)
    {
        <input asp-for="RequestedBatchSize" type="hidden" />
    }
    @if (Model.RequestedFolds.HasValue)
    {
        <input asp-for="RequestedFolds" type="hidden" />
    }
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label asp-for="SelectedValidationMonths" class="form-label">Validation window</label>
            <select asp-for="SelectedValidationMonths" class="form-select">
                @for (int months = 1; months <= 24; months++)
                {
                    <option value="@months">@months @(months == 1 ? "month" : "months")</option>
                }
            </select>
            <span asp-validation-for="SelectedValidationMonths" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="SelectedCountry" class="form-label">Country</label>
            <select asp-for="SelectedCountry" class="form-select">
                <option value="">All Countries</option>
                @foreach (var country in Model.Countries)
                {
                    <option value="@country">@country</option>
                }
            </select>
            <span asp-validation-for="SelectedCountry" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="StartingBankroll" class="form-label">Starting bankroll</label>
            <input asp-for="StartingBankroll" class="form-control" type="number" min="0" step="0.01" />
            <span asp-validation-for="StartingBankroll" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="KellyDampener" class="form-label">Kelly dampener</label>
            <input asp-for="KellyDampener" class="form-control" type="number" min="1" step="1" />
            <span asp-validation-for="KellyDampener" class="text-danger"></span>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check mb-3">
                <input asp-for="UseExistingWeights" class="form-check-input" type="checkbox" />
                <label asp-for="UseExistingWeights" class="form-check-label">Use latest weights (skip retraining)</label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Test AI</button>
</form>
@if (Model.DailyResults != null && Model.DailyResults.Any())
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Race by Race Results</h5>
            @foreach (var day in Model.DailyResults)
            {
                <h6>@day.RaceDate.ToString("yyyy-MM-dd")</h6>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Race</th>
                            <th>Predicted Winner</th>
                            <th>Actual Winner</th>
                            <th>Result</th>
                            <th>Stake</th>
                            <th>AI Odds</th>
                            <th>Bookmaker Odds</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var race in day.Races)
                        {
                            <tr>
                                <td>@race.RaceTitle</td>
                                <td>@race.PredictedWinner</td>
                                <td>@race.ActualWinner</td>
                                <td>@(race.IsCorrectPrediction ? "Correct" : "Incorrect")</td>
                                <td>@race.Bankroll.ToString("C")</td>
                                <td>@race.Stake.ToString("C")</td>
                                <td>@race.AiOdds.ToString("0.00")</td>
                                <td>@race.BookmakerOdds.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}


@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info mt-3" role="alert">@Model.Message</div>
}

@if (Model.RequestedUnits.HasValue || Model.RequestedDropout.HasValue || Model.RequestedLayers.HasValue || Model.RequestedLearningRate.HasValue || Model.RequestedEpochs.HasValue || Model.RequestedBatchSize.HasValue || Model.RequestedFolds.HasValue)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Requested hyperparameters</h5>
            <ul class="mb-0">
                @if (Model.RequestedLayers.HasValue)
                {
                    <li>Layers: @Model.RequestedLayers</li>
                }
                @if (Model.RequestedUnits.HasValue)
                {
                    <li>Units per Layer: @Model.RequestedUnits</li>
                }
                @if (Model.RequestedDropout.HasValue)
                {
                    <li>Dropout: @Model.RequestedDropout</li>
                }
                @if (Model.RequestedLearningRate.HasValue)
                {
                    <li>Learning Rate: @Model.RequestedLearningRate</li>
                }
                @if (Model.RequestedEpochs.HasValue)
                {
                    <li>Epochs: @Model.RequestedEpochs</li>
                }
                @if (Model.RequestedBatchSize.HasValue)
                {
                    <li>Batch Size: @Model.RequestedBatchSize</li>
                }
                @if (Model.RequestedFolds.HasValue)
                {
                    <li>Folds: @Model.RequestedFolds</li>
                }
            </ul>
        </div>
    </div>
}

@if (Model.HasResult)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Results</h5>
            <dl class="row">
                <dt class="col-sm-4">Validation window</dt>
                <dd class="col-sm-8">
                    @Model.ValidationStart.ToString("yyyy-MM-dd") &ndash; @Model.ValidationEnd.ToString("yyyy-MM-dd")
                </dd>
                <dt class="col-sm-4">Validation races</dt>
                <dd class="col-sm-8">@Model.ValidationRaceCount</dd>
                <dt class="col-sm-4">Training races</dt>
                <dd class="col-sm-8">@Model.TrainingRaceCount</dd>
                <dt class="col-sm-4">Validation accuracy</dt>
                <dd class="col-sm-8">@Model.ValidationAccuracy?.ToString("P2")</dd>
                <dt class="col-sm-4">Training accuracy</dt>
                <dd class="col-sm-8">@Model.TrainAccuracy?.ToString("P2")</dd>
                <dt class="col-sm-4">Validation loss</dt>
                <dd class="col-sm-8">@Model.ValidationLoss?.ToString("F4")</dd>
                <dt class="col-sm-4">Training loss</dt>
                <dd class="col-sm-8">@Model.TrainLoss?.ToString("F4")</dd>
                <dt class="col-sm-4">Validation Brier score</dt>
                <dd class="col-sm-8">@Model.ValidationBrier?.ToString("F4")</dd>
                <dt class="col-sm-4">Training Brier score</dt>
                <dd class="col-sm-8">@Model.TrainBrier?.ToString("F4")</dd>
                <dt class="col-sm-4">Validation Focal loss</dt>
                <dd class="col-sm-8">@Model.ValidationFocalLoss?.ToString("F4")</dd>
                <dt class="col-sm-4">Training Focal loss</dt>
                <dd class="col-sm-8">@Model.TrainFocalLoss?.ToString("F4")</dd>
            </dl>

            @if (Model.ParameterUsed != null)
            {
                <h6>Parameters Used</h6>
                <ul>
                    <li>Layers: @Model.ParameterUsed.Layers</li>
                    <li>Units per Layer: @Model.ParameterUsed.Units</li>
                    <li>Dropout: @Model.ParameterUsed.Dropout</li>
                    <li>Learning Rate: @Model.ParameterUsed.LearningRate</li>
                    <li>Epochs: @Model.ParameterUsed.Epochs</li>
                    <li>Batch Size: @Model.ParameterUsed.BatchSize</li>
                    @if (Model.ParameterUsed.Folds > 0)
                    {
                        <li>Folds: @Model.ParameterUsed.Folds</li>
                    }
                </ul>
            }
        </div>
    </div>
}
@if (Model.Simulation != null)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Validation simulation</h5>
            <dl class="row">
                <dt class="col-sm-4">Starting bankroll</dt>
                <dd class="col-sm-8">@Model.Simulation.StartingBankroll.ToString("C")</dd>
                <dt class="col-sm-4">Ending bankroll</dt>
                <dd class="col-sm-8">@Model.Simulation.EndingBankroll.ToString("C")</dd>
                <dt class="col-sm-4">Profit</dt>
                <dd class="col-sm-8">@Model.Simulation.Profit.ToString("C")</dd>
                <dt class="col-sm-4">Total staked</dt>
                <dd class="col-sm-8">@Model.Simulation.TotalStaked.ToString("C")</dd>
                <dt class="col-sm-4">ROI</dt>
                <dd class="col-sm-8">@Model.Simulation.Roi.ToString("P2")</dd>
                <dt class="col-sm-4">Bets placed</dt>
                <dd class="col-sm-8">@Model.Simulation.BetCount (Wins: @Model.Simulation.WinCount, Losses: @Model.Simulation.LossCount)</dd>
            </dl>

            @if (Model.Simulation.Bets != null && Model.Simulation.Bets.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">Race</th>
                                <th scope="col">Date</th>
                                <th scope="col">Horse</th>
                                <th scope="col">AI prob</th>
                                <th scope="col">Market prob</th>
                                <th scope="col">Differential</th>
                                <th scope="col">Market Odds</th>
                                <th scope="col">AI Odds</th>
                                <th scope="col">Odds</th>
                                <th scope="col">Market Odds</th>
                                <th scope="col">AI Odds</th>
                                <th scope="col">Stake</th>
                                <th scope="col">Profit</th>
                                <th scope="col">Bankroll after</th>
                                <th scope="col">Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bet in Model.Simulation.Bets)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(bet.RaceTitle) ? $"Race {bet.RaceId}" : bet.RaceTitle)</td>
                                    <td>@bet.RaceDate?.ToString("yyyy-MM-dd")</td>
                                    <td>@(string.IsNullOrWhiteSpace(bet.HorseName) ? "—" : bet.HorseName)</td>
                                    <td>@bet.AiProbability.ToString("P2")</td>
                                    <td>@bet.MarketProbability.ToString("P2")</td>
                                    <td>@bet.Differential.ToString("P2")</td>
                                    <td>@bet.DecimalOdds.ToString("0.00")</td>
                                    <td>@bet.AiDecimalOdds.ToString("0.00")</td>
                                    <td>@bet.DecimalOdds.ToString("0.00")</td>
                                    <td>@bet.Stake.ToString("C")</td>
                                    <td class="@(bet.Profit >= 0 ? "text-success" : "text-danger")">@bet.Profit.ToString("C")</td>
                                    <td>@bet.Bankroll.ToString("C")</td>
                                    <td>@(bet.Won ? "Win" : "Loss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No qualifying bets were identified during the validation window.</p>
            }
        </div>
    </div>
}

<a asp-action="TrainAI" class="btn btn-link mt-3">Back to Train AI</a>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}