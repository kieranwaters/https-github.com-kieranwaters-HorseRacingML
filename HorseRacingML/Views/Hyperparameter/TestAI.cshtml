@if (Model.HasResult)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Results</h5>
            <dl class="row">
                <dt class="col-sm-4">Validation window</dt>
                <dd class="col-sm-8">
                    @Model.ValidationStart.ToString("yyyy-MM-dd") &ndash; @Model.ValidationEnd.ToString("yyyy-MM-dd")
