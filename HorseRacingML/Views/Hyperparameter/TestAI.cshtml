@model HorseRacingML.Models.AITestResultViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Test AI";
}

<h1>Test AI</h1>
<p>
    Run an evaluation by either retraining the AI model or using the latest pre-trained model weights.
    When retraining, the model is trained on all available historical data, excluding the selected validation window,
    and then its accuracy is calculated against the races within that window. Alternatively, you can
    skip retraining and directly evaluate the performance of the latest saved model on the chosen
    validation window.
</p>

<form asp-action="TestAI" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (Model.RequestedUnits.HasValue)
    {
        <input asp-for="RequestedUnits" type="hidden" />
    }
    @if (Model.RequestedDropout.HasValue)
    {
        <input asp-for="RequestedDropout" type="hidden" />
    }
    @if (Model.RequestedLayers.HasValue)
    {
        <input asp-for="RequestedLayers" type="hidden" />
    }
    @if (Model.RequestedLearningRate.HasValue)
    {
        <input asp-for="RequestedLearningRate" type="hidden" />
    }
    @if (Model.RequestedEpochs.HasValue)
    {
        <input asp-for="RequestedEpochs" type="hidden" />
    }
    @if (Model.RequestedBatchSize.HasValue)
    {
        <input asp-for="RequestedBatchSize" type="hidden" />
    }
    @if (Model.RequestedFolds.HasValue)
    {
        <input asp-for="RequestedFolds" type="hidden" />
    }
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label asp-for="SelectedValidationMonths" class="form-label">Validation window</label>
            <select asp-for="SelectedValidationMonths" class="form-select">
                @for (int months = 1; months <= 24; months++)
                {
                    <option value="@months">@months @(months == 1 ? "month" : "months")</option>
                }
            </select>
            <span asp-validation-for="SelectedValidationMonths" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="SelectedCountry" class="form-label">Country</label>
            <select asp-for="SelectedCountry" class="form-select">
                <option value="">All Countries</option>
                @foreach (var country in Model.Countries)
                {
                    <option value="@country">@country</option>
                }
            </select>
            <span asp-validation-for="SelectedCountry" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="StartingBankroll" class="form-label">Starting bankroll</label>
            <input asp-for="StartingBankroll" class="form-control" type="number" min="0" step="0.01" />
            <span asp-validation-for="StartingBankroll" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="KellyDampener" class="form-label">Kelly dampener</label>
            <input asp-for="KellyDampener" class="form-control" type="number" min="1" step="1" />
            <span asp-validation-for="KellyDampener" class="text-danger"></span>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check mb-3">
                <input asp-for="UseExistingWeights" class="form-check-input" type="checkbox" />
                <label asp-for="UseExistingWeights" class="form-check-label">Use latest weights (skip retraining)</label>
            </div>
        </div>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check mb-3">
            <input asp-for="UseHybrid" class="form-check-input" type="checkbox" />
            <label asp-for="UseHybrid" class="form-check-label">Use Hybrid Model (NN + LightGBM)</label>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label for="min-starts-filter" class="form-label">Minimum Career Starts</label>
            <select id="min-starts-filter" class="form-select">
                @for (int i = 0; i <= 100; i++)
                {
                    <option value="@i">@i</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="max-runners-filter" class="form-label">Maximum Runners</label>
            <select id="max-runners-filter" class="form-select">
                @for (int i = 0; i <= 100; i++)
                {
                    <option value="@i" selected="@(i == 100 ? "selected" : null)">@i</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="min-edge-filter" class="form-label">Min Edge % (AI Favorite)</label>
            <input type="number" id="min-edge-filter" class="form-control" value="-100" step="0.1" />
        </div>
        <div class="col-md-3">
            <label for="min-other-edge-filter" class="form-label">Min Edge % (Other Runners)</label>
            <input type="number" id="min-other-edge-filter" class="form-control" value="100" step="0.1" />
        </div>
        <div class="col-md-3">
            <label for="min-lay-edge-fav-filter" class="form-label">Min Edge % (Lay AI Favorite)</label>
            <input type="number" id="min-lay-edge-fav-filter" class="form-control" value="100" step="0.1" />
        </div>
        <div class="col-md-3">
            <label for="min-lay-edge-filter" class="form-label">Min Edge % (Lay Others)</label>
            <input type="number" id="min-lay-edge-filter" class="form-control" value="100" step="0.1" />
        </div>
        <div class="col-md-3">
            <label for="min-roi-filter" class="form-label">Min ROI % (AI Favorite)</label>
            <input type="number" id="min-roi-filter" class="form-control" value="-100" step="0.1" />
        </div>
        <div class="col-md-3">
            <label for="min-other-roi-filter" class="form-label">Min ROI % (Other Runners)</label>
            <input type="number" id="min-other-roi-filter" class="form-control" value="100" step="0.1" />
        </div>
        <div class="col-md-3">
            <label for="min-lay-roi-fav-filter" class="form-label">Min ROI % (Lay AI Favorite)</label>
            <input type="number" id="min-lay-roi-fav-filter" class="form-control" value="100" step="0.1" />
        </div>
        <div class="col-md-3">
            <label for="min-lay-roi-filter" class="form-label">Min ROI % (Lay Others)</label>
            <input type="number" id="min-lay-roi-filter" class="form-control" value="100" step="0.1" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check mb-3 me-3">
                <input id="include-fees-checkbox" class="form-check-input" type="checkbox" />
                <label for="include-fees-checkbox" class="form-check-label">Include 2% Commission</label>
            </div>
            <button type="button" id="apply-filters-btn" class="btn btn-secondary">Apply Filters</button>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Test AI</button>
</form>

@if (Model.HasResult)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Summary</h5>
            <dl class="row">
                <dt class="col-sm-4">Validation races</dt>
                <dd class="col-sm-8" id="summary-validation-races">@Model.ValidationRaceCount</dd>
                <dt class="col-sm-4">Validation accuracy</dt>
                <dd class="col-sm-8" id="summary-validation-accuracy">@Model.ValidationAccuracy?.ToString("P2")</dd>
                @if (Model.Simulation != null)
                {
                    <dt class="col-sm-4">Ending bankroll</dt>
                    <dd class="col-sm-8" id="summary-ending-bankroll">@Model.Simulation.EndingBankroll.ToString("C")</dd>
                    <dt class="col-sm-4">Profit</dt>
                    <dd class="col-sm-8" id="summary-profit">@Model.Simulation.Profit.ToString("C")</dd>
                    <dt class="col-sm-4">Total staked</dt>
                    <dd class="col-sm-8" id="summary-total-staked">@Model.Simulation.TotalStaked.ToString("C")</dd>
                    <dt class="col-sm-4">ROI</dt>
                    <dd class="col-sm-8" id="summary-roi">@Model.Simulation.Roi.ToString("P2")</dd>
                    <dt class="col-sm-4">Bets placed</dt>
                    <dd class="col-sm-8" id="summary-bets-placed">@Model.Simulation.BetCount (Wins: @Model.Simulation.WinCount, Losses: @Model.Simulation.LossCount)</dd>
                }
            </dl>
        </div>
    </div>
}

@if (Model.DailyResults != null && Model.DailyResults.Any())
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Race by Race Results</h5>
            @foreach (var day in Model.DailyResults)
            {
                <h6>@day.RaceDate.ToString("yyyy-MM-dd")</h6>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Race</th>
                            <th>Predicted Winner</th>
                            <th>Actual Winner</th>
                            <th>Result</th>
                            <th>Bankroll</th>
                            <th>Net Profit</th>
                            <th>Bets</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var race in day.Races)
                        {
                            var runnerCount = race.Runners?.Count() ?? 0;
                            var runnerStarts = race.Runners != null ? string.Join(",", race.Runners.Select(r => r.HistoricalRaceCount ?? 0)) : "";
                            var runnersJson = JsonSerializer.Serialize(race.Runners);

                            <tr class="race-row clickable-row"
                                data-runner-count="@runnerCount"
                                data-runner-starts="@runnerStarts"
                                data-predicted-winner="@race.PredictedWinner"
                                data-runners="@runnersJson">
                                <td>@race.RaceTitle</td>
                                <td>@race.PredictedWinner</td>
                                <td>@race.ActualWinner</td>
                                <td class="race-outcome-cell">@(race.IsCorrectPrediction ? "Correct" : "Incorrect")</td>
                                <td class="race-bankroll-cell">@race.Bankroll.ToString("C")</td>
                                <td class="race-profit-cell">@(((race.IsCorrectPrediction ? (race.Stake * (race.BookmakerOdds - 1)) : -race.Stake)).ToString("C"))</td>
                                <td class="race-bets-count-cell">1</td>
                            </tr>
                            <tr class="race-details hidden">
                                <td colspan="8">
                                    <div class="p-3">
                                        <table class="table table-sm table-bordered table-dark mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Horse Name</th>
                                                    <th>Type</th>
                                                    <th>Bookie Odds</th>
                                                    <th>AI Odds</th>
                                                    <th>Edge</th>
                                                    <th>Stake</th>
                                                    <th>Result</th>
                                                    <th>Profit</th>
                                                </tr>
                                            </thead>
                                            <tbody class="bets-details-body">
                                                <!-- Populated by JS -->
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}


@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info mt-3" role="alert">@Model.Message</div>
}

@if (Model.RequestedUnits.HasValue || Model.RequestedDropout.HasValue || Model.RequestedLayers.HasValue || Model.RequestedLearningRate.HasValue || Model.RequestedEpochs.HasValue || Model.RequestedBatchSize.HasValue || Model.RequestedFolds.HasValue)
