@model HorseRacingML.Models.AITestResultViewModel

@{
    ViewData["Title"] = "Test AI";
}

<h1>Test AI</h1>
<p>
    Run an evaluation by either retraining the AI model or using the latest pre-trained model weights.
    When retraining, the model is trained on all available historical data, excluding the selected validation window,
    and then its accuracy is calculated against the races within that window. Alternatively, you can
    skip retraining and directly evaluate the performance of the latest saved model on the chosen
    validation window.
</p>

<form asp-action="TestAI" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (Model.RequestedUnits.HasValue)
    {
        <input asp-for="RequestedUnits" type="hidden" />
    }
    @if (Model.RequestedDropout.HasValue)
    {
        <input asp-for="RequestedDropout" type="hidden" />
    }
    @if (Model.RequestedLayers.HasValue)
    {
        <input asp-for="RequestedLayers" type="hidden" />
    }
    @if (Model.RequestedLearningRate.HasValue)
    {
        <input asp-for="RequestedLearningRate" type="hidden" />
    }
    @if (Model.RequestedEpochs.HasValue)
    {
        <input asp-for="RequestedEpochs" type="hidden" />
    }
    @if (Model.RequestedBatchSize.HasValue)
    {
        <input asp-for="RequestedBatchSize" type="hidden" />
    }
    @if (Model.RequestedFolds.HasValue)
    {
        <input asp-for="RequestedFolds" type="hidden" />
    }
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label asp-for="SelectedValidationMonths" class="form-label">Validation window</label>
            <select asp-for="SelectedValidationMonths" class="form-select">
                @for (int months = 1; months <= 24; months++)
                {
                    <option value="@months">@months @(months == 1 ? "month" : "months")</option>
                }
            </select>
            <span asp-validation-for="SelectedValidationMonths" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="SelectedCountry" class="form-label">Country</label>
            <select asp-for="SelectedCountry" class="form-select">
                <option value="">All Countries</option>
                @foreach (var country in Model.Countries)
                {
                    <option value="@country">@country</option>
                }
            </select>
            <span asp-validation-for="SelectedCountry" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="StartingBankroll" class="form-label">Starting bankroll</label>
            <input asp-for="StartingBankroll" class="form-control" type="number" min="0" step="0.01" />
            <span asp-validation-for="StartingBankroll" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="KellyDampener" class="form-label">Kelly dampener</label>
            <input asp-for="KellyDampener" class="form-control" type="number" min="1" step="1" />
            <span asp-validation-for="KellyDampener" class="text-danger"></span>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check mb-3">
                <input asp-for="UseExistingWeights" class="form-check-input" type="checkbox" />
                <label asp-for="UseExistingWeights" class="form-check-label">Use latest weights (skip retraining)</label>
            </div>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label for="min-starts-filter" class="form-label">Minimum Career Starts</label>
            <select id="min-starts-filter" class="form-select">
                @for (int i = 0; i <= 100; i++)
                {
                    <option value="@i">@i</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="max-runners-filter" class="form-label">Maximum Runners</label>
            <select id="max-runners-filter" class="form-select">
                @for (int i = 0; i <= 100; i++)
                {
                    <option value="@i" selected="@(i == 100 ? "selected" : null)">@i</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="button" id="apply-filters-btn" class="btn btn-secondary">Apply Filters</button>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Test AI</button>
</form>
@if (Model.DailyResults != null && Model.DailyResults.Any())
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Race by Race Results</h5>
            @foreach (var day in Model.DailyResults)
            {
                <h6>@day.RaceDate.ToString("yyyy-MM-dd")</h6>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Race</th>
                            <th>Predicted Winner</th>
                            <th>Actual Winner</th>
                            <th>Result</th>
                            <th>Bankroll</th>
                            <th>Stake</th>
                            <th>AI Odds</th>
                            <th>Bookmaker Odds</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var race in day.Races)
                        {
                            var runnerCount = race.Runners?.Count() ?? 0;
                            var runnerStarts = race.Runners != null ? string.Join(",", race.Runners.Select(r => r.HistoricalRaceCount ?? 0)) : "";
                            var profit = race.IsCorrectPrediction ? (race.Stake * (race.BookmakerOdds - 1)) : -race.Stake;
                            <tr class="race-row clickable-row" data-runner-count="@runnerCount" data-runner-starts="@runnerStarts" data-is-correct="@race.IsCorrectPrediction" data-bankroll="@race.Bankroll" data-stake="@race.Stake" data-profit="@profit">
                                <td>@race.RaceTitle</td>
                                <td>@race.PredictedWinner</td>
                                <td>@race.ActualWinner</td>
                                <td>@(race.IsCorrectPrediction ? "Correct" : "Incorrect")</td>
                                <td>@race.Bankroll.ToString("C")</td>
                                <td>@race.Stake.ToString("C")</td>
                                <td>@race.AiOdds.ToString("0.00")</td>
                                <td>@race.BookmakerOdds.ToString("0.00")</td>
                            </tr>
                            <tr class="race-details hidden">
                                <td colspan="8">
                                    <div class="p-3">
                                        <table class="table table-sm table-bordered table-dark mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Horse Name</th>
                                                    <th>Historical Races</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (race.Runners != null)
                                                {
                                                    @foreach (var runner in race.Runners)
                                                    {
                                                        <tr>
                                                            <td>@runner.HorseName</td>
                                                            <td>@(runner.HistoricalRaceCount.HasValue? runner.HistoricalRaceCount.Value.ToString() : "N/A")</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}


@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info mt-3" role="alert">@Model.Message</div>
}

@if (Model.RequestedUnits.HasValue || Model.RequestedDropout.HasValue || Model.RequestedLayers.HasValue || Model.RequestedLearningRate.HasValue || Model.RequestedEpochs.HasValue || Model.RequestedBatchSize.HasValue || Model.RequestedFolds.HasValue)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Requested hyperparameters</h5>
            <ul class="mb-0">
                @if (Model.RequestedLayers.HasValue)
                {
                    <li>Layers: @Model.RequestedLayers</li>
                }
                @if (Model.RequestedUnits.HasValue)
                {
                    <li>Units per Layer: @Model.RequestedUnits</li>
                }
                @if (Model.RequestedDropout.HasValue)
                {
                    <li>Dropout: @Model.RequestedDropout</li>
                }
                @if (Model.RequestedLearningRate.HasValue)
                {
                    <li>Learning Rate: @Model.RequestedLearningRate</li>
                }
                @if (Model.RequestedEpochs.HasValue)
                {
                    <li>Epochs: @Model.RequestedEpochs</li>
                }
                @if (Model.RequestedBatchSize.HasValue)
                {
                    <li>Batch Size: @Model.RequestedBatchSize</li>
                }
                @if (Model.RequestedFolds.HasValue)
                {
                    <li>Folds: @Model.RequestedFolds</li>
                }
            </ul>
        </div>
    </div>
}

@if (Model.HasResult)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Results</h5>
            <dl class="row">
                <dt class="col-sm-4">Validation window</dt>
                <dd class="col-sm-8">
                    @Model.ValidationStart.ToString("yyyy-MM-dd") &ndash; @Model.ValidationEnd.ToString("yyyy-MM-dd")
                </dd>
                <dt class="col-sm-4">Validation races</dt>
                <dd class="col-sm-8" id="summary-validation-races">@Model.ValidationRaceCount</dd>
                <dt class="col-sm-4">Training races</dt>
                <dd class="col-sm-8">@Model.TrainingRaceCount</dd>
                <dt class="col-sm-4">Validation accuracy</dt>
                <dd class="col-sm-8" id="summary-validation-accuracy">@Model.ValidationAccuracy?.ToString("P2")</dd>
                <dt class="col-sm-4">Training accuracy</dt>
                <dd class="col-sm-8">@Model.TrainAccuracy?.ToString("P2")</dd>
                <dt class="col-sm-4">Validation loss</dt>
                <dd class="col-sm-8">@Model.ValidationLoss?.ToString("F4")</dd>
                <dt class="col-sm-4">Training loss</dt>
                <dd class="col-sm-8">@Model.TrainLoss?.ToString("F4")</dd>
                <dt class="col-sm-4">Validation Brier score</dt>
                <dd class="col-sm-8">@Model.ValidationBrier?.ToString("F4")</dd>
                <dt class="col-sm-4">Training Brier score</dt>
                <dd class="col-sm-8">@Model.TrainBrier?.ToString("F4")</dd>
                <dt class="col-sm-4">Validation Focal loss</dt>
                <dd class="col-sm-8">@Model.ValidationFocalLoss?.ToString("F4")</dd>
                <dt class="col-sm-4">Training Focal loss</dt>
                <dd class="col-sm-8">@Model.TrainFocalLoss?.ToString("F4")</dd>
            </dl>

            @if (Model.ParameterUsed != null)
            {
                <h6>Parameters Used</h6>
                <ul>
                    <li>Layers: @Model.ParameterUsed.Layers</li>
                    <li>Units per Layer: @Model.ParameterUsed.Units</li>
                    <li>Dropout: @Model.ParameterUsed.Dropout</li>
                    <li>Learning Rate: @Model.ParameterUsed.LearningRate</li>
                    <li>Epochs: @Model.ParameterUsed.Epochs</li>
                    <li>Batch Size: @Model.ParameterUsed.BatchSize</li>
                    @if (Model.ParameterUsed.Folds > 0)
                    {
                        <li>Folds: @Model.ParameterUsed.Folds</li>
                    }
                </ul>
            }
        </div>
    </div>
}
@if (Model.Simulation != null)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Validation simulation</h5>
            <dl class="row">
                <dt class="col-sm-4">Starting bankroll</dt>
                <dd class="col-sm-8">@Model.Simulation.StartingBankroll.ToString("C")</dd>
                <dt class="col-sm-4">Ending bankroll</dt>
                <dd class="col-sm-8" id="summary-ending-bankroll">@Model.Simulation.EndingBankroll.ToString("C")</dd>
                <dt class="col-sm-4">Profit</dt>
                <dd class="col-sm-8" id="summary-profit">@Model.Simulation.Profit.ToString("C")</dd>
                <dt class="col-sm-4">Total staked</dt>
                <dd class="col-sm-8" id="summary-total-staked">@Model.Simulation.TotalStaked.ToString("C")</dd>
                <dt class="col-sm-4">ROI</dt>
                <dd class="col-sm-8" id="summary-roi">@Model.Simulation.Roi.ToString("P2")</dd>
                <dt class="col-sm-4">Bets placed</dt>
                <dd class="col-sm-8" id="summary-bets-placed">@Model.Simulation.BetCount (Wins: @Model.Simulation.WinCount, Losses: @Model.Simulation.LossCount)</dd>
            </dl>

            @if (Model.Simulation.Bets != null && Model.Simulation.Bets.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">Race</th>
                                <th scope="col">Date</th>
                                <th scope="col">Horse</th>
                                <th scope="col">AI prob</th>
                                <th scope="col">Market prob</th>
                                <th scope="col">Differential</th>
                                <th scope="col">Market Odds</th>
                                <th scope="col">AI Odds</th>
                                <th scope="col">Odds</th>
                                <th scope="col">Market Odds</th>
                                <th scope="col">AI Odds</th>
                                <th scope="col">Stake</th>
                                <th scope="col">Profit</th>
                                <th scope="col">Bankroll after</th>
                                <th scope="col">Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bet in Model.Simulation.Bets)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(bet.RaceTitle) ? $"Race {bet.RaceId}" : bet.RaceTitle)</td>
                                    <td>@bet.RaceDate?.ToString("yyyy-MM-dd")</td>
                                    <td>@(string.IsNullOrWhiteSpace(bet.HorseName) ? "—" : bet.HorseName)</td>
                                    <td>@bet.AiProbability.ToString("P2")</td>
                                    <td>@bet.MarketProbability.ToString("P2")</td>
                                    <td>@bet.Differential.ToString("P2")</td>
                                    <td>@bet.DecimalOdds.ToString("0.00")</td>
                                    <td>@bet.AiDecimalOdds.ToString("0.00")</td>
                                    <td>@bet.DecimalOdds.ToString("0.00")</td>
                                    <td>@bet.Stake.ToString("C")</td>
                                    <td class="@(bet.Profit >= 0 ? "text-success" : "text-danger")">@bet.Profit.ToString("C")</td>
                                    <td>@bet.Bankroll.ToString("C")</td>
                                    <td>@(bet.Won ? "Win" : "Loss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No qualifying bets were identified during the validation window.</p>
            }
        </div>
    </div>
}

<a asp-action="TrainAI" class="btn btn-link mt-3">Back to Train AI</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const raceRows = document.querySelectorAll('.clickable-row');

            raceRows.forEach(row => {
                row.addEventListener('click', function () {
                    const detailsRow = this.nextElementSibling;
                    if (detailsRow && detailsRow.classList.contains('race-details')) {
                        detailsRow.classList.toggle('hidden');
                    }
                });
            });

            // Pass the simulation data safely as a JSON object
            // If simulation is null, this variable becomes null in JS
            const simulationConfig = @Json.Serialize(Model.Simulation != null
                            ? new { startingBankroll = Model.Simulation.StartingBankroll }
                            : null);

        if (simulationConfig) {
            const applyFiltersBtn = document.getElementById('apply-filters-btn');

                applyFiltersBtn.addEventListener('click', function () {
                    const minStarts = parseInt(document.getElementById('min-starts-filter').value, 10);
                    const maxRunners = parseInt(document.getElementById('max-runners-filter').value, 10);
                    const allRaceRows = document.querySelectorAll('.race-row');

                    // Step 1: Determine visibility for all rows
                    const visibleRows = [];
                    allRaceRows.forEach(row => {
                        const runnerCount = parseInt(row.dataset.runnerCount, 10);
                        const runnerStarts = row.dataset.runnerStarts.split(',').map(s => parseInt(s, 10));

                        // Razor won't complain here anymore because we aren't inside <text>
                        const meetsMinStarts = !runnerStarts.some(starts => starts < minStarts);
                        const meetsMaxRunners = runnerCount <= maxRunners;
                        const detailsRow = row.nextElementSibling;

                        if (meetsMinStarts && meetsMaxRunners) {
                            visibleRows.push(row);
                            row.style.display = '';
                            if (detailsRow && detailsRow.classList.contains('race-details')) {
                                detailsRow.style.display = '';
                            }
                        } else {
                            row.style.display = 'none';
                            if (detailsRow && detailsRow.classList.contains('race-details')) {
                                detailsRow.style.display = 'none';
                            }
                        }
                    });

                    // Step 2: Recalculate summaries and update table based on visible rows
                    let correctPredictions = 0;
                    let totalStaked = 0;
                    let winCount = 0;
                    let lossCount = 0;
                    let currentBankroll = simulationConfig.startingBankroll;

                    visibleRows.forEach(row => {
                        // First, update the bankroll display for the current row
                        const bankrollCell = row.querySelector('td:nth-child(5)'); // 5th cell is Bankroll
                        if (bankrollCell) {
                            bankrollCell.textContent = currentBankroll.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                        }

                        // Now, calculate the outcome of this race to find the next bankroll value
                        if (row.dataset.isCorrect === 'True') {
                            correctPredictions++;
                        }

                        const stake = parseFloat(row.dataset.stake);
                        if (!isNaN(stake) && stake > 0) {
                            const profit = parseFloat(row.dataset.profit);
                            currentBankroll += profit; // This now correctly carries over from the previous visible row
                            totalStaked += stake;
                            if (profit > 0) {
                                winCount++;
                            } else {
                                lossCount++;
                            }
                        }
                    });

                    // Step 3: Update the summary display with the final calculated values
                    const visibleRaceCount = visibleRows.length;
                    const accuracy = visibleRaceCount > 0 ? (correctPredictions / visibleRaceCount) : 0;
                    const profit = currentBankroll - simulationConfig.startingBankroll;
                    const roi = totalStaked > 0 ? (profit / totalStaked) : 0;
                    const betsPlaced = winCount + lossCount;

                    document.getElementById('summary-validation-races').textContent = visibleRaceCount;
                    document.getElementById('summary-validation-accuracy').textContent = accuracy.toLocaleString('en-US', { style: 'percent', minimumFractionDigits: 2 });
                    document.getElementById('summary-ending-bankroll').textContent = currentBankroll.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                    document.getElementById('summary-profit').textContent = profit.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                    document.getElementById('summary-total-staked').textContent = totalStaked.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                    document.getElementById('summary-roi').textContent = roi.toLocaleString('en-US', { style: 'percent', minimumFractionDigits: 2 });
                    document.getElementById('summary-bets-placed').textContent = `${betsPlaced} (Wins: ${winCount}, Losses: ${lossCount})`;
                });
            }
        });
    </script>
}
}