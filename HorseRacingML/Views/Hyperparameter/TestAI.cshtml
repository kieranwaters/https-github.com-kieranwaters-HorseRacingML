                }
                @if (Model.RequestedEpochs.HasValue)
                {
                    <li>Epochs: @Model.RequestedEpochs</li>
                }
                @if (Model.RequestedBatchSize.HasValue)
                {
                    <li>Batch Size: @Model.RequestedBatchSize</li>
