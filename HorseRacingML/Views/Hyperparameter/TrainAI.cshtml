﻿﻿@using System.Linq
@model HorseRacingML.Models.MLParameterBatch
@{
    ViewData["Title"] = "Train AI";
    var testAiUrl = Url.Action("TestAI");
}

<h1>Train AI</h1>

<form asp-action="TrainAI" method="post">
    <table class="table">
        <thead>
            <tr>
                <th>Units</th>
                <th>Dropout</th>
                <th>Layers</th>
                <th>Learning Rate</th>
                <th>Epochs</th>
                <th>Batch Size</th>
                <th>Folds</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="parameterRows">
            @for (int i = 0; i < Model.Parameters.Count; i++)
            {
                <tr>
                    <td><input asp-for="Parameters[i].Units" class="form-control" /></td>
                    <td><input asp-for="Parameters[i].Dropout" class="form-control" /></td>
                    <td><input asp-for="Parameters[i].Layers" class="form-control" /></td>
                    <td><input asp-for="Parameters[i].LearningRate" class="form-control" /></td>
                    <td><input asp-for="Parameters[i].Epochs" class="form-control" /></td>
                    <td><input asp-for="Parameters[i].BatchSize" class="form-control" /></td>
                    <td><input asp-for="Parameters[i].Folds" class="form-control" /></td>
                    <td>
                        <button type="button" class="btn btn-danger" onclick="removeRow(this)">Delete</button>
                    </td>
                    <input type="hidden" asp-for="Parameters[i].RunDate" />
                </tr>
            }
        </tbody>
    </table>
    <button type="button" class="btn btn-secondary" onclick="addRow()">Add Row</button>
    <button type="submit" class="btn btn-primary">Run</button>
    <a id="testAiLink"
       href="@testAiUrl"
       data-base-url="@testAiUrl"
       class="btn btn-info ms-2">Test AI</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function addRow() {
            const rows = document.querySelectorAll('#parameterRows tr');
            const index = rows.length;
            const template = `
                <tr>
                    <td><input name="Parameters[${index}].Units" class="form-control" /></td>
                    <td><input name="Parameters[${index}].Dropout" class="form-control" /></td>
                    <td><input name="Parameters[${index}].Layers" class="form-control" /></td>
                    <td><input name="Parameters[${index}].LearningRate" class="form-control" /></td>
                    <td><input name="Parameters[${index}].Epochs" class="form-control" /></td>
                    <td><input name="Parameters[${index}].BatchSize" class="form-control" /></td>
                    <td><input name="Parameters[${index}].Folds" class="form-control" /></td>
                    <td><button type="button" class="btn btn-danger" onclick="removeRow(this)">Delete</button></td>
                    <input type="hidden" name="Parameters[${index}].RunDate" value="${new Date().toISOString()}" />
                </tr>`;
            document.getElementById('parameterRows').insertAdjacentHTML('beforeend', template);
        }
        function removeRow(btn) {
            btn.closest('tr').remove();
            updateIndexes();
        }
        function updateIndexes() {
            const rows = document.querySelectorAll('#parameterRows tr');
            rows.forEach((row, idx) => {
                row.querySelectorAll('input').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name) {
                        input.setAttribute('name', name.replace(/Parameters\[\d+\]/, `Parameters[${idx}]`));
                    }
                    const id = input.getAttribute('id');
                    if (id) {
                        input.setAttribute('id', id.replace(/_\d+__/, `_${idx}__`));
                    }
                });
            });
        }
        document.getElementById('testAiLink')?.addEventListener('click', function (event) {
            const link = this;
            const baseUrl = link.getAttribute('data-base-url');
            if (!baseUrl) {
                return;
            }

            const firstRow = document.querySelector('#parameterRows tr');
            if (!firstRow) {
                return;
            }

            event.preventDefault();

            const params = new URLSearchParams();
            const setters = [
                { name: 'units', selector: 'input[name$=".Units"]' },
                { name: 'dropout', selector: 'input[name$=".Dropout"]' },
                { name: 'layers', selector: 'input[name$=".Layers"]' },
                { name: 'learningRate', selector: 'input[name$=".LearningRate"]' },
                { name: 'epochs', selector: 'input[name$=".Epochs"]' },
                { name: 'batchSize', selector: 'input[name$=".BatchSize"]' },
                { name: 'folds', selector: 'input[name$=".Folds"]' }
            ];

            setters.forEach(({ name, selector }) => {
                const input = firstRow.querySelector(selector);
                if (input && input.value.trim() !== '') {
                    params.set(name, input.value.trim());
                }
            });

            const targetUrl = new URL(baseUrl, window.location.origin);
            const query = params.toString();
            if (query) {
                targetUrl.search = query;
            }

            window.location.href = targetUrl.toString();
        });
    </script>
}