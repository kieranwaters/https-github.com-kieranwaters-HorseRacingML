@using System
@using System.Linq
@model HorseRacingML.Models.TrainAIViewModel
@{
    ViewData["Title"] = "Train AI";
    var model = Model.Batch.Parameters.FirstOrDefault() ?? new HorseRacingML.Models.MLParameter();
    // Default Folds to 1 if not set
    if (model.Folds == 0) model.Folds = 1;
}

<h1>Train AI</h1>

<form asp-action="TrainAI" method="post">
    <table class="table">
        <thead>
            <tr>
                <th>Model</th>
                <th>Units / Leaves</th>
                <th>Dropout / Min Data</th>
                <th>Layers / Max Depth</th>
                <th>Learning Rate</th>
                <th>Epochs</th>
                <th>Batch Size</th>
                @* Folds hidden *@
            </tr>
        </thead>
        <tbody>
            <tr id="parameterRow">
                <td>
                    <select asp-for="Batch.Parameters[0].ModelType" class="form-select model-type-select" onchange="toggleInputs()">
                        <option value="0">Neural Network</option>
                        <option value="1">LightGBM</option>
                    </select>
                </td>
                <td>
                    <input asp-for="Batch.Parameters[0].Units" type="number" class="form-control nn-input" placeholder="Units" />
                    <input asp-for="Batch.Parameters[0].LgbmLeaves" type="number" class="form-control lgbm-input" placeholder="Leaves" style="display:none" />
                </td>
                <td>
                    <input asp-for="Batch.Parameters[0].Dropout" type="number" step="any" class="form-control nn-input" placeholder="Dropout" />
                    <input asp-for="Batch.Parameters[0].LgbmMinDataInLeaf" type="number" class="form-control lgbm-input" placeholder="Min Data" style="display:none" />
                </td>
                <td>
                    <input asp-for="Batch.Parameters[0].Layers" type="number" class="form-control nn-input" placeholder="Layers" />
                    <input asp-for="Batch.Parameters[0].LgbmMaxDepth" type="number" class="form-control lgbm-input" placeholder="Max Depth" style="display:none" />
                </td>
                <td><input asp-for="Batch.Parameters[0].LearningRate" type="number" step="any" class="form-control" /></td>
                <td><input asp-for="Batch.Parameters[0].Epochs" type="number" class="form-control" /></td>
                <td>
                    <input asp-for="Batch.Parameters[0].BatchSize" type="number" class="form-control nn-input" />
                    <span class="lgbm-input text-muted small" style="display:none">N/A</span>
                </td>

                @* Hidden inputs for valid model binding *@
                <input type="hidden" asp-for="Batch.Parameters[0].Folds" value="1" />
                <input type="hidden" asp-for="Batch.Parameters[0].RunDate" />
            </tr>
        </tbody>
    </table>

    <div class="d-flex align-items-center gap-3 mt-3">
        <button type="submit" class="btn btn-primary">Run</button>
        <button type="button" class="btn btn-info" onclick="redirectToTestAI()">Test AI</button>

        <div class="input-group ms-auto" style="width: 250px;" title="Number of CPU threads to use for training.">
            <span class="input-group-text">CPU Threads</span>
            <input asp-for="Batch.Parameters[0].Threads" type="number" class="form-control" min="1" max="32" value="@(Model.Batch.Parameters[0].Threads ?? 4)" />
        </div>
    </div>
</form>

@if (Model.Results?.Any() == true)
{
    <h2 class="mt-4">Feature correlations</h2>

    var runNumber = 0;
    foreach (var result in Model.Results)
    {
        runNumber++;
        var sorted = result.FeatureCorrelations
            .OrderByDescending(c => Math.Abs(c.Correlation))
            .ToList();

        <div class="card mb-4">
            <div class="card-header">
                <div class="d-flex flex-column flex-lg-row justify-content-between">
                    <span>Run @runNumber correlations</span>
                    <span class="text-muted small">
                        @if (result.Parameters.ModelType == 1)
                        {
                            <text>Leaves: @result.Parameters.LgbmLeaves · MinData: @result.Parameters.LgbmMinDataInLeaf · MaxDepth: @result.Parameters.LgbmMaxDepth · Learning Rate: @result.Parameters.LearningRate.ToString("0.#####")</text>
                        }
                        else
                        {
                            <text>Units: @result.Parameters.Units · Layers: @result.Parameters.Layers · Dropout: @(result.Parameters.Dropout.HasValue? result.Parameters.Dropout.Value.ToString("0.###") : "N/A") · Learning Rate: @result.Parameters.LearningRate.ToString("0.#####")</text>
                        }
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3 gy-2">
                    <div class="col-6 col-lg-2">
                        <div class="fw-semibold">Train Accuracy</div>
                        <div>@(result.Parameters.TrainAccuracy.HasValue? result.Parameters.TrainAccuracy.Value.ToString("P2") : "n/a")</div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="fw-semibold">Train Loss</div>
                        <div>@(result.Parameters.TrainLoss.HasValue? result.Parameters.TrainLoss.Value.ToString("F4") : "n/a")</div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="fw-semibold">Train Brier</div>
                        <div>@(result.Parameters.TrainBrier.HasValue? result.Parameters.TrainBrier.Value.ToString("F4") : "n/a")</div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="fw-semibold">Validation Accuracy</div>
                        <div>@(result.Parameters.ValidationAccuracy.HasValue? result.Parameters.ValidationAccuracy.Value.ToString("P2") : "n/a")</div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="fw-semibold">Validation Loss</div>
                        <div>@(result.Parameters.ValidationLoss.HasValue? result.Parameters.ValidationLoss.Value.ToString("F4") : "n/a")</div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="fw-semibold">Validation Brier</div>
                        <div>@(result.Parameters.ValidationBrier.HasValue? result.Parameters.ValidationBrier.Value.ToString("F4") : "n/a")</div>
                    </div>
                </div>

                @if (sorted.Count == 0)
                {
                    <p class="text-muted mb-0">No correlations were produced for this run.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Feature</th>
                                    <th scope="col">Dimension</th>
                                    <th scope="col" class="text-end">Correlation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var rank = 0;
                                }
                                @foreach (var item in sorted)
                                {
                                    rank++;
                                    <tr>
                                        <th scope="row">@rank</th>
                                        <td>@item.FeatureKey</td>
                                        <td>@(string.IsNullOrEmpty(item.Dimension) ? "—" : item.Dimension)</td>
                                        <td class="text-end">@item.Correlation.ToString("+0.0000;-0.0000;0.0000")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="text-muted small mb-0">Showing top @sorted.Count feature dimensions by absolute correlation.</p>
                    </div>
                }
            </div>
        </div>
    }
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            toggleInputs();
        });

        function toggleInputs() {
            const selectElement = document.querySelector('.model-type-select');
            const row = document.getElementById('parameterRow');
            const isLgbm = selectElement.value === "1";

            row.querySelectorAll('.nn-input').forEach(el => el.style.display = isLgbm ? 'none' : '');
            row.querySelectorAll('.lgbm-input').forEach(el => el.style.display = isLgbm ? '' : 'none');
        }

        function redirectToTestAI() {
            const row = document.getElementById('parameterRow');
            const testAiUrl = '@Url.Action("TestAI", "Hyperparameter")';
            const params = new URLSearchParams();

            const modelTypeSelect = row.querySelector('.model-type-select');
            const isLgbm = modelTypeSelect.value === "1";

            params.set('modelType', modelTypeSelect.value);

            const addIntParam = (selector, key) => {
                const input = row.querySelector(selector);
                if (!input) return;
                const rawValue = input.value.trim();
                if (!rawValue) return;
                const parsed = Number.parseInt(rawValue, 10);
                if (Number.isNaN(parsed)) return;
                params.set(key, parsed.toString());
            };

            const addFloatParam = (selector, key) => {
                const input = row.querySelector(selector);
                if (!input) return;
                const rawValue = input.value.trim();
                if (!rawValue) return;
                const normalized = rawValue.replace(',', '.');
                const parsed = Number.parseFloat(normalized);
                if (!Number.isFinite(parsed)) return;
                params.set(key, parsed.toString());
            };

            // Common parameters
            addFloatParam('input[name="Batch.Parameters[0].LearningRate"]', 'learningRate');
            addIntParam('input[name="Batch.Parameters[0].Epochs"]', 'epochs');
            addIntParam('input[name="Batch.Parameters[0].Folds"]', 'folds');

            if (isLgbm) {
                // LightGBM specific parameters
                addIntParam('.lgbm-input[placeholder="Leaves"]', 'lgbmLeaves');
                addIntParam('.lgbm-input[placeholder="Min Data"]', 'lgbmMinData');
                addIntParam('.lgbm-input[placeholder="Max Depth"]', 'lgbmMaxDepth');
            } else {
                // Neural Network specific parameters
                addIntParam('.nn-input[placeholder="Units"]', 'units');
                addFloatParam('.nn-input[placeholder="Dropout"]', 'dropout');
                addIntParam('.nn-input[placeholder="Layers"]', 'layers');
                addIntParam('.nn-input[name="Batch.Parameters[0].BatchSize"]', 'batchSize');
            }

            const query = params.toString();
            const target = query ? `${testAiUrl}?${query}` : testAiUrl;
            window.location.href = target;
        }
    </script>
}