                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Sample</th>
                                <th class="text-end">Bets</th>
                                <th class="text-end">Staked</th>
                                <th class="text-end">Profit</th>
                                <th class="text-end">ROI</th>
                                <th class="text-end">ROI 95% CI</th>
                                <th class="text-end">P(profit)</th>
                                <th class="text-end">Max DD</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Tune</td>
                                <td class="text-end">@comparison.Tune.BetCount</td>
                                <td class="text-end">@Money(comparison.Tune.TotalStaked)</td>
                                <td class="text-end @(comparison.Tune.Profit >= 0 ? "text-success" : "text-danger")">@Money(comparison.Tune.Profit)</td>
                                <td class="text-end">@comparison.Tune.Roi.ToString("P2")</td>
                                <td class="text-end">@comparison.Tune.RoiConfidenceLow.ToString("P2") to @comparison.Tune.RoiConfidenceHigh.ToString("P2")</td>
                                <td class="text-end">@comparison.Tune.ProbabilityOfProfit.ToString("P1")</td>
                                <td class="text-end">@comparison.Tune.MaxDrawdownPercent.ToString("P2")</td>
                            </tr>
                            <tr>
                                <td>Confirm</td>
                                <td class="text-end">@comparison.Confirm.BetCount</td>
                                <td class="text-end">@Money(comparison.Confirm.TotalStaked)</td>
                                <td class="text-end @(comparison.Confirm.Profit >= 0 ? "text-success" : "text-danger")">@Money(comparison.Confirm.Profit)</td>
                                <td class="text-end">@comparison.Confirm.Roi.ToString("P2")</td>
                                <td class="text-end">@comparison.Confirm.RoiConfidenceLow.ToString("P2") to @comparison.Confirm.RoiConfidenceHigh.ToString("P2")</td>
                                <td class="text-end">@comparison.Confirm.ProbabilityOfProfit.ToString("P1")</td>
                                <td class="text-end">@comparison.Confirm.MaxDrawdownPercent.ToString("P2")</td>
