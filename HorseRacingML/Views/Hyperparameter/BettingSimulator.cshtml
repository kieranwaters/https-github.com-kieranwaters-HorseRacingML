<a asp-action="TestAI" class="btn btn-link mt-3">Back to Test AI</a>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    @if (Model.Result is not null && Model.Result.EquityCurve.Count > 1)
    {
        var chartData = JsonSerializer.Serialize(new
        {
            values = Model.Result.EquityCurve.Select(point => (double)point.Bankroll).ToArray(),
            labels = Model.Result.EquityCurve
                .Select(point => point.RaceDate?.ToString("yyyy-MM-dd") ?? string.Empty)
                .ToArray(),
            betNumbers = Model.Result.EquityCurve.Select(point => point.BetNumber).ToArray(),
            start = (double)Model.Result.StartingBankroll
        });

        <script>
            (function () {
                const data = @Html.Raw(chartData);
                const canvas = document.getElementById('equityChart');
                if (!canvas || !data || !data.values || data.values.length < 2) {
                    return;
                }

                const values = data.values;
                const step = Math.max(1, Math.floor(values.length / 1500));
                const indices = [];
                for (let i = 0; i < values.length; i += step) {
                    indices.push(i);
                }
                if (indices[indices.length - 1] !== values.length - 1) {
                    indices.push(values.length - 1);
                }

                const sampled = indices.map(i => values[i]);
                const min = Math.min(data.start, ...sampled);
                const max = Math.max(data.start, ...sampled);
                const range = max - min || 1;
                let geometry = null;

                function drawTooltip(ctx, width, height, padding, hoverIndex) {
                    if (!geometry || hoverIndex < 0 || hoverIndex >= sampled.length) {
                        return;
                    }

                    const x = geometry.x(hoverIndex);
                    ctx.strokeStyle = 'rgba(128, 128, 128, 0.55)';
                    ctx.setLineDash([3, 3]);
                    ctx.beginPath();
                    ctx.moveTo(x, padding.top);
                    ctx.lineTo(x, height - padding.bottom);
                    ctx.stroke();
                    ctx.setLineDash([]);

                    const value = sampled[hoverIndex];
                    const y = geometry.y(value);
                    ctx.fillStyle = '#0d6efd';
                    ctx.beginPath();
                    ctx.arc(x, y, 3, 0, Math.PI * 2);
                    ctx.fill();

                    const originalIndex = indices[hoverIndex];
                    const label = data.labels[originalIndex] || '';
                    const betNumber = data.betNumbers[originalIndex] || 0;
                    const lines = [
                        label,
                        'Bet #' + betNumber,
                        'Bankroll ' + value.toFixed(2)
                    ];
                    const boxWidth = 150;
                    const boxHeight = 58;
                    const boxX = Math.min(width - padding.right - boxWidth, Math.max(padding.left, x + 8));
                    const boxY = Math.min(height - padding.bottom - boxHeight, Math.max(padding.top, y - boxHeight - 8));
                    ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
                    ctx.strokeStyle = 'rgba(0, 0, 0, 0.15)';
                    ctx.lineWidth = 1;
                    ctx.fillRect(boxX, boxY, boxWidth, boxHeight);
                    ctx.strokeRect(boxX, boxY, boxWidth, boxHeight);
                    ctx.fillStyle = '#212529';
                    ctx.font = '11px sans-serif';
                    lines.forEach((line, index) => ctx.fillText(line, boxX + 8, boxY + 15 + index * 15));
                }

                function draw(hoverIndex = -1) {
                    const ratio = window.devicePixelRatio || 1;
                    const width = canvas.clientWidth || canvas.parentElement.clientWidth;
                    const height = canvas.clientHeight || 280;
                    canvas.width = width * ratio;
                    canvas.height = height * ratio;

                    const ctx = canvas.getContext('2d');
                    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
                    ctx.clearRect(0, 0, width, height);

                    const padding = { left: 62, right: 14, top: 14, bottom: 22 };
                    const usableWidth = Math.max(1, width - padding.left - padding.right);
                    const usableHeight = Math.max(1, height - padding.top - padding.bottom);
                    const x = index => padding.left + (index / (sampled.length - 1)) * usableWidth;
                    const y = value => padding.top + (max - value) / range * usableHeight;
                    geometry = { x, y };

                    ctx.font = '11px sans-serif';
                    ctx.fillStyle = 'rgba(128, 128, 128, 0.9)';
                    ctx.strokeStyle = 'rgba(128, 128, 128, 0.25)';
                    ctx.lineWidth = 1;

                    for (let line = 0; line <= 4; line++) {
                        const value = min + (range * line) / 4;
                        const yPosition = y(value);
                        ctx.beginPath();
                        ctx.moveTo(padding.left, yPosition);
                        ctx.lineTo(width - padding.right, yPosition);
                        ctx.stroke();
                        ctx.fillText(value.toFixed(0), 6, yPosition + 4);
                    }

                    const startY = y(data.start);
                    ctx.strokeStyle = 'rgba(128, 128, 128, 0.6)';
                    ctx.setLineDash([4, 4]);
                    ctx.beginPath();
                    ctx.moveTo(padding.left, startY);
                    ctx.lineTo(width - padding.right, startY);
                    ctx.stroke();
                    ctx.setLineDash([]);

                    ctx.strokeStyle = values[values.length - 1] >= data.start ? '#198754' : '#dc3545';
                    ctx.lineWidth = 1.75;
                    ctx.beginPath();
                    sampled.forEach((value, index) => {
                        const xPosition = x(index);
                        const yPosition = y(value);
                        if (index === 0) {
                            ctx.moveTo(xPosition, yPosition);
                        } else {
                            ctx.lineTo(xPosition, yPosition);
                        }
                    });
                    ctx.stroke();

                    ctx.fillStyle = 'rgba(128, 128, 128, 0.9)';
                    ctx.fillText(data.labels[0] || '', padding.left, height - 6);
                    const lastLabel = data.labels[data.labels.length - 1] || '';
                    const labelWidth = ctx.measureText(lastLabel).width;
                    ctx.fillText(lastLabel, width - padding.right - labelWidth, height - 6);

                    drawTooltip(ctx, width, height, padding, hoverIndex);
                }

                canvas.addEventListener('mousemove', function (event) {
                    if (!geometry) {
                        return;
                    }

                    const rect = canvas.getBoundingClientRect();
                    const mouseX = event.clientX - rect.left;
                    let nearest = 0;
                    let nearestDistance = Number.MAX_VALUE;
                    for (let i = 0; i < sampled.length; i++) {
                        const distance = Math.abs(geometry.x(i) - mouseX);
                        if (distance < nearestDistance) {
                            nearestDistance = distance;
                            nearest = i;
                        }
                    }

                    draw(nearest);
                });
                canvas.addEventListener('mouseleave', function () { draw(-1); });

                draw();
                window.addEventListener('resize', function () { draw(-1); });
            })();
        </script>
    }

    @if (Model.IsPreparing)
    {
        <script>
            (function () {
                const statusUrl = '@Url.Action("SimulatorJobStatus")';
                let wasActive = true;
                let reloadScheduled = false;

                async function poll() {
                    try {
                        const response = await fetch(statusUrl, { headers: { 'Accept': 'application/json' } });
                        if (!response.ok) {
                            return;
                        }

                        const job = await response.json();
                        const status = document.getElementById('simJobStatus');
                        const message = document.getElementById('simJobMessage');
                        const progress = document.getElementById('simJobProgress');
                        if (status && job.status) {
                            status.textContent = job.status;
                        }
                        if (message && job.message) {
                            message.textContent = job.message;
                        }
                        if (progress && job.progress !== null && job.progress !== undefined) {
                            progress.style.width = job.progress + '%';
                            progress.setAttribute('aria-valuenow', job.progress);
                        }

                        if (!job.isActive && wasActive && !reloadScheduled) {
                            reloadScheduled = true;
                            window.setTimeout(function () { window.location.reload(); }, 800);
                        }
                        wasActive = job.isActive;
                    } catch {
                        // Leave the existing status visible; the next poll retries.
                    }
                }

                window.setInterval(poll, 5000);
                window.setTimeout(poll, 1000);
            })();
        </script>
    }

    <script>
        (function () {
            const courseSelect = document.getElementById('Filter_Courses');
            const clearButton = document.getElementById('clearCourseFilter');
            if (!courseSelect || !clearButton) {
                return;
            }

            clearButton.addEventListener('click', function () {
                for (const option of courseSelect.options) {
                    option.selected = false;
                }
                courseSelect.focus();
            });
        })();
    </script>
}
