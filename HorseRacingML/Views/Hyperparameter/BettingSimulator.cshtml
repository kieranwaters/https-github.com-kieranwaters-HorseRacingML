@model HorseRacingML.Models.BettingSimulatorViewModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Betting Simulator";

    var raceTypeOptions = new List<string> { "Any" };
    var surfaceOptions = new List<string> { "Any" };
    var goingOptions = new List<string> { "Any" };
    var ageOptions = new List<string> { "Any" };
    if (Model.Snapshot is not null)
    {
        raceTypeOptions.AddRange((Model.Snapshot.RaceTypes ?? new List<string>()).Where(value => !string.Equals(value, "Any", StringComparison.OrdinalIgnoreCase)));
        surfaceOptions.AddRange((Model.Snapshot.Surfaces ?? new List<string>()).Where(value => !string.Equals(value, "Any", StringComparison.OrdinalIgnoreCase)));
        goingOptions.AddRange((Model.Snapshot.Goings ?? new List<string>()).Where(value => !string.Equals(value, "Any", StringComparison.OrdinalIgnoreCase)));
        ageOptions.AddRange((Model.Snapshot.AgeRestrictions ?? new List<string>()).Where(value => !string.Equals(value, "Any", StringComparison.OrdinalIgnoreCase)));
    }

    string Money(decimal value) => value.ToString("C", CultureInfo.CurrentCulture);
    string ProfitFactor(decimal? value) => value.HasValue ? value.Value.ToString("0.00") : "∞";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="mb-1">Betting Simulator</h1>
        <p class="text-muted mb-0">
            Re-price cached validation predictions with your own race, value, price and staking rules.
            Preparing the snapshot is the only expensive step; every filter change after that is instant.
            Results are settled at the selected price and net of commission.
        </p>
    </div>
    <a asp-action="TrainAI" class="btn btn-outline-secondary">Train AI</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info" role="alert">@Model.Message</div>
}

@if (!string.IsNullOrWhiteSpace(Model.StaleModelWarning))
{
    <div class="alert alert-warning" role="alert">@Model.StaleModelWarning</div>
}

@if (Model.Snapshots.Count > 1)
{
    <div class="card mt-3">
        <div class="card-body py-3">
            <form method="get" asp-action="BettingSimulator" class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label" for="snapshotKey">Stored snapshot</label>
                    <select id="snapshotKey" name="snapshotKey" class="form-select">
                        @foreach (var item in Model.Snapshots)
                        {
                            <option value="@item.Key" selected="@(string.Equals(item.Key, Model.SelectedSnapshotKey, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                @item.Source · @item.ValidationStart.ToString("yyyy-MM-dd") to @item.ValidationEnd.ToString("yyyy-MM-dd")
                                · @(item.UsedSavedModel ? "saved model" : "retrained")
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">Load snapshot</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">1. Prepare the prediction snapshot</h5>
        <p class="card-text text-muted">
            The saved model is scored over the evaluation window. If the window is after the model's
            held-out period, the active model can be used directly; otherwise a replica is retrained on
            history before the window. The default end date is the latest race in the database, not today.
        </p>
        <form asp-action="SimulatorRun" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-12">
                <div asp-validation-summary="All" class="text-danger"></div>
            </div>
            <div class="col-sm-4 col-md-2">
                <label asp-for="Run.Months" class="form-label">Window length</label>
                <select asp-for="Run.Months" class="form-select">
                    @for (int months = SimulatorRunRequest.MinimumMonths; months <= SimulatorRunRequest.MaximumMonths; months++)
                    {
                        <option value="@months">@months @(months == 1 ? "month" : "months")</option>
                    }
                </select>
            </div>
            <div class="col-sm-4 col-md-2">
                <label asp-for="Run.FromDate" class="form-label">From (optional)</label>
                <input asp-for="Run.FromDate" class="form-control" type="date" />
                <div class="form-text">Overrides the length.</div>
            </div>
            <div class="col-sm-4 col-md-2">
                <label asp-for="Run.ToDate" class="form-label">To (optional)</label>
                <input asp-for="Run.ToDate" class="form-control" type="date" />
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="form-check mt-4">
                    <input asp-for="Run.UseSavedModel" class="form-check-input" />
                    <label asp-for="Run.UseSavedModel" class="form-check-label">Use active model directly when safe</label>
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary" disabled="@(Model.IsPreparing ? "disabled" : null)">
                    @(Model.IsPreparing ? "Preparing…" : "Queue snapshot preparation")
                </button>
            </div>
        </form>

        @if (Model.PrepareJob is not null)
        {
            var job = Model.PrepareJob;
            var jobClass = job.Status switch
            {
                "Succeeded" => "alert-success",
                "Failed" => "alert-danger",
                "Cancelled" => "alert-warning",
                _ => "alert-info"
            };
            <div class="alert @jobClass mt-3 mb-0" role="alert" id="simJobAlert">
                <strong>Snapshot preparation: <span id="simJobStatus">@job.Status</span></strong>
                <span class="ms-2" id="simJobMessage">@job.Message</span>
                @if (job.IsActive)
                {
                    <div class="progress mt-2" style="height: 8px;">
                        <div id="simJobProgress" class="progress-bar progress-bar-striped progress-bar-animated"
                             role="progressbar"
                             style="width: @(job.Progress ?? 0)%;"
                             aria-valuenow="@(job.Progress ?? 0)"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>
                    <div class="small mt-1">
                        Started @(job.StartedUtc?.ToLocalTime().ToString("g") ?? "—").
                        This page updates automatically without discarding filter edits.
                    </div>
                    <form asp-action="SimulatorCancel" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel preparation</button>
                    </form>
                }
                @if (!string.IsNullOrWhiteSpace(job.Error))
                {
                    <div class="mt-2" id="simJobError"><strong>Error:</strong> @job.Error</div>
                }
                @if (job.CompletedUtc.HasValue)
                {
                    <div class="small mt-1">Completed @job.CompletedUtc.Value.ToLocalTime().ToString("g").</div>
                }
            </div>
        }

        @if (Model.Snapshot is not null)
        {
            <hr />
            <dl class="row mb-0 small">
                <dt class="col-sm-3">Snapshot</dt>
                <dd class="col-sm-9">@Model.Snapshot.Source <span class="text-muted">(@Model.Snapshot.Key)</span></dd>
                <dt class="col-sm-3">Validation window</dt>
                <dd class="col-sm-9">
                    @Model.Snapshot.ValidationStart.ToString("yyyy-MM-dd") &ndash;
                    @Model.Snapshot.ValidationEnd.ToString("yyyy-MM-dd")
                    @if (Model.Snapshot.FirstRaceDate.HasValue && Model.Snapshot.LastRaceDate.HasValue)
                    {
                        <span class="text-muted">
                            (actual races @Model.Snapshot.FirstRaceDate.Value.ToString("yyyy-MM-dd") &ndash;
                            @Model.Snapshot.LastRaceDate.Value.ToString("yyyy-MM-dd"))
                        </span>
                    }
                </dd>
                <dt class="col-sm-3">Races / runners</dt>
                <dd class="col-sm-9">
                    @Model.Snapshot.TrainingRaceCount training races,
                    @Model.Snapshot.ValidationRaceCount validation races,
                    @Model.Snapshot.RunnerCount runner rows
                </dd>
                <dt class="col-sm-3">Price coverage</dt>
                <dd class="col-sm-9">
                    @Model.Snapshot.PricedRunnerCount priced, @Model.Snapshot.UnpricedRunnerCount unpriced
                    (@Model.Snapshot.PriceCoverage.ToString("P1"))
                    @if (Model.Snapshot.HasBetfairPrices)
                    {
                        <span class="text-muted">&middot; Betfair prices available</span>
                    }
                </dd>
                <dt class="col-sm-3">Model</dt>
                <dd class="col-sm-9">
                    @(Model.Snapshot.Objective ?? "Unknown objective")
                    @if (!string.IsNullOrWhiteSpace(Model.Snapshot.ModelArtifact))
                    {
                        <span class="text-muted"> &middot; @Model.Snapshot.ModelArtifact</span>
                    }
                    <span class="text-muted"> &middot; blend model @Model.Snapshot.BlendModelWeight.ToString("0.00") / market @Model.Snapshot.BlendMarketWeight.ToString("0.00")</span>
                    @if (Model.Snapshot.UsedSavedModel)
                    {
                        <span class="badge bg-success ms-1">active model</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-1">model run</span>
                    }
                </dd>
                <dt class="col-sm-3">Prepared</dt>
                <dd class="col-sm-9">
                    @Model.Snapshot.CreatedUtc.ToLocalTime().ToString("g")
                    <span class="text-muted">(persisted between app sessions)</span>
                </dd>
            </dl>
        }
    </div>
</div>

@if (Model.Snapshot is not null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">2. Betting filters</h5>
            <form asp-action="SimulatorApply" method="get" id="filterForm">
                <input type="hidden" asp-for="Filter.SnapshotKey" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <h6 class="mt-3">Race conditions</h6>
                <div class="row g-3">
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.RaceType" class="form-label">Race type</label>
                        <select asp-for="Filter.RaceType" class="form-select">
                            @foreach (var option in raceTypeOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.Surface" class="form-label">Surface</label>
                        <select asp-for="Filter.Surface" class="form-select">
                            @foreach (var option in surfaceOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.Going" class="form-label">Going</label>
                        <select asp-for="Filter.Going" class="form-select">
                            @foreach (var option in goingOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.AgeRestriction" class="form-label">Age restriction</label>
                        <select asp-for="Filter.AgeRestriction" class="form-select">
                            @foreach (var option in ageOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MinRunners" class="form-label">Min runners</label>
                        <input asp-for="Filter.MinRunners" class="form-control" type="number" min="0" max="60" step="1" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MaxRunners" class="form-label">Max runners</label>
                        <input asp-for="Filter.MaxRunners" class="form-control" type="number" min="0" max="60" step="1" placeholder="No limit" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label asp-for="Filter.ClassMin" class="form-label">Min class</label>
                        <select asp-for="Filter.ClassMin" class="form-select">
                            <option value="">Any</option>
                            @for (int raceClass = 1; raceClass <= 10; raceClass++)
                            {
                                <option value="@raceClass">Class @raceClass</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label asp-for="Filter.ClassMax" class="form-label">Max class</label>
                        <select asp-for="Filter.ClassMax" class="form-select">
                            <option value="">Any</option>
                            @for (int raceClass = 1; raceClass <= 10; raceClass++)
                            {
                                <option value="@raceClass">Class @raceClass</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label asp-for="Filter.MinDistanceYards" class="form-label">Min distance (y)</label>
                        <input asp-for="Filter.MinDistanceYards" class="form-control" type="number" min="0" max="12000" step="1" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label asp-for="Filter.MaxDistanceYards" class="form-label">Max distance (y)</label>
                        <input asp-for="Filter.MaxDistanceYards" class="form-control" type="number" min="0" max="12000" step="1" placeholder="No limit" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label asp-for="Filter.FromDate" class="form-label">From date</label>
                        <input asp-for="Filter.FromDate" class="form-control" type="date" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label asp-for="Filter.ToDate" class="form-label">To date</label>
                        <input asp-for="Filter.ToDate" class="form-control" type="date" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label asp-for="Filter.Courses" class="form-label">Courses (leave unselected for any)</label>
                        <select asp-for="Filter.Courses" class="form-select" multiple size="5" id="Filter_Courses">
                            @foreach (var course in Model.Snapshot.Courses ?? new List<string>())
                            {
                                <option value="@course">@course</option>
                            }
                        </select>
                        <div class="form-text d-flex justify-content-between align-items-center gap-2">
                            <span>Use Ctrl+click to select more than one. No selection means every course.</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="clearCourseFilter">Clear</button>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label asp-for="Filter.CourseContains" class="form-label">Course contains</label>
                        <input asp-for="Filter.CourseContains" class="form-control" placeholder="e.g. Ascot" />
                    </div>
                </div>

                <h6 class="mt-4">Value and price filters</h6>
                <div class="row g-3">
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MinEdgePercent" class="form-label">Min edge %</label>
                        <input asp-for="Filter.MinEdgePercent" class="form-control" type="number" step="any" />
                        <div class="form-text">AI probability &times; net odds &minus; 1.</div>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MaxEdgePercent" class="form-label">Max edge %</label>
                        <input asp-for="Filter.MaxEdgePercent" class="form-control" type="number" step="any" placeholder="No limit" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MinOdds" class="form-label">Min odds</label>
                        <input asp-for="Filter.MinOdds" class="form-control" type="number" step="any" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MaxOdds" class="form-label">Max odds</label>
                        <input asp-for="Filter.MaxOdds" class="form-control" type="number" step="any" placeholder="No limit" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MinAiProbabilityPercent" class="form-label">Min AI prob %</label>
                        <input asp-for="Filter.MinAiProbabilityPercent" class="form-control" type="number" step="any" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MaxAiProbabilityPercent" class="form-label">Max AI prob %</label>
                        <input asp-for="Filter.MaxAiProbabilityPercent" class="form-control" type="number" step="any" placeholder="No limit" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MinProbabilitySpread" class="form-label">Min prob. spread</label>
                        <input asp-for="Filter.MinProbabilitySpread" class="form-control" type="number" step="any" />
                        <div class="form-text">Skip near-uniform races.</div>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.CommissionPercent" class="form-label">Commission %</label>
                        <input asp-for="Filter.CommissionPercent" class="form-control" type="number" step="any" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.PriceSource" class="form-label">Price source</label>
                        <select asp-for="Filter.PriceSource" asp-items="Html.GetEnumSelectList<SimulatorPriceSource>()" class="form-select"></select>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.PriceSlippagePercent" class="form-label">Price slippage %</label>
                        <input asp-for="Filter.PriceSlippagePercent" class="form-control" type="number" step="any" min="0" max="50" />
                        <div class="form-text">Worse fill than the quoted price.</div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label asp-for="Filter.SelectionStrategy" class="form-label">Selection strategy</label>
                        <select asp-for="Filter.SelectionStrategy" asp-items="Html.GetEnumSelectList<SimulatorSelectionStrategy>()" class="form-select"></select>
                        <div class="form-text">Market favourite / model top pick ignore value filters for baseline comparison.</div>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.BetsPerRace" class="form-label">Bets per race</label>
                        <input asp-for="Filter.BetsPerRace" class="form-control" type="number" min="1" max="10" step="1" />
                    </div>
                </div>

                <h6 class="mt-4">Staking and risk</h6>
                <div class="row g-3">
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.StartingBankroll" class="form-label">Starting bankroll</label>
                        <input asp-for="Filter.StartingBankroll" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label asp-for="Filter.StakeMode" class="form-label">Stake mode</label>
                        <select asp-for="Filter.StakeMode" asp-items="Html.GetEnumSelectList<SimulatorStakeMode>()" class="form-select"></select>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MaxKellyPercent" class="form-label">Max Kelly %</label>
                        <input asp-for="Filter.MaxKellyPercent" class="form-control" type="number" step="any" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.FlatStake" class="form-label">Flat stake</label>
                        <input asp-for="Filter.FlatStake" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.BankrollPercent" class="form-label">Bankroll %</label>
                        <input asp-for="Filter.BankrollPercent" class="form-control" type="number" step="any" min="0" max="100" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MaxStakePercent" class="form-label">Max stake %</label>
                        <input asp-for="Filter.MaxStakePercent" class="form-control" type="number" step="any" min="0" max="100" />
                        <div class="form-text">0 disables the cap.</div>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MaxStakeAmount" class="form-label">Max stake amount</label>
                        <input asp-for="Filter.MaxStakeAmount" class="form-control" type="number" step="0.01" min="0" placeholder="No cap" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MinStake" class="form-label">Min stake</label>
                        <input asp-for="Filter.MinStake" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MaxDailyStakePercent" class="form-label">Max daily stake %</label>
                        <input asp-for="Filter.MaxDailyStakePercent" class="form-control" type="number" step="any" min="0" max="100" />
                        <div class="form-text">0 disables the cap.</div>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.MaxDailyLossPercent" class="form-label">Max daily loss %</label>
                        <input asp-for="Filter.MaxDailyLossPercent" class="form-control" type="number" step="any" min="0" max="100" />
                        <div class="form-text">0 disables the stop.</div>
                    </div>
                </div>

                <h6 class="mt-4">Analysis</h6>
                <div class="row g-3">
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.ConfirmPercent" class="form-label">Confirm %</label>
                        <input asp-for="Filter.ConfirmPercent" class="form-control" type="number" step="any" min="0" max="50" />
                        <div class="form-text">Last N% held back.</div>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.BootstrapSamples" class="form-label">Bootstrap samples</label>
                        <input asp-for="Filter.BootstrapSamples" class="form-control" type="number" min="0" max="10000" step="100" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label asp-for="Filter.PageSize" class="form-label">Rows per page</label>
                        <input asp-for="Filter.PageSize" class="form-control" type="number" min="10" max="1000" step="10" />
                    </div>
                </div>

                <div class="mt-4 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-success">Apply filters</button>
                    <a asp-action="BettingSimulator" asp-route-snapshotKey="@Model.SelectedSnapshotKey" class="btn btn-outline-secondary">Reset filters</a>
                    <button type="submit" formaction="@Url.Action("SimulatorExport")" formmethod="get" class="btn btn-outline-primary">Download CSV</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary mt-3">
        No prediction snapshot is loaded yet. Run <strong>Train AI</strong> or <strong>Test AI</strong>
        (both publish a snapshot automatically), or prepare a window above.
    </div>
}

@if (Model.Result is not null)
{
    var result = Model.Result;
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mt-1">
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">ROI (95% race-bootstrap CI)</div>
                    <div class="fs-3 fw-semibold @(result.Roi >= 0 ? "text-success" : "text-danger")">@result.Roi.ToString("P2")</div>
                    <div class="small">
                        @result.RoiConfidenceLow.ToString("P2") to @result.RoiConfidenceHigh.ToString("P2")
                        &middot; P(profit) @result.ProbabilityOfProfit.ToString("P1")
                    </div>
                    <div class="small">Profit @Money(result.Profit) on @Money(result.TotalStaked) turnover</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Ending bankroll</div>
                    <div class="fs-3 fw-semibold">@Money(result.EndingBankroll)</div>
                    <div class="small">Started at @Money(result.StartingBankroll) &middot; max drawdown @result.MaxDrawdownPercent.ToString("P2")</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Bets / strike rate</div>
                    <div class="fs-3 fw-semibold">@result.BetCount</div>
                    <div class="small">@result.WinCount wins, @result.LossCount losses &middot; @result.StrikeRate.ToString("P1")</div>
                    <div class="small">Break-even @result.BreakEvenStrikeRate.ToString("P1") &middot; selection @result.SelectionRate.ToString("P1")</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Expected vs realised</div>
                    <div class="fs-3 fw-semibold @(result.Profit >= result.ExpectedProfit ? "text-success" : "text-warning")">@Money(result.Profit)</div>
                    <div class="small">Expected @Money(result.ExpectedProfit) &middot; t-stat @result.TStatistic.ToString("0.00")</div>
                    <div class="small">Expected wins @result.ExpectedWins.ToString("0.0") vs actual @result.WinCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Selection funnel</h5>
            <div class="row row-cols-2 row-cols-md-4 row-cols-xl-7 g-2 small">
                <div><span class="text-muted d-block">Races considered</span>@result.RacesConsidered</div>
                <div><span class="text-muted d-block">Passed race filters</span>@result.RacesPassedRaceFilter</div>
                <div><span class="text-muted d-block">Skipped low spread</span>@result.RacesSkippedLowSpread</div>
                <div><span class="text-muted d-block">With candidate</span>@result.RacesWithCandidate</div>
                <div><span class="text-muted d-block">With a bet</span>@result.RacesWithStake</div>
                <div><span class="text-muted d-block">Unpriced rows</span>@result.UnpricedRunnerRows</div>
                <div><span class="text-muted d-block">Stopped for bankroll</span>@(result.StoppedForBankroll ? "Yes" : "No")</div>
            </div>
            @if (result.BetCount == 0)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    No qualifying bets. The funnel shows which stage removed them. Try lowering the minimum
                    edge, widening the odds/runner range, or clearing race filters.
                </div>
            }
        </div>
    </div>

    @if (Model.Comparison is not null)
    {
        var comparison = Model.Comparison;
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Tune / confirm split</h5>
                <p class="text-muted small mb-2">
