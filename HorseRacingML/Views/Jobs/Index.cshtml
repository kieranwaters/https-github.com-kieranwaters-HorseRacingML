@model IReadOnlyList<HorseRacingML.Jobs.BackgroundJobRecord>
@using HorseRacingML.Jobs
@{
    ViewData["Title"] = "Background Jobs";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-info text-center" role="alert">
        @TempData["Message"]
    </div>
}

<h1>Background Jobs</h1>
<p class="text-muted">Long-running work runs outside the HTTP request. Jobs of the same kind cannot run concurrently.</p>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary" role="status">No background jobs have been submitted yet.</div>
}
else
{
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Job</th>
                <th>Kind</th>
                <th>Status</th>
                <th>Progress</th>
                <th>Message</th>
                <th>Created (UTC)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.DisplayName</td>
                <td>@job.Kind</td>
                <td>
                    <span class="badge bg-@(job.Status switch
                    {
                        BackgroundJobStatus.Succeeded => "success",
                        BackgroundJobStatus.Failed => "danger",
                        BackgroundJobStatus.Cancelled => "warning",
                        BackgroundJobStatus.Running => "primary",
                        _ => "secondary"
                    })">@job.Status</span>
                </td>
                <td>@(job.Progress.HasValue ? $"{job.Progress}%" : "-")</td>
                <td>
                    @job.Message
                    @if (!string.IsNullOrWhiteSpace(job.Error))
                    {
                        <div class="text-danger small">@job.Error</div>
                    }
                </td>
                <td>@job.CreatedUtc.ToString("u")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Status" asp-route-id="@job.Id">JSON</a>
                    @if (job.Status == BackgroundJobStatus.Queued || job.Status == BackgroundJobStatus.Running)
                    {
                        <form method="post" asp-action="Cancel" asp-route-id="@job.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
