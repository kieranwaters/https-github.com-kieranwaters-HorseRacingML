{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "Build the whole solution (app + tests)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/HorseRacingML.sln"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-app",
            "detail": "Build only the web application",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/HorseRacingML/HorseRacingML.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-release",
            "detail": "Build the whole solution in Release configuration",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/HorseRacingML.sln",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run",
            "detail": "Run the web app without the debugger",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/HorseRacingML/HorseRacingML.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run-release",
            "detail": "Run the web app in Release without the debugger",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--configuration",
                "Release",
                "--project",
                "${workspaceFolder}/HorseRacingML/HorseRacingML.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "detail": "Run unit tests (integration tests are skipped)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/HorseRacingML/Tests/HorseRacingML.Tests.csproj",
                "--filter",
                "Category!=Integration"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test-all",
            "detail": "Run all tests, including integration tests that need SQL Server",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/HorseRacingML/Tests/HorseRacingML.Tests.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "train-ensemble",
            "detail": "Full chronological TrainAI ensemble (writes MLParameters)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/HorseRacingML/HorseRacingML.csproj",
                "--",
                "--train-ensemble",
                "--minimum-race-date",
                "2017-01-01",
                "--seed-count",
                "3",
                "--ensemble-size",
                "3"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "benchmark-lightgbm",
            "detail": "LightGBM LambdaRank benchmark on the current split",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/HorseRacingML/HorseRacingML.csproj",
                "--",
                "--benchmark-lightgbm",
                "--minimum-race-date",
                "2017-01-01"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "benchmark-pairwise",
            "detail": "Dev-only sweep of Training:PairwiseLossWeight",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/HorseRacingML/HorseRacingML.csproj",
                "--",
                "--benchmark-pairwise",
                "--weights",
                "0,0.02,0.05,0.1",
                "--seeds",
                "42,43"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
